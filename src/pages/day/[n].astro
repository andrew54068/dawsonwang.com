---
import { getCollection } from 'astro:content';
import { renderMarkdown } from '../../lib/render-markdown';
import { readFileSync } from 'node:fs';
import path from 'node:path';
import BaseLayout from '../../layouts/BaseLayout.astro';
import SlideCarousel from '../../components/SlideCarousel.astro';
import MetricsBlock from '../../components/MetricsBlock.astro';
import ExternalLinks from '../../components/ExternalLinks.astro';
import { isTopPerformer } from '../../lib/metrics';
import { topicsForDay, chipVariantFor, topicBySlug } from '../../lib/topics';
import { SITE_URL, cleanDescription, breadcrumbJsonLd, DEFAULT_OG_IMAGE, DEFAULT_OG_IMAGE_WIDTH, DEFAULT_OG_IMAGE_HEIGHT } from '../../lib/seo';

export async function getStaticPaths() {
  const days = await getCollection('days');
  return days.map(day => ({ params: { n: String(day.data.dayNumber) }, props: { day, allDays: days } }));
}

const { day, allDays } = Astro.props;
const slideAltBase = `Day ${day.data.dayNumber} ${day.data.subtitle || ''}`.trim();
const slides = day.data.slideFiles.map((p: string, i: number) => ({
  src: `/content/day${String(day.data.dayNumber).padStart(2, '0')}/slides/${p.split('/').pop()}`,
  alt: `${slideAltBase} — 投影片 ${i + 1}`,
}));

const dayPad = String(day.data.dayNumber).padStart(2, '0');
const shareFiles = (day.data.shareFiles as string[]).map((p: string) => ({
  name: p.split('/').pop()!,
  src: `/content/day${dayPad}/${p.split('/').pop()}`,
  isVideo: /\.mp4$/i.test(p),
}));
const squareVideo = shareFiles.find(f => f.isVideo && f.name.includes('square'));
const shareArtifact = squareVideo ?? shareFiles.find(f => f.isVideo) ?? shareFiles.find(f => !f.isVideo);

const bodyHtml = renderMarkdown(day.data.body, { dayNumber: day.data.dayNumber });
const topicSlugs = topicsForDay(day.data.dayNumber);
const topics = topicSlugs.map(s => ({ slug: s, title: topicBySlug(s)?.title ?? s, variant: chipVariantFor(s) }));

const otherDays = allDays
  .filter((d: any) => d.data.dayNumber !== day.data.dayNumber)
  .sort((a: any, b: any) => b.data.dayNumber - a.data.dayNumber);
const sameTopic = topicSlugs.length > 0
  ? otherDays.filter((d: any) => topicsForDay(d.data.dayNumber).some(s => topicSlugs.includes(s)))
  : [];
const fill = otherDays.filter((d: any) => !sameTopic.includes(d));
const archive = [...sameTopic, ...fill].slice(0, 3);

const publishDate: string | null = day.data.manifest?.threads?.publishedAt
  ?? day.data.manifest?.facebook?.publishedAt
  ?? day.data.manifest?.linkedin?.publishedAt
  ?? null;
const articleDescription = cleanDescription(day.data.body, 155);
// Word count: CJK chars count as 1 each + ASCII whitespace-separated word tokens.
// This gives a reasonable schema.org `wordCount` for mixed zh-Hant / English bodies.
function computeWordCount(body: string): number {
  if (!body) return 0;
  const cjk = body.match(/[\u3400-\u9fff\u3040-\u30ff\uac00-\ud7af]/g)?.length ?? 0;
  const asciiTokens = body
    .replace(/[\u3400-\u9fff\u3040-\u30ff\uac00-\ud7af]/g, ' ')
    .split(/\s+/)
    .filter(t => /[A-Za-z0-9]/.test(t)).length;
  return cjk + asciiTokens;
}
const articleWordCount = computeWordCount(day.data.body);
const primarySection = topics[0]?.title;
const dayUrl = `${SITE_URL}/day/${day.data.dayNumber}`;
const repoRoot = process.cwd();

function pngDimensionsForPublicPath(publicPath: string) {
  const normalizedPath = publicPath.replace(/^\/+/, '');
  if (!normalizedPath.toLowerCase().endsWith('.png')) return undefined;

  try {
    const imageBytes = readFileSync(path.join(repoRoot, 'public', normalizedPath));
    if (imageBytes.length < 24 || imageBytes.toString('ascii', 1, 4) !== 'PNG') return undefined;

    return {
      width: imageBytes.readUInt32BE(16),
      height: imageBytes.readUInt32BE(20),
    };
  } catch {
    return undefined;
  }
}

const primaryOgImage = slides[0]?.src ?? DEFAULT_OG_IMAGE;
const primaryOgImageDimensions = pngDimensionsForPublicPath(primaryOgImage)
  ?? (primaryOgImage === DEFAULT_OG_IMAGE
    ? { width: DEFAULT_OG_IMAGE_WIDTH, height: DEFAULT_OG_IMAGE_HEIGHT }
    : undefined);
// Primary Article image: og-default with known dimensions to qualify for the large-image
// Article rich result (Google guidance: declare width/height, prefer ≥1200px). Slide images
// from content/dayNN are added as secondary string entries when present — we don't have
// reliable dimensions for them at build time, so the typed primary is the dimension anchor.
const fallbackImage = {
  '@type': 'ImageObject',
  url: `${SITE_URL}${DEFAULT_OG_IMAGE}`,
  width: DEFAULT_OG_IMAGE_WIDTH,
  height: DEFAULT_OG_IMAGE_HEIGHT,
};
const slideImageUrls = slides.map(s => `${SITE_URL}${s.src}`);
const articleImage: unknown = slideImageUrls.length > 0
  ? [fallbackImage, ...slideImageUrls]
  : fallbackImage;
const articleJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: `Day ${day.data.dayNumber} ${day.data.subtitle}`,
  description: articleDescription,
  url: dayUrl,
  mainEntityOfPage: { '@type': 'WebPage', '@id': dayUrl },
  inLanguage: 'zh-Hant-TW',
  isPartOf: { '@id': `${SITE_URL}/#website` },
  author: { '@id': `${SITE_URL}/#person` },
  publisher: { '@id': `${SITE_URL}/#person` },
  copyrightHolder: { '@id': `${SITE_URL}/#person` },
  creator: { '@id': `${SITE_URL}/#person` },
  accountablePerson: { '@id': `${SITE_URL}/#person` },
  editor: { '@id': `${SITE_URL}/#person` },
  isAccessibleForFree: true,
  datePublished: publishDate ?? undefined,
  dateModified: publishDate ?? undefined,
  image: articleImage,
  keywords: topics.map(t => t.title),
  ...(topics.length > 0 ? { about: topics.map(t => ({ '@id': `${SITE_URL}/topics/${t.slug}#term` })) } : {}),
  wordCount: articleWordCount,
  ...(primarySection ? { articleSection: primarySection } : {}),
  breadcrumb: { '@id': `${dayUrl}#breadcrumb` },
};
const dayBreadcrumbJsonLd = breadcrumbJsonLd([
  { name: 'Home', url: '/' },
  { name: 'Days', url: '/days' },
  { name: `Day ${day.data.dayNumber} ${day.data.subtitle ?? ''}`.trim(), url: `/day/${day.data.dayNumber}` },
], dayUrl);
---
<BaseLayout title={`Day ${day.data.dayNumber} ${day.data.subtitle}`} description={articleDescription} type="article" ogImage={primaryOgImage} ogImageWidth={primaryOgImageDimensions?.width} ogImageHeight={primaryOgImageDimensions?.height} structuredData={[articleJsonLd, dayBreadcrumbJsonLd]} publishedTime={publishDate ?? undefined} modifiedTime={publishDate ?? undefined} articleAuthorUrl={`${SITE_URL}/#person`} articleTags={topics.map(t => t.title)}>
  <article class="day-article" data-pagefind-body data-pagefind-meta={`day:${day.data.dayNumber}`}>
    <div class="wrap day-grid">

      <div class="day-main">
        <header class="day-head">
          <p class="kicker" data-pagefind-ignore><svg class="icon" aria-hidden="true"><use href="#i-book"/></svg>Day {String(day.data.dayNumber).padStart(3, '0')}{publishDate ? ` · ${publishDate.slice(0, 10)}` : ''}</p>
          <h1>{day.data.subtitle || `Day ${day.data.dayNumber}`}</h1>
          {topics.length > 0 && (
            <div class="tags day-tags" data-pagefind-ignore>
              {topics.map(t => (
                <a href={`/topics/${t.slug}`} class={`tag tag-${t.variant}`}>{t.title}</a>
              ))}
            </div>
          )}
        </header>

        {slides.length > 0 && <SlideCarousel slides={slides} />}

        {shareArtifact && slides.length === 0 && (
          <figure class="media-frame">
            <div class="media-inner">
              {shareArtifact.isVideo
                ? <video src={shareArtifact.src} autoplay loop muted playsinline />
                : <img src={shareArtifact.src} alt={slideAltBase} />
              }
            </div>
          </figure>
        )}

        <div class="w-prose" set:html={bodyHtml} />

        {day.data.manifest && isTopPerformer(day.data.dayNumber) && (
          <MetricsBlock manifest={day.data.manifest} />
        )}

        <aside class="card author-card" data-pagefind-ignore>
          <div class="me-card">
            <img src="/dawson.webp" alt="" width="80" height="80" loading="lazy" decoding="async" />
            <div><strong>Dawson Wang</strong><span>AI 導入顧問 · 這篇的作者</span></div>
          </div>
          <p class="author-text">我幫台灣團隊把 AI 工具落地到日常工作流。從 PoC 到上線、再到團隊接手。9 年新創軟體開發經驗、前 iOS@Taipei 社群主持人。</p>
          <a href="/#inquire" class="btn btn-primary">預約諮詢 <span class="arr" aria-hidden="true">→</span></a>
        </aside>

        {archive.length > 0 && (
          <section class="day-related" aria-labelledby="related-title" data-pagefind-ignore>
            <div class="related-head">
              <h2 id="related-title" class="eyebrow">延伸閱讀</h2>
              <a href="/days" class="text-link">看完整 {allDays.length} 篇 <span aria-hidden="true">→</span></a>
            </div>
            <div class="card-grid three">
              {archive.map((d: any) => (
                <a href={`/day/${d.data.dayNumber}`} class="card related-card">
                  <span class="card-label">Day {String(d.data.dayNumber).padStart(3, '0')}</span>
                  <h3>{d.data.subtitle}</h3>
                </a>
              ))}
            </div>
          </section>
        )}
      </div>

      <aside class="day-side" data-pagefind-ignore>
        <div class="day-sticker" aria-hidden="true">
          <span class="day-sticker-lbl">Day</span>
          <span class="big-num">{String(day.data.dayNumber).padStart(3, '0')}</span>
          {isTopPerformer(day.data.dayNumber) && <span class="tag tag-brick">熱門</span>}
        </div>
        {day.data.manifest && <ExternalLinks manifest={day.data.manifest} />}
      </aside>

    </div>
  </article>
</BaseLayout>

<style>
  .day-article { padding: clamp(36px, 5vw, 64px) 0 clamp(72px, 8vw, 112px); }
  .day-grid { display: grid; grid-template-columns: minmax(0, 1fr) 220px; gap: 24px clamp(40px, 6vw, 88px); align-items: start; }
  .day-main { min-width: 0; max-width: 46rem; }
  .day-head { padding-bottom: 28px; margin-bottom: 32px; border-bottom: 1.5px dashed var(--rule); }
  .day-head h1 { margin-top: 18px; font-size: clamp(2rem, 1.2rem + 2.6vw, 3.1rem); line-height: 1.3; }
  .day-tags { margin-top: 18px; }

  .media-frame { margin: 0 0 36px; padding: 12px; border-radius: 30px; background: var(--white); box-shadow: var(--shadow); }
  .media-inner { aspect-ratio: 1 / 1; overflow: hidden; border-radius: 20px; background: var(--cream); }
  .media-inner img, .media-inner video { width: 100%; height: 100%; object-fit: contain; }

  .author-card { margin-top: 48px; }
  .author-text { margin: 16px 0 20px; color: var(--muted); font-size: 1.04rem; line-height: 1.8; }
  .author-card .me-card { margin-top: 0; }

  .day-related { margin-top: 48px; }
  .related-head { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 8px 20px; margin-bottom: 18px; }
  .related-head .eyebrow { margin: 0; font-family: var(--f-body); }
  .related-card h3 { margin-top: 8px; font-size: 1.15rem; line-height: 1.5; transition: color .2s; }
  .related-card:hover h3 { color: var(--persimmon-ink); }

  .day-side { position: sticky; top: 100px; display: grid; gap: 22px; }
  .day-sticker { display: grid; justify-items: start; gap: 6px; padding: 20px 22px 22px; border-radius: 26px; background: var(--peach); box-shadow: 0 0 0 6px var(--peach), 0 16px 30px -16px rgba(46, 35, 28, .42); rotate: -2deg; }
  .day-sticker-lbl { font-weight: 700; color: var(--ink); }

  @media (max-width: 900px) {
    .day-grid { grid-template-columns: 1fr; }
    .day-main { max-width: none; }
    .day-side { position: static; }
    .day-sticker { display: none; }
  }
</style>
