---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Hl from '../components/home/Hl.astro';
import StatsCharts from '../components/StatsCharts.astro';
import { computeStatsSummary } from '../lib/metrics';
import { PROJECTS, STATUS_LABELS, STATUS_CLASSES, type Project } from '../data/projects';
import { SITE_URL, absoluteUrl, breadcrumbJsonLd } from '../lib/seo';

const days = await getCollection('days');
const availableDays = new Set<number>(days.map(d => d.data.dayNumber));
// The 100days submodule can legitimately lag behind the canonical content dir
// (`yarn deploy` rsyncs the fresh tree; a bare `yarn dev` uses whatever the
// submodule pins). So: a referenced day at or below the newest loaded day but
// missing is a real typo → fail the build. A day beyond it is just content this
// checkout hasn't got yet → render the ref without a link instead of 404-ing.
const newestLoadedDay = days.reduce((max, d) => Math.max(max, d.data.dayNumber), 0);

interface DayRef {
  dayNumber: number;
  href: string | null;
}

function resolveDays(project: Project): DayRef[] {
  return project.days.map(dayNumber => {
    if (availableDays.has(dayNumber)) {
      return { dayNumber, href: `/day/${dayNumber}` };
    }
    if (dayNumber <= newestLoadedDay) {
      throw new Error(
        `projects.ts: "${project.slug}" references day ${dayNumber}, but no such ` +
        `entry exists in the days collection (newest loaded day is ${newestLoadedDay}). ` +
        `Fix the day number in src/data/projects.ts.`
      );
    }
    return { dayNumber, href: null };
  });
}

const resolved = PROJECTS.map(project => ({ project, dayRefs: resolveDays(project) }));
const featured = resolved.filter(r => r.project.featured);
const rest = resolved.filter(r => !r.project.featured);

const openSourceCount = PROJECTS.filter(p => p.repo).length;
const writeupCount = new Set(PROJECTS.flatMap(p => p.days)).size;
// Span the whole build log, not just the newest day that happens to have a
// project attached — so the header keeps counting up as new days land.
const spanEnd = newestLoadedDay;
// The public-record charts that used to live on /proof (now redirected here).
const stats = computeStatsSummary(days);

const projectsTitle = '側專案作品｜Dawson Wang 做過的工具';
const projectsDescription = `Day 1–${spanEnd} 公開建造記錄裡真正做出來的 ${PROJECTS.length} 個側專案：MCP server、Claude Code plugin、macOS 驅動、自動化 bot 與網站，${openSourceCount} 個附開源碼，每個都連得到當天的完整寫法。`;
const projectsUrl = absoluteUrl('/projects');

const projectsCollectionJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  '@id': `${projectsUrl}#collectionpage`,
  name: projectsTitle,
  description: projectsDescription,
  url: projectsUrl,
  inLanguage: 'zh-Hant-TW',
  isPartOf: { '@id': `${SITE_URL}/#website` },
  about: { '@id': `${SITE_URL}/#person` },
  breadcrumb: { '@id': `${projectsUrl}#breadcrumb` },
  mainEntity: {
    '@type': 'ItemList',
    name: '側專案作品',
    numberOfItems: PROJECTS.length,
    itemListElement: PROJECTS.map((project, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      item: {
        '@type': project.repo ? 'SoftwareSourceCode' : 'CreativeWork',
        '@id': `${projectsUrl}#${project.slug}`,
        name: project.name,
        description: `${project.tagline}——${project.outcome}`,
        url: `${projectsUrl}#${project.slug}`,
        keywords: project.stack.join(', '),
        creator: { '@id': `${SITE_URL}/#person` },
        isPartOf: { '@id': `${SITE_URL}/#website` },
        ...(project.repo ? { codeRepository: project.repo } : {}),
        ...(project.demo ? { sameAs: absoluteUrl(project.demo) } : {}),
      },
    })),
  },
};

const projectsBreadcrumbJsonLd = breadcrumbJsonLd([
  { name: 'Home', url: '/' },
  { name: 'Projects', url: '/projects' },
], projectsUrl);
---
<BaseLayout
  title={projectsTitle}
  description={projectsDescription}
  structuredData={[projectsCollectionJsonLd, projectsBreadcrumbJsonLd]}
>
  <section class="page-hero" aria-labelledby="projects-title">
    <div class="wrap">
      <p class="kicker"><svg class="icon" aria-hidden="true"><use href="#i-spark"/></svg>作品集 · Day 1–{spanEnd} 公開建造記錄</p>
      <h1 id="projects-title">每個工具，<br>都是先<Hl>痛過</Hl>才做的。</h1>
      <p class="hero-sub">
        這 {spanEnd} 天裡我沒有為了做作品集而做東西——每一個都是自己卡住了、受不了了，才動手。
        下面 {PROJECTS.length} 個是真的做出來、而且到現在還在用的，其中 {openSourceCount} 個附源碼。
        每張卡片都連得回當天那篇，裡面有完整的做法跟踩到的雷。
      </p>
      <ul class="stickers" aria-label="作品集數字">
        <li class="sticker"><p class="num">{PROJECTS.length}<small>個</small></p><p class="lbl">做出來、還在用的工具</p></li>
        <li class="sticker"><p class="num">{openSourceCount}<small>個</small></p><p class="lbl">附開源碼</p></li>
        <li class="sticker"><p class="num">{writeupCount}<small>篇</small></p><p class="lbl">寫得到做法的文章</p></li>
        <li class="sticker"><p class="num">{spanEnd}<small>天</small></p><p class="lbl">每天公開一篇 AI 實作</p></li>
      </ul>
    </div>
  </section>

  <section class="sec" aria-labelledby="featured-title">
    <div class="wrap">
      <div class="sec-head">
        <p class="eyebrow">代表作 · {featured.length}</p>
        <h2 id="featured-title">最有代表性的四個</h2>
      </div>
      <div class="card-grid">
        {featured.map(({ project, dayRefs }, index) => (
          <article id={project.slug} class="card pj-card reveal scroll-mt-20" data-reveal style={`--i:${index % 2}`}>
            <div class="pj-top">
              <span class="card-label">{project.kind}</span>
              <span class={STATUS_CLASSES[project.status]}>{STATUS_LABELS[project.status]}</span>
            </div>
            <h3>{project.name}</h3>
            <p class="card-sub">{project.tagline}</p>
            <dl class="dl-stack">
              <div><dt>起點</dt><dd>{project.problem}</dd></div>
              <div><dt>產出</dt><dd>{project.outcome}</dd></div>
            </dl>
            <div class="tags pj-stack">
              {project.stack.map(tag => <span class="tag">{tag}</span>)}
            </div>
            {(project.repo || project.demo) && (
              <div class="pj-actions">
                {project.demo && <a href={project.demo} class="btn btn-primary btn-sm">{project.demoLabel ?? '試用 →'}</a>}
                {project.repo && <a href={project.repo} rel="noopener" class="btn btn-soft btn-sm">原始碼 <span class="arr" aria-hidden="true">→</span></a>}
              </div>
            )}
            <div class="card-foot">
              <span>寫法在</span>
              {dayRefs.map(ref => ref.href
                ? <a href={ref.href} class="text-link">Day {String(ref.dayNumber).padStart(3, '0')}</a>
                : <span>Day {String(ref.dayNumber).padStart(3, '0')}</span>
              )}
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="band" aria-labelledby="record-title">
    <div class="wrap">
      <div class="sec-head">
        <p class="eyebrow">公開記錄</p>
        <h2 id="record-title">連續 {stats.totalDays} 天，<br>每天一篇，全部公開。</h2>
        <p class="sec-sub">這些工具的做法、踩到的雷和結果都寫成文章發在社群上。下面是每一篇發出去之後，真的有人在看的紀錄。</p>
      </div>
      <div class="card pj-record">
        <StatsCharts stats={stats} variant="expanded" />
      </div>
    </div>
  </section>

  <section class="sec" aria-labelledby="rest-title">
    <div class="wrap">
      <div class="sec-head">
        <p class="eyebrow">其他作品 · {rest.length}</p>
        <h2 id="rest-title">其他做出來的東西</h2>
      </div>
      <div class="card-grid three">
        {rest.map(({ project, dayRefs }, index) => (
          <article id={project.slug} class="card pj-card pj-small reveal scroll-mt-20" data-reveal style={`--i:${index % 3}`}>
            <div class="pj-top">
              <span class="card-label">{project.kind}</span>
              <span class={STATUS_CLASSES[project.status]}>{STATUS_LABELS[project.status]}</span>
            </div>
            <h3>{project.name}</h3>
            <p class="card-sub">{project.tagline}</p>
            <p class="card-text">{project.outcome}</p>
            <div class="tags pj-stack">
              {project.stack.map(tag => <span class="tag">{tag}</span>)}
            </div>
            <div class="card-foot">
              {project.repo && <a href={project.repo} rel="noopener" class="text-link">原始碼 <span aria-hidden="true">↗</span></a>}
              {project.demo && <a href={project.demo} class="text-link">{project.demoLabel ?? '試用 →'}</a>}
              {dayRefs.map(ref => ref.href
                ? <a href={ref.href} class="text-link">Day {String(ref.dayNumber).padStart(3, '0')}</a>
                : <span>Day {String(ref.dayNumber).padStart(3, '0')}</span>
              )}
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="band" aria-labelledby="projects-cta-title">
    <div class="wrap">
      <div class="sec-head center">
        <p class="eyebrow">想要一個這樣的東西？</p>
        <h2 id="projects-cta-title">你的團隊，<br>也卡在某個流程上嗎？</h2>
        <p class="sec-sub">上面每一個都是從一個具體的痛點開始的。跟我說說你的情境，1–2 個工作日內回信。</p>
      </div>
      <div class="cta-actions">
        <a class="btn btn-primary btn-lg" href="/#inquire">預約諮詢 <span class="arr" aria-hidden="true">→</span></a>
        <a class="text-link" href="/#cases">看客戶案例 <span aria-hidden="true">→</span></a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* Cards in a row line up: stack tags, then actions + day links pinned to the bottom. */
  .pj-card { display: flex; flex-direction: column; }
  .pj-top { display: flex; align-items: center; justify-content: space-between; gap: 12px; margin-bottom: 10px; }
  .pj-stack { margin: 18px 0 20px; }
  .pj-actions { display: flex; flex-wrap: wrap; gap: 10px; margin-top: auto; }
  .pj-card .card-foot { margin-top: auto; }
  .pj-card .pj-actions + .card-foot { margin-top: 18px; }
  .pj-record { padding: clamp(22px, 3vw, 36px); }
</style>
