---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import CaseStudyCard from '../components/CaseStudyCard.astro';
import { CASE_STUDIES } from '../data/homepage-cases';
import { SITE_URL, absoluteUrl, breadcrumbJsonLd } from '../lib/seo';

const days = await getCollection('days');
const availableDays = new Set(days.map(day => day.data.dayNumber));
for (const entry of CASE_STUDIES) {
  for (const day of [entry.dayNumber, ...(entry.relatedDays ?? [])]) {
    if (!availableDays.has(day)) throw new Error(`CaseStudies: ${entry.slug} references missing Day ${day}.`);
  }
}
const title = '案例錦集｜Dawson Wang 的 AI 實作分享';
const description = '從讀卡機修復、照片票選，到發票、LINE 整理與錄音知識庫：看看 AI 實際怎麼接進生活與工作，每個案例都附完整做法與使用限制。';
const pageUrl = absoluteUrl('/cases');
const breadcrumb = breadcrumbJsonLd([
  { name: '首頁', url: SITE_URL },
  { name: '案例錦集', url: pageUrl },
], pageUrl);
const collection = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  '@id': `${pageUrl}#collectionpage`,
  name: title,
  description,
  url: pageUrl,
  inLanguage: 'zh-Hant-TW',
  isPartOf: { '@id': `${SITE_URL}/#website` },
  breadcrumb: { '@id': `${pageUrl}#breadcrumb` },
  mainEntity: {
    '@type': 'ItemList',
    name: 'AI 實作案例',
    numberOfItems: CASE_STUDIES.length,
    itemListElement: CASE_STUDIES.map((entry, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      item: {
        '@type': 'CreativeWork',
        name: entry.headline,
        description: entry.outcome,
        url: absoluteUrl(`/day/${entry.dayNumber}`),
        creator: { '@id': `${SITE_URL}/#person` },
      },
    })),
  },
};
---
<BaseLayout title={title} description={description} structuredData={[breadcrumb, collection]}>
  <section class="sec case-collection" aria-labelledby="collection-title">
    <div class="wrap">
      <div class="sec-head">
        <p class="eyebrow">案例錦集</p>
        <h1 id="collection-title">從生活小事到工作流程，<br>把想法做成真的能用的東西。</h1>
        <p class="sec-sub">{CASE_STUDIES.length} 個實際做過的例子。每個案例都寫清楚原本的麻煩、做法、成果與限制，想試試看的也有工具連結。</p>
      </div>
      <div class="case-grid">
        {CASE_STUDIES.map((entry, index) => <CaseStudyCard entry={entry} index={index} />)}
      </div>
      <div class="collection-footer">
        <a class="text-link" href="/days">看全部 {days.length} 篇實作 <span aria-hidden="true">→</span></a>
        <a class="text-link" href="/#inquire">聊聊你的工作裡有哪些麻煩 <span aria-hidden="true">→</span></a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .case-collection { padding-top: 54px; }
  .case-collection h1 { font-size: clamp(2rem, 1.35rem + 2.5vw, 3.5rem); }
  .collection-footer { display: flex; justify-content: center; flex-wrap: wrap; gap: 12px 28px; margin-top: 42px; }
</style>
