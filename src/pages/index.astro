---
import BaseLayout from '../layouts/BaseLayout.astro';
import HomeIcons from '../components/home/HomeIcons.astro';
import HomeNav from '../components/home/HomeNav.astro';
import Hero from '../components/Hero.astro';
import Venues from '../components/home/Venues.astro';
import PainPoints from '../components/home/PainPoints.astro';
import RecentConsultations from '../components/RecentConsultations.astro';
import ToolsIBuilt from '../components/ToolsIBuilt.astro';
import ServiceExplainer from '../components/ServiceExplainer.astro';
import TrainingProof from '../components/home/TrainingProof.astro';
import ProofExcerpt from '../components/ProofExcerpt.astro';
import Process from '../components/home/Process.astro';
import Faq from '../components/home/Faq.astro';
import InquiryForm from '../components/InquiryForm.astro';
import HomeFooter from '../components/home/HomeFooter.astro';
import { SITE_URL } from '../lib/seo';
import { SERVICES } from '../data/services';
import '../styles/home-warm.css';

const homeDescription = 'Dawson Wang 幫台灣團隊把 AI 工具落地到實際工作流：Claude Code、客製 skills、MCP server、agent 工作流、團隊培訓與顧問陪跑。';
const inquireUrl = `${SITE_URL}/#inquire`;
const serviceJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  '@id': `${SITE_URL}/#ai-workflow-service`,
  name: 'Dawson Wang AI 工具落地服務',
  url: SITE_URL,
  image: `${SITE_URL}/dawson.webp`,
  areaServed: 'Taiwan',
  inLanguage: 'zh-Hant-TW',
  founder: { '@id': `${SITE_URL}/#person` },
  isPartOf: { '@id': `${SITE_URL}/#website` },
  contactPoint: {
    '@type': 'ContactPoint',
    url: inquireUrl,
    contactType: 'consulting inquiries',
    areaServed: 'Taiwan',
    availableLanguage: ['zh-Hant-TW', 'en'],
  },
  serviceType: ['AI 工具落地', 'AI workflow implementation', 'Claude Code training', 'MCP server implementation', 'Agent workflow consulting'],
  description: homeDescription,
  hasOfferCatalog: {
    '@type': 'OfferCatalog',
    '@id': `${SITE_URL}/#ai-workflow-service-catalog`,
    name: 'Dawson Wang AI 工具落地服務方案',
    inLanguage: 'zh-Hant-TW',
    isPartOf: { '@id': `${SITE_URL}/#website` },
    itemListElement: SERVICES.map((service, index) => ({
      '@type': 'Offer',
      position: index + 1,
      url: inquireUrl,
      availability: 'https://schema.org/InStock',
      itemOffered: {
        '@type': 'Service',
        name: service.title,
        description: service.blurb,
        serviceType: service.examples,
        provider: { '@id': `${SITE_URL}/#person` },
        areaServed: 'Taiwan',
      },
    })),
  },
};
const homePersonServiceGraphLinkJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  '@id': `${SITE_URL}/#person`,
  worksFor: { '@id': `${SITE_URL}/#ai-workflow-service` },
};
---
<BaseLayout
  title="Dawson Wang"
  description={homeDescription}
  structuredData={[serviceJsonLd, homePersonServiceGraphLinkJsonLd]}
  showNav={false}
  showFooter={false}
  wrapMain={false}
>
  <script is:inline>document.documentElement.classList.add('js');</script>
  <div class="home-warm">
    <HomeIcons />
    <a class="skip" href="#main">跳到主要內容</a>
    <HomeNav />
    <main id="main" data-pagefind-body>
      <Hero />
      <Venues />
      <PainPoints />
      <RecentConsultations />
      <ToolsIBuilt />
      <ServiceExplainer />
      <TrainingProof />
      <ProofExcerpt />
      <Process />
      <Faq />
      <InquiryForm />
    </main>
    <HomeFooter />
  </div>
</BaseLayout>

<script>
  // Scroll reveals: cards fade up, the collage drops in, chat bubbles pop one by
  // one. Content is visible without JS; this only drives the entrance motion.
  (() => {
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const targets = document.querySelectorAll('[data-reveal]');
    if (reduce || !('IntersectionObserver' in window)) {
      targets.forEach((el) => el.classList.add('is-in'));
      return;
    }
    const io = new IntersectionObserver((entries) => {
      for (const entry of entries) {
        if (!entry.isIntersecting) continue;
        entry.target.classList.add('is-in');
        io.unobserve(entry.target);
      }
    }, { rootMargin: '0px 0px -60px 0px', threshold: 0.12 });
    targets.forEach((el) => io.observe(el));
  })();
</script>
