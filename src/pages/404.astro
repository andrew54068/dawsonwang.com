---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hl from '../components/home/Hl.astro';
---
<BaseLayout
  title="找不到頁面"
  description="這個頁面不存在或已經搬走了。回首頁、看 100 天系列、或從主題索引重新出發。"
  noindex={true}
>
  <section class="page-hero center" aria-labelledby="nf-title">
    <div class="wrap">
      <p class="kicker"><svg class="icon" aria-hidden="true"><use href="#i-chat-q"/></svg>404 · 找不到頁面</p>
      <h1 id="nf-title">這頁<Hl>不見了</Hl>。</h1>
      <p class="hero-sub">網址打錯、或這個頁面已經搬走。從下面幾個入口重新開始：</p>
      <nav class="hero-ctas center" aria-label="找不到頁面導覽">
        <a href="/" class="btn btn-primary"><span aria-hidden="true">←</span> 回首頁</a>
        <a href="/days" class="btn btn-soft">所有文章</a>
        <a href="/topics" class="btn btn-soft">主題索引</a>
        <a href="/search" class="btn btn-soft">搜尋</a>
      </nav>
    </div>
  </section>
</BaseLayout>

<style>
  .page-hero { padding-block: clamp(64px, 9vw, 128px); }
</style>
