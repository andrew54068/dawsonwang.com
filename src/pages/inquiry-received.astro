---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hl from '../components/home/Hl.astro';
---
<BaseLayout title="收到了" description="諮詢表單送出成功" noindex={true}>
  <section class="page-hero center" aria-labelledby="ok-title">
    <div class="wrap">
      <p class="kicker"><svg class="icon" aria-hidden="true"><use href="#i-check"/></svg>表單已送出</p>
      <h1 id="ok-title"><Hl>謝謝</Hl>，收到了。</h1>
      <p class="hero-sub">我會在 1–2 個工作日內回信。如果適合進一步聊，會附上 Google Calendar 預約連結。</p>
      <div class="hero-ctas center">
        <a href="/" class="btn btn-soft"><span aria-hidden="true">←</span> 回首頁</a>
        <a href="/#cases" class="btn btn-soft">先看客戶案例</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .page-hero { padding-block: clamp(64px, 9vw, 128px); }
</style>
