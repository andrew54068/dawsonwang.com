---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import TopicCard from '../../components/TopicCard.astro';
import Hl from '../../components/home/Hl.astro';
import { topicsWithPosts, daysForTopic } from '../../lib/topics';
import { SITE_URL, breadcrumbJsonLd } from '../../lib/seo';
import { ARTICLE_TYPES, FRESHNESS, classificationForDay } from '../../lib/article-taxonomy';

const days = await getCollection('days');
const validDayNumbers = days.map(day => day.data.dayNumber);
const topics = topicsWithPosts(validDayNumbers).map(t => ({
  ...t,
  count: daysForTopic(t.slug, validDayNumbers).length,
}));
const topicTitleList = topics.map(topic => topic.title).join('、');
const countFor = (axis: 'types' | 'freshness', slug: string) => days.filter(day => classificationForDay(day.data.dayNumber)?.[axis].includes(slug)).length;
const subjectTopics = topics.filter(t => !['beginner', 'cases'].includes(t.slug));
const otherTopics = topics.filter(t => ['beginner', 'cases'].includes(t.slug));

// DefinedTermSet hub: models the topic list as a controlled vocabulary / taxonomy.
// Single source of truth — references only topics backed by at least one tagged day,
// so placeholder / zero-post topics do not leak into crawlable taxonomy surfaces.
const topicTaxonomyJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'DefinedTermSet',
  '@id': `${SITE_URL}/topics#topic-taxonomy`,
  name: 'AI 實作主題分類',
  description: `Dawson Wang 的 ${topics.length} 個 AI 工具落地主題分類：${topicTitleList}。`,
  inLanguage: 'zh-Hant-TW',
  isPartOf: { '@id': `${SITE_URL}/#website` },
  hasDefinedTerm: topics.map(t => ({ '@id': `${SITE_URL}/topics/${t.slug}#term` })),
};
const topicsIndexUrl = `${SITE_URL}/topics`;
const topicsIndexTitle = 'AI 工具落地主題索引';
const topicsIndexDescription = `依文章類型、主題與時效性瀏覽 Dawson Wang 的 ${days.length} 篇文章，涵蓋 ${topics.length} 個主題。從基本觀念、方法流程到工具評測，組合標籤找到需要的內容。`;
const topicCollectionJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  '@id': `${topicsIndexUrl}#collection`,
  url: topicsIndexUrl,
  name: 'AI 實作主題',
  description: topicsIndexDescription,
  inLanguage: 'zh-Hant-TW',
  isPartOf: { '@id': `${SITE_URL}/#website` },
  about: { '@id': `${SITE_URL}/#person` },
  breadcrumb: { '@id': `${topicsIndexUrl}#breadcrumb` },
  mainEntity: {
    '@type': 'ItemList',
    numberOfItems: topics.length,
    itemListElement: topics.map((topic, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      url: `${SITE_URL}/topics/${topic.slug}`,
      name: topic.title,
      description: topic.blurb,
    })),
  },
};
const topicsIndexBreadcrumbJsonLd = breadcrumbJsonLd([
  { name: 'Home', url: '/' },
  { name: 'Topics', url: '/topics' },
], topicsIndexUrl);
---
<BaseLayout title={topicsIndexTitle} description={topicsIndexDescription} structuredData={[topicTaxonomyJsonLd, topicCollectionJsonLd, topicsIndexBreadcrumbJsonLd]}>
  <section class="page-hero" aria-labelledby="topics-title">
    <div class="wrap">
      <p class="kicker"><svg class="icon" aria-hidden="true"><use href="#i-files"/></svg>文章分類 · {days.length} 篇</p>
      <h1 id="topics-title">找到值得<Hl>留下</Hl>的知識。</h1>
      <p class="hero-sub">先選想讀的文章類型，再依主題深入。同一篇可以有多個標籤，也可以組合條件，找出你現在需要的內容。</p>
      <p class="page-links">
        <a class="text-link" href="/days">組合篩選文章 <span aria-hidden="true">→</span></a>
        <a class="text-link" href="/search">搜尋文章 <span aria-hidden="true">→</span></a>
      </p>
    </div>
  </section>
  <section class="sec-sm" aria-labelledby="article-types-heading">
    <div class="wrap">
      <p class="kicker">01 · 文章類型</p>
      <h2 id="article-types-heading">你想得到什麼？</h2>
      <p class="section-description">理解原理、學一套做法，或從真實經驗中找答案。</p>
      <div class="taxonomy-choices">
        {ARTICLE_TYPES.map(t => <a class:list={['taxonomy-choice', { 'fundamentals-choice': t.slug === 'fundamentals' }]} href={`/days?type=${t.slug}`}><div class="choice-heading"><h3>{t.title}</h3><span>{countFor('types', t.slug)} 篇</span></div><p>{t.blurb}</p><span class="choice-arrow" aria-hidden="true">↗</span></a>)}
      </div>
    </div>
  </section>
  <section class="sec-sm" aria-labelledby="subjects-heading">
    <div class="wrap">
      <p class="kicker">02 · 內容主題</p>
      <h2 id="subjects-heading">你關心哪件事？</h2>
      <p class="section-description">從模型原理到接案實務；也能在文章列表裡，和類型交叉篩選。</p>
      <div class="card-grid three">
        {subjectTopics.map(t => <TopicCard {...t} />)}
      </div>
    </div>
  </section>
  <section class="sec-sm" aria-labelledby="freshness-heading">
    <div class="wrap">
      <p class="kicker">03 · 時效性</p><h2 id="freshness-heading">哪些資訊需要留意更新？</h2>
      <p class="section-description">一篇可以同時有長期價值與版本細節。長期參考不代表內容永遠正確，也不保證每個細節都不會變。</p>
      <div class="taxonomy-choices freshness-choices">{FRESHNESS.map(t => <a class="taxonomy-choice" href={`/days?freshness=${t.slug}`}><div class="choice-heading"><h3>{t.title}</h3><span>{countFor('freshness', t.slug)} 篇</span></div><p>{t.blurb}</p><span class="choice-arrow" aria-hidden="true">↗</span></a>)}</div>
      <div class="other-entries"><span>其他閱讀入口</span>{otherTopics.map(t => <a class="tag tag-outline" href={`/topics/${t.slug}`}>{t.title} · {t.count} 篇</a>)}</div>
    </div>
  </section>
</BaseLayout>
<style>
  .section-description { margin: 12px 0 26px; color: var(--muted); max-width: 48em; line-height: 1.8; }
  .taxonomy-choices { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 18px; }
  .taxonomy-choice { position: relative; display: block; padding: 26px 26px 42px; min-width: 0; border-radius: 24px; background: var(--white); border: 1.5px solid var(--rule); color: var(--ink); text-decoration: none; transition: border-color .2s; }
  .taxonomy-choice:hover { border-color: var(--persimmon); }
  .fundamentals-choice { background: var(--bubble); border-color: var(--leaf-text); }
  .choice-heading { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 10px; align-items: center; }
  .choice-heading h3 { font-size: 1.45rem; }
  .choice-heading > span { font-size: .9rem; color: var(--muted); }
  .taxonomy-choice p { margin-top: 12px; color: var(--muted); line-height: 1.8; }
  .choice-arrow { position: absolute; bottom: 14px; right: 22px; color: var(--persimmon-text); font-size: 1.3rem; }
  .other-entries { display: flex; align-items: center; flex-wrap: wrap; gap: 12px; margin-top: 30px; color: var(--muted); }
  @media (max-width: 900px) { .taxonomy-choices { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 580px) { .taxonomy-choices { grid-template-columns: minmax(0, 1fr); } }
</style>
