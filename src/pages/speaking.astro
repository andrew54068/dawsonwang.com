---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { ENGAGEMENTS, LECTURE_SESSIONS, PRINCIPLES, RECENT_HOSPITAL_SURVEY, type Attendance, type Engagement } from '../data/speaking';
import { SITE_URL, absoluteUrl, breadcrumbJsonLd } from '../lib/seo';

// Curated course photos are resized into public/speaking/. They live in public/
// rather than being read from the 100days submodule or Drive at build time: both
// sources can be unavailable or stale, and proof images must remain deployable.
const HERO_PHOTO = '/speaking/ccvs-teaching.webp';
const HERO_PHOTO_ALT = 'Dawson Wang 在中正高工電腦教室授課，站在教師之間講解';

const days = await getCollection('days');
const availableDays = new Set<number>(days.map(d => d.data.dayNumber));
const newestLoadedDay = days.reduce((max, d) => Math.max(max, d.data.dayNumber), 0);

function dayHref(dayNumber: number, source: string): string | null {
  if (availableDays.has(dayNumber)) return `/day/${dayNumber}`;
  if (dayNumber <= newestLoadedDay) {
    throw new Error(
      `speaking.ts: ${source} references day ${dayNumber}, but no such entry exists ` +
      `in the days collection (newest loaded day is ${newestLoadedDay}).`
    );
  }
  // Beyond what this checkout loaded — the deploy rsyncs fresh content and the
  // link resolves there. Render the ref unlinked rather than 404-ing.
  return null;
}

interface ResolvedEngagement {
  engagement: Engagement;
  dayRefs: { dayNumber: number; href: string | null }[];
}

const resolved: ResolvedEngagement[] = ENGAGEMENTS.map(engagement => ({
  engagement,
  dayRefs: engagement.days.map(dayNumber => ({
    dayNumber,
    href: dayHref(dayNumber, `engagement "${engagement.slug}"`),
  })),
}));

const principles = PRINCIPLES.map(p => ({ ...p, href: dayHref(p.day, `principle "${p.title}"`) }));

// Six physical teaching sites: 中正高工、奇美總院、柳營奇美、部立臺南、
// 臺南新樓、佳里奇美. A grouped engagement is not the same thing as a site.
const venueCount = 6;
// Seven hospital dates plus the two-day 中正高工 workshop.
const sessionCount = 9;
// The previous verified total was 170. September added at least 45 新樓
// pre-course respondents, 17 佳里 post-course respondents and 18 柳營
// pre-course respondents. These are response records rather than sign-in
// sheets, so publish a conservative lower bound rather than false precision.
const attendeeTotal = '250+';

const speakingTitle = 'AI 講師 · 企業內訓與教師研習';
const speakingDescription = '醫療院所內訓、高中職教師研習、衛福部支持的 AI 應用課程。課程以實作為主——走完課程學員電腦裡真的多出一份成品，而且掛得上網路。全部簡報公開可看。';
const speakingUrl = absoluteUrl('/speaking');

const ATTENDANCE_MODE: Record<Attendance, string> = {
  offline: 'https://schema.org/OfflineEventAttendanceMode',
  online: 'https://schema.org/OnlineEventAttendanceMode',
  mixed: 'https://schema.org/MixedEventAttendanceMode',
};

const speakingJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ProfilePage',
  '@id': `${speakingUrl}#profilepage`,
  name: speakingTitle,
  description: speakingDescription,
  url: speakingUrl,
  inLanguage: 'zh-Hant-TW',
  isPartOf: { '@id': `${SITE_URL}/#website` },
  about: { '@id': `${SITE_URL}/#person` },
  breadcrumb: { '@id': `${speakingUrl}#breadcrumb` },
  primaryImageOfPage: absoluteUrl(HERO_PHOTO),
  mainEntity: {
    '@type': 'ItemList',
    name: '授課紀錄',
    numberOfItems: ENGAGEMENTS.length,
    itemListElement: ENGAGEMENTS.map((engagement, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      item: {
        '@type': 'Event',
        '@id': `${speakingUrl}#${engagement.slug}`,
        name: `${engagement.venue} — ${engagement.title}`,
        description: engagement.takeaway,
        // startDate is required for Event — omit it and Google throws the whole
        // item out. See the field docs in src/data/speaking.ts.
        startDate: engagement.start,
        ...(engagement.end ? { endDate: engagement.end } : {}),
        eventAttendanceMode: ATTENDANCE_MODE[engagement.attendance],
        eventStatus: 'https://schema.org/EventScheduled',
        location: { '@type': 'Place', name: engagement.venue, address: { '@type': 'PostalAddress', addressCountry: 'TW' } },
        performer: { '@id': `${SITE_URL}/#person` },
        organizer: { '@type': 'Organization', name: engagement.venue },
      },
    })),
  },
};

const speakingBreadcrumbJsonLd = breadcrumbJsonLd([
  { name: 'Home', url: '/' },
  { name: 'Speaking', url: '/speaking' },
], speakingUrl);
---
<BaseLayout
  title={speakingTitle}
  description={speakingDescription}
  ogImage={HERO_PHOTO}
  ogImageWidth={1600}
  ogImageHeight={1200}
  ogImageAlt={HERO_PHOTO_ALT}
  structuredData={[speakingJsonLd, speakingBreadcrumbJsonLd]}
>
  <article class="speaking-editorial">
    <div class="editorial-shell">
      <header class="editorial-hero">
        <div class="editorial-hero-copy">
          <div class="editorial-kicker">SPEAKING · 講師邀約</div>
          <h1>聽完覺得有收穫不算。<br />要<span>帶著成品</span>離開教室。</h1>
          <p class="editorial-lede">
            我教的不是「AI 有哪些工具」，是把 AI 接進你原本就在做的那條流程。
            課程以實作為主：走完課程，學員的電腦裡真的多出一份可以編輯的成品，
            而且自己做的東西真的掛得上網路、別人打得開。
          </p>
          <div class="editorial-actions">
            <a href="/#inquire" class="editorial-button editorial-button-dark">討論企業需求 <span>↗</span></a>
            <a href="#lecture-sessions" class="editorial-text-link">看實際場次 <span>↓</span></a>
          </div>
        </div>
        <figure class="editorial-hero-media">
          <img src={HERO_PHOTO} alt={HERO_PHOTO_ALT} width="1600" height="1200" />
          <figcaption><span>01</span> 在座位旁一起把下一步做完</figcaption>
        </figure>
      </header>

      <section id="recent-hospital-survey" class="editorial-proof" aria-labelledby="recent-hospital-survey-title">
        <div class="editorial-proof-heading">
          <div class="editorial-kicker">2026/09 · 佳里＋柳營</div>
          <h2 id="recent-hospital-survey-title">兩場匿名課後問卷</h2>
          <p>共 {RECENT_HOSPITAL_SURVEY.responses} 份回覆。只呈現整體結果，不引用未取得公開同意的個別留言。</p>
        </div>
        <dl class="editorial-proof-stats">
          <div><dt>平均評分</dt><dd>{RECENT_HOSPITAL_SURVEY.averageScore}</dd></div>
          <div><dt>完成六步實作</dt><dd class="accent">{RECENT_HOSPITAL_SURVEY.completedAllSteps}</dd></div>
          <div><dt>會／應該會用在工作</dt><dd>{RECENT_HOSPITAL_SURVEY.likelyToUseAtWork}</dd></div>
        </dl>
      </section>

      <dl class="editorial-stats">
        <div><dt>授課單位</dt><dd>{venueCount}</dd></div>
        <div><dt>授課場次</dt><dd class="accent">{sessionCount}</dd></div>
        <div><dt>累積人次</dt><dd>{attendeeTotal}</dd></div>
        <div><dt>授課領域</dt><dd class="editorial-stat-text">醫療 · 教育</dd></div>
      </dl>

      <section id="lecture-sessions" class="editorial-section" aria-labelledby="lecture-sessions-title">
        <div class="editorial-section-heading">
          <div>
            <div class="editorial-kicker">LECTURES · {LECTURE_SESSIONS.length}</div>
            <h2 id="lecture-sessions-title">每一場，分開看現場</h2>
          </div>
          <p>每場只留兩張：一張交代授課狀態，一張保留學員參與的樣子。</p>
        </div>

        <div class="editorial-lectures">
          {LECTURE_SESSIONS.map((session, index) => (
            <article id={session.id} data-lecture-session data-editorial-lecture class="editorial-lecture scroll-mt-20">
              <header class="editorial-lecture-header">
                <div>
                  <div class="editorial-index">{String(index + 1).padStart(2, '0')} · {session.date.replaceAll('-', '/')}</div>
                  <h3>{session.venue}<span> · {session.title}</span></h3>
                </div>
                <p>{session.summary}</p>
              </header>

              <div class="editorial-lecture-photos">
                {session.photos.map((photo, photoIndex) => (
                  <figure class={photoIndex === 0 ? 'editorial-photo editorial-photo-primary' : 'editorial-photo editorial-photo-secondary'}>
                    <img
                      src={photo.src}
                      alt={photo.alt}
                      width={photo.width}
                      height={photo.height}
                      loading="lazy"
                      decoding="async"
                      sizes="(min-width: 900px) 40rem, 100vw"
                    />
                  </figure>
                ))}
              </div>

              {session.decks.length > 0 && (
                <div class="editorial-lecture-links">
                  <span>公開簡報</span>
                  {session.decks.map(deck => (
                    <a href={deck.url} rel="noopener" class="editorial-text-link">
                      {deck.title} · {deck.segment} <span>↗</span>
                    </a>
                  ))}
                </div>
              )}
            </article>
          ))}
        </div>
      </section>

      <section class="editorial-section editorial-curriculum">
        <div class="editorial-section-heading">
          <div><div class="editorial-kicker">CURRICULUM</div><h2>課程內容</h2></div>
          <p>先說清楚受眾與工作情境，再安排每一步實作。</p>
        </div>
        <div class="editorial-engagements">
          {resolved.map(({ engagement, dayRefs }) => (
            <article id={engagement.slug} class="editorial-engagement scroll-mt-20">
              <header>
                <div class="editorial-index">{engagement.when}</div>
                <h3>{engagement.venue}<span> · {engagement.title}</span></h3>
                <span class="editorial-format">{engagement.format}</span>
              </header>
              <dl>
                <div><dt>受眾</dt><dd>{engagement.audience}</dd></div>
                {engagement.sessions && <div><dt>已完成場次</dt><dd class="editorial-session-tags">{engagement.sessions.map(session => <span>{session}</span>)}</dd></div>}
                <div><dt>課程路線</dt><dd><ol>{engagement.outline.map((step, i) => <li><span>{String(i + 1).padStart(2, '0')}</span>{step}</li>)}</ol></dd></div>
                <div><dt>帶走什麼</dt><dd class="editorial-takeaway">{engagement.takeaway}</dd></div>
              </dl>
              {engagement.decks.length > 0 && <div class="editorial-decks"><span>簡報（公開可看）</span>{engagement.decks.map(deck => <a href={deck.url} rel="noopener" class="editorial-text-link">{deck.title} · {deck.segment} <span>↗</span></a>)}</div>}
              <div class="editorial-days"><span>現場記錄</span>{dayRefs.map(ref => ref.href ? <a href={ref.href}>Day {String(ref.dayNumber).padStart(3, '0')}</a> : <span>Day {String(ref.dayNumber).padStart(3, '0')}</span>)}</div>
            </article>
          ))}
        </div>
      </section>

      <section class="editorial-section editorial-method">
        <div class="editorial-section-heading">
          <div><div class="editorial-kicker">METHOD</div><h2>課怎麼設計的</h2></div>
          <p>這套做法是在醫院幾場課之間來回修正，加上和助教討論後才長出來的。</p>
        </div>
        <div class="editorial-principles">
          {principles.map((p, index) => (
            <article class="editorial-principle">
              <div class="editorial-principle-number">{String(index + 1).padStart(2, '0')}</div>
              <h3>{p.title}</h3>
              <p>{p.body}</p>
              {p.href ? <a href={p.href} class="editorial-text-link">Day {String(p.day).padStart(3, '0')} <span>↗</span></a> : <span class="editorial-day-label">Day {String(p.day).padStart(3, '0')}</span>}
            </article>
          ))}
        </div>
      </section>

      <aside class="editorial-cta">
        <div><div class="editorial-kicker">講師邀約</div><h2>一起設計一場真正用得上的 AI 實作課</h2></div>
        <div class="editorial-cta-copy"><p>企業內訓、教師研習、社群分享都可以。告訴我受眾是誰、想解決什麼，我會依照程度與工作情境重新安排課程。1–2 個工作日內回信。</p><div class="editorial-actions"><a href="/#inquire" class="editorial-button editorial-button-light">談談你的場次 <span>↗</span></a><a href="/projects" class="editorial-text-link">看我做的工具 <span>↗</span></a></div></div>
      </aside>
    </div>
  </article>
</BaseLayout>

<style>
  :global(body:has(.speaking-editorial)) { background: #f5f0e7; }
  :global(html:not([data-theme="stripe"]) body:has(.speaking-editorial)) { background: #15191b; }

  .speaking-editorial {
    --editorial-paper: #f5f0e7;
    --editorial-surface: #fbf9f4;
    --editorial-ink: #1b2930;
    --editorial-muted: #657176;
    --editorial-faint: #89928f;
    --editorial-rule: #c9c8bf;
    --editorial-accent: #789873;
    --editorial-deep: #27383a;
    color: var(--editorial-ink);
    background: var(--editorial-paper);
    font-family: "Noto Sans TC", system-ui, sans-serif;
  }
  :global(html:not([data-theme="stripe"])) .speaking-editorial {
    --editorial-paper: #15191b;
    --editorial-surface: #1d2425;
    --editorial-ink: #f3efe5;
    --editorial-muted: #b5b7ad;
    --editorial-faint: #8b948c;
    --editorial-rule: #465052;
    --editorial-accent: #9dbb8d;
    --editorial-deep: #0e1416;
  }
  .editorial-shell { max-width: 1160px; margin: 0 auto; padding: 4.5rem 2rem 6rem; }
  .editorial-kicker, .editorial-index, .editorial-proof dt, .editorial-stats dt, .editorial-engagement dt, .editorial-lecture-links > span, .editorial-decks > span, .editorial-days > span, .editorial-format, .editorial-day-label {
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: .13em;
    line-height: 1.4;
    text-transform: uppercase;
  }
  .editorial-kicker { color: var(--editorial-accent); }
  .editorial-hero { display: grid; grid-template-columns: minmax(0, .95fr) minmax(0, 1.05fr); gap: clamp(2.5rem, 7vw, 7rem); align-items: end; padding-bottom: 4rem; border-bottom: 1px solid var(--editorial-rule); }
  .editorial-hero-copy { padding-bottom: .75rem; }
  .editorial-hero h1, .editorial-section h2, .editorial-cta h2 { font-family: "Noto Serif TC", "Songti TC", Georgia, serif; font-weight: 600; letter-spacing: -.045em; }
  .editorial-hero h1 { margin: 1rem 0 1.5rem; font-size: clamp(2.45rem, 5.2vw, 5.25rem); line-height: 1.08; text-wrap: balance; }
  .editorial-hero h1 span { color: var(--editorial-accent); }
  .editorial-lede { max-width: 34rem; margin: 0; color: var(--editorial-muted); font-size: 1.04rem; line-height: 1.9; }
  .editorial-hero-media { margin: 0; }
  .editorial-hero-media img { display: block; width: 100%; aspect-ratio: 4 / 3; object-fit: cover; filter: saturate(.82); }
  .editorial-hero-media figcaption { display: flex; justify-content: space-between; gap: 1rem; padding-top: .7rem; color: var(--editorial-faint); font-family: var(--font-mono); font-size: 10px; letter-spacing: .08em; text-transform: uppercase; }
  .editorial-hero-media figcaption span, .editorial-index, .editorial-principle-number { color: var(--editorial-accent); }
  .editorial-actions { display: flex; align-items: center; flex-wrap: wrap; gap: 1.25rem; margin-top: 2rem; }
  .editorial-button { display: inline-flex; align-items: center; gap: .8rem; padding: .8rem 1.15rem; border: 1px solid transparent; font-size: .8rem; text-decoration: none; transition: transform 160ms ease, background 160ms ease, color 160ms ease; }
  .editorial-button:hover { transform: translateY(-2px); }
  .editorial-button-dark { background: var(--editorial-ink); color: var(--editorial-paper); }
  .editorial-button-light { background: var(--editorial-paper); color: var(--editorial-ink); }
  .editorial-button span, .editorial-text-link span { color: var(--editorial-accent); }
  .editorial-text-link { color: var(--editorial-ink); text-decoration: none; border-bottom: 1px solid var(--editorial-rule); font-size: .78rem; line-height: 1.7; transition: color 160ms ease, border-color 160ms ease; }
  .editorial-text-link:hover { color: var(--editorial-accent); border-color: var(--editorial-accent); }

  .editorial-proof { display: grid; grid-template-columns: minmax(13rem, .85fr) minmax(0, 1.8fr); gap: 2rem; align-items: end; padding: 2.1rem 0; border-bottom: 1px solid var(--editorial-rule); }
  .editorial-proof-heading h2 { margin: .45rem 0 .5rem; font-family: "Noto Serif TC", "Songti TC", Georgia, serif; font-size: 1.25rem; font-weight: 600; }
  .editorial-proof-heading p, .editorial-section-heading p { max-width: 28rem; margin: 0; color: var(--editorial-muted); font-size: .78rem; line-height: 1.8; }
  .editorial-proof-stats, .editorial-stats { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); margin: 0; border-left: 1px solid var(--editorial-rule); }
  .editorial-proof-stats > div, .editorial-stats > div { padding: .2rem 1.2rem; border-right: 1px solid var(--editorial-rule); }
  .editorial-proof dd { margin: .35rem 0 0; font-family: var(--font-mono); font-size: clamp(1.6rem, 3vw, 2.35rem); letter-spacing: -.04em; }
  .editorial-proof dd.accent, .editorial-stats dd.accent { color: var(--editorial-accent); }
  .editorial-stats { grid-template-columns: repeat(4, minmax(0, 1fr)); margin-top: 1.5rem; border-top: 1px solid var(--editorial-rule); border-left: 0; }
  .editorial-stats > div { padding: 1.2rem; border-bottom: 1px solid var(--editorial-rule); }
  .editorial-stats dd { margin: .45rem 0 0; font-family: var(--font-mono); font-size: 1.75rem; letter-spacing: -.05em; }
  .editorial-stat-text { font-family: "Noto Sans TC", sans-serif !important; font-size: .9rem !important; letter-spacing: 0 !important; }

  .editorial-section { margin-top: 7rem; }
  .editorial-section-heading { display: flex; align-items: end; justify-content: space-between; gap: 2rem; margin-bottom: 2.3rem; }
  .editorial-section h2 { margin: .65rem 0 0; font-size: clamp(1.8rem, 3.5vw, 3rem); line-height: 1.15; }
  .editorial-lectures { border-top: 1px solid var(--editorial-rule); }
  .editorial-lecture { padding: 2rem 0 2.5rem; border-bottom: 1px solid var(--editorial-rule); }
  .editorial-lecture-header { display: grid; grid-template-columns: minmax(0, 1.2fr) minmax(14rem, .8fr); gap: 2rem; align-items: start; margin-bottom: 1.35rem; }
  .editorial-lecture h3, .editorial-engagement h3, .editorial-principle h3 { margin: .5rem 0 0; font-family: "Noto Serif TC", "Songti TC", Georgia, serif; font-weight: 600; letter-spacing: -.025em; }
  .editorial-lecture h3 { font-size: 1.25rem; line-height: 1.4; }
  .editorial-lecture h3 span, .editorial-engagement h3 span { color: var(--editorial-muted); font-weight: 400; }
  .editorial-lecture-header p { margin: 0; color: var(--editorial-muted); font-size: .78rem; line-height: 1.8; }
  .editorial-lecture-photos { display: grid; grid-template-columns: minmax(0, 1.2fr) minmax(0, .8fr); gap: 1px; background: var(--editorial-rule); }
  .editorial-lecture:nth-child(even) .editorial-photo-primary { order: 2; }
  .editorial-lecture:nth-child(even) .editorial-photo-secondary { order: 1; }
  .editorial-photo { margin: 0; overflow: hidden; background: var(--editorial-surface); }
  .editorial-photo img { display: block; width: 100%; height: 100%; min-height: 14rem; object-fit: cover; filter: saturate(.86); transition: transform 360ms ease, filter 360ms ease; }
  .editorial-photo-primary img { aspect-ratio: 4 / 3; }
  .editorial-photo-secondary img { aspect-ratio: 1 / 1; }
  .editorial-lecture:hover .editorial-photo img { transform: scale(1.018); filter: saturate(1); }
  .editorial-lecture-links, .editorial-decks, .editorial-days { display: flex; align-items: baseline; flex-wrap: wrap; gap: .75rem 1.2rem; margin-top: 1.2rem; }
  .editorial-lecture-links > span, .editorial-decks > span, .editorial-days > span { color: var(--editorial-faint); }

  .editorial-engagements { border-top: 1px solid var(--editorial-rule); }
  .editorial-engagement { display: grid; grid-template-columns: minmax(13rem, .8fr) minmax(0, 1.2fr); gap: 2.5rem; padding: 2.2rem 0; border-bottom: 1px solid var(--editorial-rule); }
  .editorial-engagement h3 { font-size: 1.35rem; line-height: 1.45; }
  .editorial-format { display: inline-block; margin-top: 1.25rem; padding: .35rem .6rem; border: 1px solid var(--editorial-rule); color: var(--editorial-muted); }
  .editorial-engagement dl { margin: 0; color: var(--editorial-muted); font-size: .82rem; line-height: 1.85; }
  .editorial-engagement dl > div + div { margin-top: 1.1rem; }
  .editorial-engagement dd { margin: .25rem 0 0; }
  .editorial-engagement ol { display: grid; gap: .35rem; margin: 0; padding: 0; list-style: none; }
  .editorial-engagement li { display: flex; gap: .7rem; }
  .editorial-engagement li span { flex: 0 0 auto; color: var(--editorial-accent); font-family: var(--font-mono); font-size: 10px; }
  .editorial-takeaway { color: var(--editorial-ink); }
  .editorial-session-tags { display: flex; flex-wrap: wrap; gap: .4rem; }
  .editorial-session-tags span { padding: .25rem .5rem; border: 1px solid var(--editorial-rule); color: var(--editorial-muted); font-size: .72rem; }
  .editorial-days { grid-column: 2; margin-top: -.9rem; }
  .editorial-days a, .editorial-days > span:not(:first-child), .editorial-day-label { color: var(--editorial-muted); font-family: var(--font-mono); font-size: 10px; text-decoration: none; }
  .editorial-days a:hover { color: var(--editorial-accent); }

