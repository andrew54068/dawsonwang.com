---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import HomeIcons from '../components/home/HomeIcons.astro';
import HomeNav from '../components/home/HomeNav.astro';
import HomeFooter from '../components/home/HomeFooter.astro';
import { ENGAGEMENTS, LECTURE_SESSIONS, PRINCIPLES, RECENT_HOSPITAL_SURVEY, type Attendance, type Engagement } from '../data/speaking';
import { SITE_URL, absoluteUrl, breadcrumbJsonLd } from '../lib/seo';
import '../styles/home-warm.css';

// Curated course photos are resized into public/speaking/. They live in public/
// rather than being read from the 100days submodule or Drive at build time: both
// sources can be unavailable or stale, and proof images must remain deployable.
const HERO_PHOTO = '/speaking/ccvs-teaching.webp';
const HERO_PHOTO_ALT = 'Dawson Wang 在中正高工電腦教室授課，站在教師之間講解';

const days = await getCollection('days');
const availableDays = new Set<number>(days.map(d => d.data.dayNumber));
const newestLoadedDay = days.reduce((max, d) => Math.max(max, d.data.dayNumber), 0);

function dayHref(dayNumber: number, source: string): string | null {
  if (availableDays.has(dayNumber)) return `/day/${dayNumber}`;
  if (dayNumber <= newestLoadedDay) {
    throw new Error(
      `speaking.ts: ${source} references day ${dayNumber}, but no such entry exists ` +
      `in the days collection (newest loaded day is ${newestLoadedDay}).`
    );
  }
  // Beyond what this checkout loaded — the deploy rsyncs fresh content and the
  // link resolves there. Render the ref unlinked rather than 404-ing.
  return null;
}

interface ResolvedEngagement {
  engagement: Engagement;
  dayRefs: { dayNumber: number; href: string | null }[];
}

const resolved: ResolvedEngagement[] = ENGAGEMENTS.map(engagement => ({
  engagement,
  dayRefs: engagement.days.map(dayNumber => ({
    dayNumber,
    href: dayHref(dayNumber, `engagement "${engagement.slug}"`),
  })),
}));

const principles = PRINCIPLES.map(p => ({ ...p, href: dayHref(p.day, `principle "${p.title}"`) }));

// Six physical teaching sites: 中正高工、奇美總院、柳營奇美、部立臺南、
// 臺南新樓、佳里奇美. A grouped engagement is not the same thing as a site.
const venueCount = 6;
// Seven hospital dates plus the two-day 中正高工 workshop.
const sessionCount = 9;
// A conservative lower bound across the delivered sessions — response records
// rather than sign-in sheets, so publish a floor rather than false precision.
const attendeeTotal = '250+';

const speakingTitle = 'AI 講師 · 企業內訓與教師研習';
const speakingDescription = '醫療院所內訓、高中職教師研習、衛福部支持的 AI 應用課程。課程以實作為主——走完課程學員電腦裡真的多出一份成品，而且掛得上網路。全部簡報公開可看。';
const speakingUrl = absoluteUrl('/speaking');

const ATTENDANCE_MODE: Record<Attendance, string> = {
  offline: 'https://schema.org/OfflineEventAttendanceMode',
  online: 'https://schema.org/OnlineEventAttendanceMode',
  mixed: 'https://schema.org/MixedEventAttendanceMode',
};

const speakingJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ProfilePage',
  '@id': `${speakingUrl}#profilepage`,
  name: speakingTitle,
  description: speakingDescription,
  url: speakingUrl,
  inLanguage: 'zh-Hant-TW',
  isPartOf: { '@id': `${SITE_URL}/#website` },
  about: { '@id': `${SITE_URL}/#person` },
  breadcrumb: { '@id': `${speakingUrl}#breadcrumb` },
  primaryImageOfPage: absoluteUrl(HERO_PHOTO),
  mainEntity: {
    '@type': 'ItemList',
    name: '授課紀錄',
    numberOfItems: ENGAGEMENTS.length,
    itemListElement: ENGAGEMENTS.map((engagement, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      item: {
        '@type': 'Event',
        '@id': `${speakingUrl}#${engagement.slug}`,
        name: `${engagement.venue} — ${engagement.title}`,
        description: engagement.takeaway,
        // startDate is required for Event — omit it and Google throws the whole
        // item out. See the field docs in src/data/speaking.ts.
        startDate: engagement.start,
        ...(engagement.end ? { endDate: engagement.end } : {}),
        eventAttendanceMode: ATTENDANCE_MODE[engagement.attendance],
        eventStatus: 'https://schema.org/EventScheduled',
        location: { '@type': 'Place', name: engagement.venue, address: { '@type': 'PostalAddress', addressCountry: 'TW' } },
        performer: { '@id': `${SITE_URL}/#person` },
        organizer: { '@type': 'Organization', name: engagement.venue },
      },
    })),
  },
};

const speakingBreadcrumbJsonLd = breadcrumbJsonLd([
  { name: 'Home', url: '/' },
  { name: 'Speaking', url: '/speaking' },
], speakingUrl);
---
<BaseLayout
  title={speakingTitle}
  description={speakingDescription}
  ogImage={HERO_PHOTO}
  ogImageWidth={1600}
  ogImageHeight={1200}
  ogImageAlt={HERO_PHOTO_ALT}
  structuredData={[speakingJsonLd, speakingBreadcrumbJsonLd]}
  showNav={false}
  showFooter={false}
  wrapMain={false}
>
  <script is:inline>document.documentElement.classList.add('js');</script>
  <div class="home-warm speaking-warm">
    <HomeIcons />
    <a class="skip" href="#main">跳到主要內容</a>
    <HomeNav />
    <main id="main">

      <!-- ═══ Hero ═══ -->
      <section class="hero" aria-labelledby="sp-hero-title">
        <div class="wrap hero-grid">
          <div class="hero-copy">
            <p class="kicker load" style="--d:0"><svg class="icon" aria-hidden="true"><use href="#i-school"/></svg>講師邀約 · 企業內訓與教師研習</p>
            <h1 id="sp-hero-title" class="load" style="--d:1">聽完覺得有收穫不算，<br>要<span class="hl">帶著成品<svg class="hl-line" viewBox="0 0 200 36" preserveAspectRatio="none" aria-hidden="true"><path class="draw draw-in" pathLength="1" d="M5 20C48 11 108 7 195 13"/><path class="draw draw-in" pathLength="1" d="M28 30c46-6 104-7 150-3"/></svg></span>離開教室。</h1>
            <p class="hero-sub load" style="--d:2">我教的不是「AI 有哪些工具」，是把 AI 接進你原本就在做的那條流程。走完課程，學員電腦裡真的多出一份可以編輯的成品，而且掛得上網路、別人打得開。</p>
            <div class="hero-ctas load" style="--d:3">
              <a class="btn btn-primary btn-lg" href="/#inquire">討論企業需求 <span class="arr" aria-hidden="true">→</span></a>
              <a class="btn btn-soft btn-lg" href="#lecture-sessions">看實際場次 <span aria-hidden="true">↓</span></a>
            </div>
          </div>

          <figure class="hero-photo load-photo">
            <svg class="blob blob-a" viewBox="0 0 600 600" aria-hidden="true"><path fill="currentColor" d="M452 98c58 46 92 128 78 207-14 80-75 157-157 187-81 31-183 14-247-42C62 395 37 296 64 214 91 132 170 67 256 54c86-13 138-2 196 44Z"/></svg>
            <svg class="blob blob-b" viewBox="0 0 600 600" aria-hidden="true"><path fill="currentColor" d="M300 60c84 6 170 48 200 126 30 77 4 190-64 250-68 61-178 70-260 34C94 434 40 352 46 270 52 188 118 108 186 80c34-14 70-22 114-20Z"/></svg>
            <div class="photo-frame">
              <div class="photo-inner">
                <img src={HERO_PHOTO} alt={HERO_PHOTO_ALT} width="1600" height="1200" fetchpriority="high" decoding="async" />
              </div>
            </div>
            <svg class="doodle-squiggle draw" viewBox="0 0 110 30" aria-hidden="true"><path stroke="currentColor" stroke-width="4" d="M4 20c9-14 15 9 24-4s15 9 24-4 15 9 24-4 14 8 30-2"/></svg>
            <figcaption class="sp-hero-cap">在座位旁，一起把下一步做完。</figcaption>
          </figure>
        </div>

        <div class="wrap">
          <dl class="sp-stats" aria-label="授課統計">
            <div><dt>授課單位</dt><dd>{venueCount}</dd></div>
            <div><dt>授課場次</dt><dd class="accent">{sessionCount}</dd></div>
            <div><dt>累積人次</dt><dd>{attendeeTotal}</dd></div>
            <div><dt>授課領域</dt><dd class="sp-stat-text">醫療 · 教育</dd></div>
          </dl>
        </div>
      </section>

      <!-- ═══ 課後問卷 ═══ -->
      <section class="band" aria-labelledby="recent-hospital-survey-title">
        <div class="wrap">
          <div class="sec-head center">
            <p class="eyebrow">課後回饋</p>
            <h2 id="recent-hospital-survey-title">課後匿名問卷結果</h2>
            <p class="sec-sub">只呈現整體結果，不引用未取得公開同意的個別留言。</p>
          </div>
          <div id="recent-hospital-survey" class="survey sp-survey reveal" data-reveal>
            <dl class="survey-nums">
              <div><dt>平均評分</dt><dd>{RECENT_HOSPITAL_SURVEY.averageScore}</dd></div>
              <div><dt>完成六步實作</dt><dd>{RECENT_HOSPITAL_SURVEY.completedAllSteps}</dd></div>
              <div><dt><span class="ph">會或應該會</span><span class="ph">用在工作上</span></dt><dd>{RECENT_HOSPITAL_SURVEY.likelyToUseAtWork}</dd></div>
            </dl>
          </div>
        </div>
      </section>

      <!-- ═══ 每一場現場 ═══ -->
      <section class="sec" id="lecture-sessions" aria-labelledby="lecture-sessions-title">
        <div class="wrap">
          <div class="sec-head">
            <p class="eyebrow">實際場次 · {LECTURE_SESSIONS.length}</p>
            <h2 id="lecture-sessions-title">每一場，<br>分開看現場。</h2>
            <p class="sec-sub">每場留下現場的樣子：一張交代授課狀態，一張保留學員參與的畫面。</p>
          </div>
          <div class="sp-lectures">
            {LECTURE_SESSIONS.map((session, index) => (
              <article id={session.id} data-lecture-session class="sp-lecture reveal scroll-mt-20" data-reveal>
                <div class="sp-lecture-head">
                  <div>
                    <p class="sp-index">{String(index + 1).padStart(2, '0')} · {session.date.replaceAll('-', '/')}</p>
                    <h3>{session.venue}<span> · {session.title}</span></h3>
                  </div>
                  <p class="sp-lecture-sum">{session.summary}</p>
                </div>
                <div class="sp-shots">
                  {session.photos.slice(0, 2).map(photo => (
                    <figure class="sp-shot">
                      <img src={photo.src} alt={photo.alt} width={photo.width} height={photo.height} loading="lazy" decoding="async" sizes="(min-width: 900px) 40rem, 100vw" />
                    </figure>
                  ))}
                </div>
                {session.decks.length > 0 && (
                  <div class="sp-decks">
                    <span>公開簡報</span>
                    {session.decks.map(deck => (
                      <a href={deck.url} rel="noopener" class="text-link">{deck.title} · {deck.segment} <span aria-hidden="true">↗</span></a>
                    ))}
                  </div>
                )}
              </article>
            ))}
          </div>
        </div>
      </section>

      <!-- ═══ 課程內容 ═══ -->
      <section class="band" aria-labelledby="curriculum-title">
        <div class="wrap">
          <div class="sec-head">
            <p class="eyebrow">課程內容</p>
            <h2 id="curriculum-title">先說清楚受眾，<br>再安排每一步實作。</h2>
          </div>
          <div class="sp-grid2">
            {resolved.map(({ engagement, dayRefs }) => (
              <article id={engagement.slug} class="sp-card sp-engagement reveal scroll-mt-20" data-reveal>
                <p class="sp-index">{engagement.when}</p>
                <h3>{engagement.venue}<span> · {engagement.title}</span></h3>
                <p class="sp-format">{engagement.format}</p>
                <dl class="sp-eng-dl">
                  <div><dt>受眾</dt><dd>{engagement.audience}</dd></div>
                  {engagement.sessions && <div><dt>已完成場次</dt><dd class="sp-session-tags">{engagement.sessions.map(session => <span>{session}</span>)}</dd></div>}
                  <div><dt>課程路線</dt><dd><ol class="sp-outline">{engagement.outline.map((step, i) => <li><span>{String(i + 1).padStart(2, '0')}</span>{step}</li>)}</ol></dd></div>
                  <div><dt>帶走什麼</dt><dd class="sp-takeaway">{engagement.takeaway}</dd></div>
                </dl>
                {engagement.decks.length > 0 && <div class="sp-decks"><span>簡報（公開可看）</span>{engagement.decks.map(deck => <a href={deck.url} rel="noopener" class="text-link">{deck.title} · {deck.segment} <span aria-hidden="true">↗</span></a>)}</div>}
                <div class="sp-days"><span>現場記錄</span>{dayRefs.map(ref => ref.href ? <a href={ref.href} class="text-link">Day {String(ref.dayNumber).padStart(3, '0')}</a> : <span class="sp-day-flat">Day {String(ref.dayNumber).padStart(3, '0')}</span>)}</div>
              </article>
            ))}
          </div>
        </div>
      </section>

      <!-- ═══ 課怎麼設計的 ═══ -->
      <section class="sec" aria-labelledby="method-title">
        <div class="wrap">
          <div class="sec-head">
            <p class="eyebrow">課怎麼設計的</p>
            <h2 id="method-title">在幾場課之間，<br>來回修正出來的。</h2>
          </div>
          <div class="sp-grid2">
            {principles.map((p, index) => (
              <article class="sp-card sp-principle reveal" data-reveal style={`--i:${index % 2}`}>
                <span class="sp-pnum" aria-hidden="true"><svg viewBox="0 0 64 64"><use href="#i-ring" class="draw" stroke="currentColor"/></svg>{String(index + 1).padStart(2, '0')}</span>
                <h3>{p.title}</h3>
                <p>{p.body}</p>
                {p.href ? <a href={p.href} class="text-link">Day {String(p.day).padStart(3, '0')} <span aria-hidden="true">↗</span></a> : <span class="sp-day-flat">Day {String(p.day).padStart(3, '0')}</span>}
              </article>
            ))}
          </div>
        </div>
      </section>

      <!-- ═══ 邀約 CTA ═══ -->
      <section class="band" aria-labelledby="sp-cta-title">
        <div class="wrap">
          <div class="sec-head center">
            <p class="eyebrow">講師邀約</p>
            <h2 id="sp-cta-title">一起設計一場，<br>真正用得上的 AI 實作課。</h2>
            <p class="sec-sub">企業內訓、教師研習、社群分享都可以。告訴我受眾是誰、想解決什麼，我會依程度與工作情境重新安排課程。1–2 個工作日內回信。</p>
          </div>
          <div class="sp-cta-actions">
            <a class="btn btn-primary btn-lg" href="/#inquire">談談你的場次 <span class="arr" aria-hidden="true">→</span></a>
            <a class="text-link" href="/projects">看我做的工具 <span aria-hidden="true">→</span></a>
          </div>
        </div>
      </section>

    </main>
    <HomeFooter />
  </div>
</BaseLayout>

<style>
  /* Speaking page reuses the home warm vocabulary (.home-warm in home-warm.css);
     these are the few page-specific pieces on top of it. */
  .speaking-warm .sp-hero-cap { position: relative; z-index: 4; margin-top: 1.9rem; text-align: center; font: 400 1.25rem/1.5 var(--f-note); color: var(--persimmon-text); }

  .speaking-warm .sp-stats { margin-top: clamp(40px, 4vw, 56px); display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 20px; }
  .speaking-warm .sp-stats > div { padding: 22px 24px 24px; border-radius: 26px; background: var(--white); box-shadow: 0 0 0 6px var(--white), 0 16px 30px -16px rgba(46, 35, 28, .42); }
  .speaking-warm .sp-stats > div:nth-child(1) { background: var(--peach); box-shadow: 0 0 0 6px var(--peach), 0 16px 30px -16px rgba(46,35,28,.42); rotate: -1.5deg; }
  .speaking-warm .sp-stats > div:nth-child(2) { background: var(--bubble); box-shadow: 0 0 0 6px var(--bubble), 0 16px 30px -16px rgba(46,35,28,.42); rotate: 1deg; }
  .speaking-warm .sp-stats > div:nth-child(4) { background: var(--peach); box-shadow: 0 0 0 6px var(--peach), 0 16px 30px -16px rgba(46,35,28,.42); rotate: 1.5deg; }
  .speaking-warm .sp-stats dt { font-size: 1rem; color: var(--ink); }
  .speaking-warm .sp-stats dd { margin: 10px 0 0; font: 700 clamp(2.1rem, 1.4rem + 1.7vw, 3rem)/1 var(--f-hand); color: var(--persimmon-ink); }
  .speaking-warm .sp-stats dd.accent { color: var(--leaf-text); }
  .speaking-warm .sp-stats .sp-stat-text { font: 700 1.3rem/1.3 var(--f-hand); color: var(--ink); }

  .speaking-warm .sp-survey { max-width: 820px; margin-inline: auto; }
  .speaking-warm .sp-survey .survey-nums dd { white-space: nowrap; }

  .speaking-warm .sp-lectures { display: grid; gap: 24px; }
  .speaking-warm .sp-lecture { padding: clamp(22px, 2.6vw, 30px); border-radius: 30px; background: var(--white); box-shadow: var(--shadow-sm); }
  .speaking-warm .sp-lecture-head { display: grid; grid-template-columns: minmax(0, 1.1fr) minmax(0, .9fr); gap: 14px 32px; align-items: start; margin-bottom: 20px; }
  .speaking-warm .sp-index { font-weight: 700; font-size: 1rem; color: var(--leaf-text); }
  .speaking-warm .sp-lecture h3 { margin-top: 6px; font-size: clamp(1.3rem, 1.1rem + .5vw, 1.55rem); }
  .speaking-warm .sp-lecture h3 span { color: var(--muted); font-weight: 400; }
  .speaking-warm .sp-lecture-sum { margin: 0; color: var(--muted); font-size: 1.04rem; line-height: 1.8; }
  .speaking-warm .sp-shots { display: grid; grid-template-columns: 1.2fr .8fr; gap: 14px; }
  .speaking-warm .sp-shot { margin: 0; }
  .speaking-warm .sp-shot img { width: 100%; height: 100%; min-height: 13rem; aspect-ratio: 4 / 3; object-fit: cover; border-radius: 18px; }
  .speaking-warm .sp-decks { display: flex; flex-wrap: wrap; gap: 8px 22px; align-items: baseline; margin-top: 18px; }
  .speaking-warm .sp-decks > span { color: var(--muted); font-size: .98rem; }

  .speaking-warm .sp-grid2 { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 24px; }
  .speaking-warm .sp-card { padding: clamp(24px, 2.6vw, 32px); border-radius: 30px; background: var(--white); box-shadow: var(--shadow-sm); }
  .speaking-warm .sp-engagement h3 { margin-top: 6px; font-size: 1.4rem; }
  .speaking-warm .sp-engagement h3 span { color: var(--muted); font-weight: 400; }
  .speaking-warm .sp-format { display: inline-block; margin-top: 12px; padding: 6px 14px; border-radius: 999px; background: var(--bubble); color: var(--leaf-text); font-weight: 700; font-size: .95rem; }
  .speaking-warm .sp-eng-dl { margin: 20px 0 0; display: grid; gap: 16px; }
  .speaking-warm .sp-eng-dl dt { font-weight: 700; font-size: .98rem; color: var(--leaf-text); margin-bottom: 4px; }
  .speaking-warm .sp-eng-dl dd { margin: 0; color: var(--muted); font-size: 1.04rem; line-height: 1.8; }
  .speaking-warm .sp-session-tags { display: flex; flex-wrap: wrap; gap: 8px; }
  .speaking-warm .sp-session-tags span { padding: 5px 12px; border-radius: 999px; border: 1.5px solid var(--rule); color: var(--ink); font-size: .95rem; }
  .speaking-warm .sp-outline { display: grid; gap: 8px; }
  .speaking-warm .sp-outline li { display: flex; gap: 12px; color: var(--muted); }
  .speaking-warm .sp-outline li span { flex: none; font-weight: 700; color: var(--persimmon-text); }
  .speaking-warm .sp-takeaway { color: var(--ink) !important; }
  .speaking-warm .sp-days { display: flex; flex-wrap: wrap; align-items: baseline; gap: 8px 16px; margin-top: 18px; }
  .speaking-warm .sp-days > span { color: var(--muted); font-size: .95rem; }
  .speaking-warm .sp-day-flat { color: var(--muted); }

  .speaking-warm .sp-principle { position: relative; }
  .speaking-warm .sp-pnum { position: relative; display: grid; place-items: center; width: 56px; height: 56px; margin-bottom: 14px; font: 700 1.3rem/1 var(--f-hand); color: var(--persimmon-text); }
  .speaking-warm .sp-pnum svg { position: absolute; inset: 0; width: 100%; height: 100%; color: var(--persimmon); stroke-width: 2.4; fill: none; }
  .speaking-warm .sp-principle h3 { font-size: 1.3rem; }
  .speaking-warm .sp-principle p { margin: 10px 0 16px; color: var(--muted); font-size: 1.04rem; line-height: 1.85; }

  .speaking-warm .sp-cta-actions { display: flex; flex-wrap: wrap; align-items: center; justify-content: center; gap: 16px 28px; margin-top: clamp(32px, 4vw, 44px); }

  @media (max-width: 900px) {
    .speaking-warm .sp-stats { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .speaking-warm .sp-lecture-head { grid-template-columns: 1fr; }
    .speaking-warm .sp-grid2 { grid-template-columns: 1fr; max-width: 640px; margin-inline: auto; }
  }
  @media (max-width: 560px) {
    .speaking-warm .sp-shots { grid-template-columns: 1fr; }
    .speaking-warm .sp-shot img { min-height: 0; }
  }
</style>
