---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hl from '../components/home/Hl.astro';
import { getCollection } from 'astro:content';
import { SITE_URL, absoluteUrl, breadcrumbJsonLd } from '../lib/seo';

const days = await getCollection('days');
const total = days.length;
const searchTitle = 'AI 工作流文章搜尋';
const searchDescription = `從 ${total} 篇 Dawson Wang 的 AI 工具落地日誌中，用關鍵字或語意搜尋 Claude Code、MCP、automation、內容流程與團隊導入案例。`;
const searchUrl = absoluteUrl('/search');
const searchResultsPageJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'SearchResultsPage',
  '@id': `${SITE_URL}/search#searchresultspage`,
  name: searchTitle,
  description: searchDescription,
  url: searchUrl,
  inLanguage: 'zh-Hant-TW',
  isPartOf: { '@id': `${SITE_URL}/#website` },
  about: { '@id': `${SITE_URL}/#person` },
  breadcrumb: { '@id': `${searchUrl}#breadcrumb` },
  potentialAction: {
    '@type': 'SearchAction',
    target: `${SITE_URL}/search?q={search_term_string}`,
    'query-input': 'required name=search_term_string',
  },
};
const searchBreadcrumbJsonLd = breadcrumbJsonLd([
  { name: 'Home', url: '/' },
  { name: 'Search', url: '/search' },
], searchUrl);
---
<BaseLayout title={searchTitle} description={searchDescription} structuredData={[searchResultsPageJsonLd, searchBreadcrumbJsonLd]}>
  <div data-pagefind-ignore="all">
    <section class="page-hero" aria-labelledby="search-title">
      <div class="wrap">
        <p class="kicker"><svg class="icon" aria-hidden="true"><use href="#i-chat-q"/></svg>搜尋 · {total} 篇</p>
        <h1 id="search-title">在<Hl>日誌</Hl>裡找東西。</h1>
        <p class="hero-sub">用你自己的話描述想解決的事，或直接打關鍵字。</p>
      </div>
    </section>

    <section class="sec-sm search-sec" aria-label="搜尋">
      <div class="wrap search-wrap">
        <form id="search-form" class="form-card search-card" autocomplete="off">
          <div class="field">
            <label for="q">想找什麼？</label>
            <input
              id="q"
              name="q"
              type="search"
              placeholder="例如：自動化、創業心法、prompt 設計…"
              aria-describedby="search-mode-hint"
              autofocus
            />
          </div>

          <fieldset class="chips-field">
            <legend>搜尋方式</legend>
            <div class="chips">
              <label class="chip">
                <input type="radio" name="mode" value="keyword" checked />
                <span>關鍵字</span>
              </label>
              <label class="chip">
                <input type="radio" name="mode" value="semantic" />
                <span>語意</span>
              </label>
            </div>
            <p id="search-mode-hint" class="hint">關鍵字搜尋本站索引；語意搜尋會比對意思相近的文章（第一次約 1 秒）。</p>
          </fieldset>
        </form>

        <div class="search-bar">
          <p id="search-status" class="search-status" aria-live="polite"></p>
          <button id="share-link" type="button" class="btn btn-soft btn-sm" disabled>複製搜尋連結</button>
        </div>

        <section id="search-results" class="post-list" aria-label="搜尋結果"></section>
      </div>
    </section>
  </div>

  <script>
    import { loadPagefind } from '../lib/keyword-search-client';
    import { semanticSearch, warmUpSemantic, type SemanticHit } from '../lib/semantic-search-client';
    import {
      buildSearchUrl,
      parseSearchParams,
      DEFAULT_SEARCH_MODE,
      type SearchMode,
    } from '../lib/search-params';

    const form = document.getElementById('search-form') as HTMLFormElement;
    const input = document.getElementById('q') as HTMLInputElement;
    const statusEl = document.getElementById('search-status') as HTMLDivElement;
    const resultsEl = document.getElementById('search-results') as HTMLDivElement;
    const shareBtn = document.getElementById('share-link') as HTMLButtonElement;
    const modeRadios = form.querySelectorAll<HTMLInputElement>('input[name="mode"]');

    function getMode(): SearchMode {
      const checked = form.querySelector<HTMLInputElement>('input[name="mode"]:checked');
      return (checked?.value as SearchMode) ?? DEFAULT_SEARCH_MODE;
    }

    function setMode(mode: SearchMode) {
      modeRadios.forEach(r => { r.checked = r.value === mode; });
    }

    function setStatus(text: string) {
      statusEl.textContent = text;
    }

    function escapeHtml(s: string): string {
      return s
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;');
    }

    function renderEmpty(msg = '尚無結果') {
      resultsEl.innerHTML = `<p class="post-empty">${escapeHtml(msg)}</p>`;
    }

    function renderResults(rows: Array<{ day: number; subtitle: string; excerpt?: string; meta?: string; href?: string; num?: string }>) {
      if (!rows.length) return renderEmpty();
      const html = rows
        .map(r => {
          const excerpt = r.excerpt
            ? `<span class="post-excerpt">${r.excerpt}</span>`
            : '';
          const meta = r.meta
            ? `<span class="post-tags"><span class="tag tag-teal">${escapeHtml(r.meta)}</span></span>`
            : '';
          return `<a href="${escapeHtml(r.href ?? `/day/${r.day}`)}" class="post-row">
            <span class="post-num">${escapeHtml(r.num ?? String(r.day).padStart(3, '0'))}</span>
            <span class="post-title">${escapeHtml(r.subtitle || '')}${excerpt}</span>
            ${meta}
          </a>`;
        })
        .join('');
      resultsEl.innerHTML = html;
    }

    // ---------- pagefind (keyword) ----------
    async function runKeyword(q: string) {
      setStatus('搜尋中…');
      try {
        const pf = await loadPagefind();
        const search = await pf.search(q);
        const top = await Promise.all(search.results.slice(0, 15).map((r: any) => r.data()));
        const rows = top.map(d => {
          const day = parseInt(d.meta?.day ?? '0', 10);
          const isDay = Number.isFinite(day) && day > 0;
          const subtitle = (d.meta?.title || '').replace(/\s*\|\s*Dawson Wang.*$/, '');
          return {
            day,
            subtitle,
            excerpt: d.excerpt as string,
            href: isDay ? undefined : d.url,
            num: isDay ? undefined : '§',
          };
        });
        renderResults(rows);
        setStatus(`找到 ${search.results.length} 篇相關文章 · 關鍵字`);
      } catch (err: any) {
        renderEmpty(err?.message ?? '搜尋失敗');
        setStatus('');
      }
    }

    // ---------- semantic ----------
    let semanticWarmed = false;
    async function ensureSemantic() {
      if (semanticWarmed) return;
      setStatus('正在載入語意索引…');
      await warmUpSemantic();
      semanticWarmed = true;
    }

    async function runSemantic(q: string) {
      try {
        await ensureSemantic();
        setStatus('語意比對中…');
        const hits = await semanticSearch(q, 15);
        const rows = hits.map((h: SemanticHit) => ({
          day: h.doc.day,
          subtitle: h.doc.subtitle,
          excerpt: h.doc.snippet,
          meta: `相似度 ${(h.score * 100).toFixed(0)}%`,
        }));
        renderResults(rows);
        setStatus(`找到 ${rows.length} 篇相近文章 · 語意`);
      } catch (err: any) {
        renderEmpty(err?.message ?? '語意搜尋失敗');
        setStatus('');
      }
    }

    // ---------- shareable URL ----------
    // Keep the address bar in sync with query + mode on every keystroke and
    // mode switch, so whatever is on screen is always what gets copied.
    // Always replaceState: search-as-you-type is a filter, not a navigation,
    // and pushing per keystroke would bury the page the visitor arrived from.
    function currentState() {
      return { query: input.value.trim(), mode: getMode() };
    }

    function syncUrl() {
      // Base off the live pathname so a trailing-slash variant stays intact.
      const url = buildSearchUrl(currentState(), window.location.pathname) + window.location.hash;
      if (`${window.location.origin}${url}` === window.location.href) return;
      window.history.replaceState(null, '', url);
    }

    function refreshShareButton() {
      shareBtn.disabled = !input.value.trim();
      shareBtn.textContent = '複製搜尋連結';
    }

    shareBtn.addEventListener('click', async () => {
      const link = buildSearchUrl(
        currentState(),
        `${window.location.origin}${window.location.pathname}`,
      );
      try {
        await navigator.clipboard.writeText(link);
        shareBtn.textContent = '已複製 ✓';
      } catch {
        shareBtn.textContent = '請手動複製網址列';
      }
      window.setTimeout(refreshShareButton, 2000);
    });

    // ---------- input handling ----------
    let debounce: number | undefined;
    function schedule() {
      const q = input.value.trim();
      if (debounce) window.clearTimeout(debounce);
      syncUrl();
      refreshShareButton();
      if (!q) {
        renderEmpty('輸入查詢字以開始');
        setStatus('');
        return;
      }
      const mode = getMode();
      const delay = mode === 'semantic' ? 350 : 120;
      debounce = window.setTimeout(() => {
        if (mode === 'keyword') runKeyword(q);
        else runSemantic(q);
      }, delay);
    }

    input.addEventListener('input', schedule);
    modeRadios.forEach(r => r.addEventListener('change', schedule));
    form.addEventListener('submit', e => {
      e.preventDefault();
      schedule();
    });

    // Honor ?q= / ?keywords= plus ?mode= (or ?type=) so links from search
    // engines, the WebSite SearchAction JSON-LD, and shared URLs land directly
    // on a populated result set in the right mode.
    function applyUrlState() {
      const state = parseSearchParams(window.location.search);
      input.value = state.query;
      setMode(state.mode);
      refreshShareButton();
      if (state.query) {
        // Also rewrites ?keywords=/?type= aliases to the canonical ?q=/?mode=.
        schedule();
      } else {
        renderEmpty('輸入查詢字以開始');
        setStatus('');
      }
    }

    window.addEventListener('popstate', applyUrlState);
    applyUrlState();

    // Pre-fetch the active mode's index in the background so the first
    // search feels instant (semantic stays lazy until user picks it).
    loadPagefind().catch(() => { /* graceful in dev */ });
  </script>
</BaseLayout>

<style>
  .search-wrap { max-width: 860px; }
  .search-card { gap: 22px; }
  .search-card .chips-field legend { margin-bottom: 0; }
  .search-card .hint { margin-top: 2px; }
  .search-bar { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 12px; margin: 28px 0 16px; }
  .search-status { min-height: 1.6em; color: var(--muted); font-size: 1rem; }
  .search-bar .btn:disabled { opacity: .45; cursor: not-allowed; transform: none; }
</style>
