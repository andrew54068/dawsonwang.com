---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hl from '../components/home/Hl.astro';
import { SITE_URL, absoluteUrl, breadcrumbJsonLd } from '../lib/seo';

const pageTitle = '行號設立時間順序指引｜8 個工作天 vs 33 天實測';
const pageDescription =
  '獨資行號從送件到能開發票的完整時間線實測：名稱預查 1 天、商業登記 3 天、工商憑證 5 天、銀行開通 9 天。' +
  '政府真正在審的只有 8 個工作天，實際卻花了 33 天——中間 10 天是自己拖掉的。含每一步的規費、刻章時機與常見坑。';
const pageUrl = absoluteUrl('/business-registration');

const guideJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  '@id': `${pageUrl}#article`,
  headline: '行號設立時間順序指引：8 個工作天 vs 33 天實測',
  description: pageDescription,
  url: pageUrl,
  inLanguage: 'zh-Hant-TW',
  datePublished: '2026-09-03',
  author: { '@id': `${SITE_URL}/#person` },
  publisher: { '@id': `${SITE_URL}/#person` },
  isPartOf: { '@id': `${SITE_URL}/#website` },
  mainEntityOfPage: { '@id': pageUrl },
  breadcrumb: { '@id': `${pageUrl}#breadcrumb` },
};

const pageBreadcrumbJsonLd = breadcrumbJsonLd([
  { name: 'Home', url: '/' },
  { name: 'Business Registration', url: '/business-registration' },
], pageUrl);

const SECTIONS = [
  { id: 'flow', label: '流程' },
  { id: 'gantt', label: '實際天數' },
  { id: 'wait', label: '等多久' },
  { id: 'seals', label: '刻章' },
  { id: 'steps', label: '每步細節' },
  { id: 'clock', label: '義務時鐘' },
  { id: 'cost', label: '費用' },
  { id: 'risk', label: '風險' },
  { id: 'resources', label: '官方資源' },
];

type BarKind = 'rev' | 'self' | 'pay' | 'gap';
// Columns are calendar days, day 1 = 115/06/29. start/end are CSS grid lines on
// a 33-column track (end is exclusive), lifted from the dated approval mails.
const GANTT_ROWS: { label: string; start: number; end: number; kind: BarKind; text?: string }[] = [
  { label: '商業名稱預查', start: 1, end: 3, kind: 'rev', text: '2天' },
  { label: '刻大章 · 當晚取', start: 2, end: 3, kind: 'self' },
  { label: '簽借址租約', start: 5, end: 6, kind: 'self' },
  { label: '建物謄本', start: 8, end: 9, kind: 'self' },
  { label: '— 空窗 —', start: 9, end: 19, kind: 'gap', text: '10 天什麼都沒發生' },
  { label: '場所預查 BLBQS', start: 19, end: 24, kind: 'rev', text: '2工作天' },
  { label: '商業登記', start: 23, end: 27, kind: 'rev', text: '3工作天' },
  { label: '工商憑證（繳 420）', start: 26, end: 34, kind: 'pay', text: '5工作天' },
  { label: '稅籍設立登記', start: 29, end: 32, kind: 'rev', text: '2工作天' },
];
const GANTT_AXIS = [
  { col: 1, label: '6/29' },
  { col: 8, label: '7/6' },
  { col: 15, label: '7/13' },
  { col: 22, label: '7/20' },
  { col: 29, label: '7/27' },
  { col: 32, label: '7/31' },
];

const POST_GANTT_ROWS: { label: string; start: number; end: number; kind: BarKind; text: string }[] = [
  { label: '電子發票平台', start: 1, end: 9, kind: 'rev', text: '08/18 → 08/26 · 6 工作天' },
  { label: '銀行帳戶開通', start: 2, end: 16, kind: 'self', text: '08/19 → 09/01 · 9 工作天' },
];
const POST_GANTT_AXIS = [
  { col: 1, label: '8/18' },
  { col: 5, label: '8/22' },
  { col: 9, label: '8/26' },
  { col: 13, label: '8/30' },
  { col: 15, label: '9/1' },
];

type WaitKind = 'rev' | 'slow' | 'na';
interface WaitRow {
  name: string;
  days: string;
  width: number;
  kind: WaitKind;
  src: string;
  barText?: string;
  badge?: string;
}
const WAIT_SETUP: WaitRow[] = [
  { name: '商業名稱預查', days: '1', width: 11, kind: 'rev', src: '06/29 → 06/30 11:15' },
  { name: '場所預查 BLBQS', days: '2', width: 22, kind: 'rev', src: '07/17 14:14 → 07/21 13:56' },
  { name: '商業登記', days: '3', width: 33, kind: 'rev', src: '07/21 → 07/24', badge: '取得統編' },
  { name: '稅籍設立登記', days: '2', width: 22, kind: 'rev', src: '07/27 → 07/29 核准函' },
  { name: '工商憑證 IC 卡', days: '5', width: 56, kind: 'slow', src: '07/24 申請 → 07/27 繳費通知 → 07/31 寄出' },
  { name: '建物第二類謄本', days: '0', width: 8, kind: 'na', src: '07/06', barText: '當天' },
];
const WAIT_MONEY: WaitRow[] = [
  { name: '電子發票平台帳號', days: '6', width: 67, kind: 'rev', src: '08/18 臨櫃 → 08/26 建帳號通知' },
  { name: '銀行帳戶「開通可收款」', days: '9', width: 100, kind: 'slow', src: '08/19 申請 → 09/01 10:28 開通' },
  { name: '國稅局場勘', days: '—', width: 12, kind: 'na', src: '08/18 自己臨櫃遞件，不用預約', barText: '未發生' },
  { name: '統一發票購票證', days: '—', width: 14, kind: 'na', src: '08/18 現場問過分局 · 買紙本發票才需要', barText: '確認免領' },
];

const OFFICIAL_SITES = [
  { href: 'https://onestop.nat.gov.tw', host: 'onestop.nat.gov.tw', use: '一站式申辦（名稱預查、商業登記）' },
  { href: 'https://businesslocationinfo.gov.taipei/BLBQS', host: 'BLBQS', use: '台北市營業場所預查（限 Chrome）' },
  { href: 'https://tax.nat.gov.tw', host: 'tax.nat.gov.tw', use: '401 營業稅申報' },
  { href: 'https://www.einvoice.nat.gov.tw', host: 'einvoice.nat.gov.tw', use: '電子發票整合服務平台' },
  { href: 'https://www.etax.nat.gov.tw', host: 'etax.nat.gov.tw', use: '網路銷售登記' },
  { href: 'https://www.nhi.gov.tw', host: 'nhi.gov.tw', use: '健保投保單位' },
];
---
<BaseLayout
  title={pageTitle}
  description={pageDescription}
  structuredData={[guideJsonLd, pageBreadcrumbJsonLd]}
>
  <article class="br-warm" data-pagefind-body>

    <!-- ═══ Hero ═══ -->
    <section class="page-hero" aria-labelledby="br-hero-title">
      <div class="wrap">
        <p class="kicker load" style="--d:0"><svg class="icon" aria-hidden="true"><use href="#i-files"/></svg>實測筆記 · 獨資行號設立</p>
        <h1 id="br-hero-title" class="load" style="--d:1">獨資行號設立，<br />從送件到<Hl>能開發票</Hl>。</h1>
        <p class="hero-sub load" style="--d:2">
          這是一份獨資行號從零到能開發票的時間順序指引——隨宇科技工作室 115/06/29 – 09/01 全程實測，
          所有天數都是核准函與通知信上的日期算出來的。結論先講：機關真正在審的只有 8 個工作天，
          實際卻跨了 33 天，中間有 10 天完全是自己拖掉的。
        </p>

        <ul class="stickers" aria-label="重點數字">
          <li class="sticker load-pop" style="--d:0"><p class="num">8<small>工作天</small></p><p class="lbl">政府真正在審</p></li>
          <li class="sticker load-pop" style="--d:1"><p class="num">33<small>天</small></p><p class="lbl">實際跨度</p></li>
          <li class="sticker load-pop" style="--d:2"><p class="num">10<small>天</small></p><p class="lbl">中間完全空窗</p></li>
          <li class="sticker load-pop" style="--d:3"><p class="num">≈1,850<small>元</small></p><p class="lbl">設立總花費</p></li>
        </ul>

        <nav class="tags br-jump" aria-label="頁內導覽" data-pagefind-ignore>
          {SECTIONS.map(s => (
            <a href={`#${s.id}`} class="tag">{s.label}</a>
          ))}
        </nav>
      </div>
    </section>

    <!-- ═══ 流程圖 ═══ -->
    <section id="flow" class="sec-sm" aria-labelledby="flow-title">
      <div class="wrap">
        <div class="sec-head">
          <p class="eyebrow">順序</p>
          <h2 id="flow-title">順序長這樣</h2>
          <p class="sec-sub">箭頭＝必須等前一步完成。同一格內的事情可以同時做。</p>
          <p class="br-legend">
            <span><span class="dot-rev"></span>機關在審</span>
            <span><span class="dot-self"></span>你自己動手</span>
          </p>
        </div>

        <div class="br-flow">
          <div class="fstage">
            <div class="fwhen">D0</div>
            <div class="fbox">
              <h3><span class="dot-self"></span>決定六件事 <span class="tag tag-ochre">你自己</span></h3>
              <p>行號 or 公司 · 要不要開發票（先問客戶）· 名字 ×3 · 資本額（≤25 萬免簽證）· 地址 · 自然人憑證能不能用</p>
            </div>
          </div>
          <div class="fstage" aria-hidden="true"><div></div><div class="flow-arrow"></div></div>

          <div class="fstage">
            <div class="fwhen">D1</div>
            <div class="fbox">
              <h3><span class="dot-rev"></span>商業名稱預查 <span class="tag tag-teal">實測 1 工作天</span> <span class="tag tag-brick">150 元</span></h3>
              <p>名字沒卡下來，後面全部不能動——<b>尤其不能先刻章</b>。</p>
            </div>
          </div>
          <div class="fstage" aria-hidden="true"><div></div><div class="flow-arrow"></div></div>

          <div class="fstage">
            <div class="fwhen">D3–D8</div>
            <div class="fbox fbox-par">
              <h3><span class="dot-self"></span>三件事並行 <span class="tag tag-ochre">你自己，最容易拖</span></h3>
              <div class="fpar">
                <div class="fmini"><b>① 刻行號大章</b><span>名稱核准當天刻<br /><b>當晚就能取</b></span></div>
                <div class="fmini"><b>② 簽借址租約</b><span>要蓋大章<br />二房東要屋主同意書</span></div>
                <div class="fmini"><b>③ 建物第二類謄本</b><span>3 個月內核發<br />BLBQS 必附</span></div>
              </div>
            </div>
          </div>
          <div class="fstage" aria-hidden="true"><div></div><div class="flow-arrow"></div></div>

          <div class="fstage">
            <div class="fwhen">D19</div>
            <div class="fbox">
              <h3><span class="dot-rev"></span>營業場所預查 BLBQS <span class="tag tag-teal">實測 2 工作天</span> <span class="tag">免費</span></h3>
              <p>台北市強制、限 Chrome。系統寫「預定結案 11 天後」，實際 2 天就過。</p>
            </div>
          </div>
          <div class="fstage" aria-hidden="true"><div></div><div class="flow-arrow"></div></div>

          <div class="fstage">
            <div class="fwhen">D23</div>
            <div class="fbox">
              <h3><span class="dot-rev"></span>商業登記 <span class="tag tag-teal">實測 3 工作天</span> <span class="tag tag-brick">800 元</span></h3>
              <p>核准當下<b>拿到統一編號</b>。記得勾「併案申請工商憑證」。</p>
            </div>
          </div>
          <div class="fstage" aria-hidden="true"><div></div><div class="flow-arrow"></div></div>

          <div class="fstage">
            <div class="fwhen">D26–33</div>
            <div class="fbox fbox-par">
              <h3><span class="dot-rev"></span>兩件事並行</h3>
              <div class="fpar">
                <div class="fmini"><b>工商憑證 IC 卡</b><span>繳 420 → 5 工作天<br />掛號寄登記地址</span></div>
                <div class="fmini"><b>稅籍設立登記</b><span>實測 2 工作天<br />核定使用統一發票</span></div>
              </div>
            </div>
          </div>
          <div class="fstage" aria-hidden="true"><div></div><div class="flow-arrow"></div></div>

          <div class="fstage">
            <div class="fwhen">核准後</div>
            <div class="fbox">
              <h3><span class="dot-self"></span>刻發票章 → 領購票證 <span class="tag">走電子發票就都不用</span></h3>
              <p><b>購票證＝買紙本發票的憑證，純電子發票戶免領（已向分局當面確認）。</b>發票章只在客戶要求實體章時才刻。</p>
            </div>
          </div>
          <div class="fstage" aria-hidden="true"><div></div><div class="flow-arrow"></div></div>

          <div class="fstage">
            <div class="fwhen">+2 週</div>
            <div class="fbox fbox-par">
              <h3><span class="dot-rev"></span>能收錢、能開票的最後兩關</h3>
              <div class="fpar">
                <div class="fmini"><b>銀行行號帳戶</b><span>當天給帳號<br /><b>9 工作天才開通</b></span></div>
                <div class="fmini"><b>電子發票平台</b><span>6 工作天<br />OTP 只有 7 天效期</span></div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ═══ 甘特圖 ═══ -->
    <section id="gantt" class="band" aria-labelledby="gantt-title">
      <div class="wrap">
        <div class="sec-head">
          <p class="eyebrow">實際時程</p>
          <h2 id="gantt-title">33 天實際是這樣花掉的</h2>
          <p class="sec-sub">每一格是一個日曆天，115/06/29 起算。實心條＝有事在發生，斜線＝完全沒動。</p>
        </div>

        <div class="card">
          <div class="gscroll">
            <div class="gchart">
              {GANTT_ROWS.map(row => (
                <div class="grow">
                  <span class="glab">{row.label}</span>
                  <div class="gtrack">
                    <i class={`gbar gbar-${row.kind}`} style={`grid-column:${row.start}/${row.end}`}>{row.text ?? ''}</i>
                  </div>
                </div>
              ))}
              <div class="grow">
                <span class="glab"></span>
                <div class="gaxis">
                  {GANTT_AXIS.map(tick => (
                    <i style={`grid-column:${tick.col}`}>{tick.label}</i>
                  ))}
                </div>
              </div>
            </div>
          </div>

          <div class="glegend">
            <span><i class="lgd lgd-rev"></i>機關審核 8 工作天</span>
            <span><i class="lgd lgd-self"></i>你自己動手</span>
            <span><i class="lgd lgd-pay"></i>要繳費才動</span>
            <span><i class="lgd lgd-gap"></i>空窗</span>
          </div>

          <div class="box-ok">
            <b>看懂這張圖只要一句話：政府審件很快，時間都花在送件之間的空檔。</b>
            中間那條斜線是 7/7–7/16 的十天——謄本都拿到了，卻遲遲沒送 BLBQS。<b>那十天完全是空窗，沒有任何一關在進行。</b>
          </div>

          <div class="gpost">
            <h3>33 天之後，還有兩個真正瓶頸</h3>
            <p class="br-note">
              上圖是「設立登記本體」的 33 天；下面兩條才是「能開票、能收錢」的最後關卡。
              電子發票 6 個工作天，銀行帳戶 9 個工作天，而且銀行這條比任何政府審件都久。
            </p>
            <div class="gscroll">
              <div class="gchart gchart-post">
                {POST_GANTT_ROWS.map(row => (
                  <div class="grow">
                    <span class="glab">{row.label}</span>
                    <div class="gtrack gtrack-post">
                      <i class={`gbar gbar-${row.kind}`} style={`grid-column:${row.start}/${row.end}`}>{row.text}</i>
                    </div>
                  </div>
                ))}
                <div class="grow">
                  <span class="glab"></span>
                  <div class="gaxis gaxis-post">
                    {POST_GANTT_AXIS.map(tick => (
                      <i style={`grid-column:${tick.col}`}>{tick.label}</i>
                    ))}
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ═══ 等多久 ═══ -->
    <section id="wait" class="sec-sm" aria-labelledby="wait-title">
      <div class="wrap">
        <div class="sec-head">
          <p class="eyebrow">等待時間</p>
          <h2 id="wait-title">每一關要等多久</h2>
          <p class="sec-sub">2026 年 7–8 月台北市的單一樣本。長條＝工作天。</p>
        </div>

        <div class="card-grid">
          <div class="card">
            <h3 class="br-card-title">設立流程</h3>
            {WAIT_SETUP.map(row => (
              <div class="wrow">
                <div class="wmain">
                  <div class="wname">
                    {row.name}
                    {row.badge && <span class="tag tag-teal">{row.badge}</span>}
                  </div>
                  <div class={`wbar wbar-${row.kind}`} style={`width:${row.width}%`}>{row.barText ?? row.days}</div>
                  <div class="wsrc">{row.src}</div>
                </div>
                <div class={`wdays wdays-${row.kind}`}>{row.days === '0' ? '0' : row.days}</div>
              </div>
            ))}
          </div>

          <div class="card">
            <h3 class="br-card-title">能收錢／能開票之前</h3>
            {WAIT_MONEY.map(row => (
              <div class="wrow">
                <div class="wmain">
                  <div class="wname">{row.name}</div>
                  <div class={`wbar wbar-${row.kind}`} style={`width:${row.width}%`}>{row.barText ?? row.days}</div>
                  <div class="wsrc">{row.src}</div>
                </div>
                <div class={`wdays wdays-${row.kind}`}>{row.days}</div>
              </div>
            ))}
            <div class="box-warn">
              <b>這兩條才是真正的瓶頸。</b>
              銀行 9 天、電子發票 6 天，兩件都不在一般「設立教學」裡，卻決定你哪一天能收到第一筆錢。
              <b>從要收錢的日子往回推兩週。</b>
            </div>
          </div>
        </div>

        <div class="br-pair">
          <div class="card">
            <p class="br-pair-num rev">8</p>
            <p class="br-pair-lbl">個工作天　機關真正在審<br /><span>1＋2＋3＋2</span></p>
          </div>
          <div class="card">
            <p class="br-pair-num slow">33</p>
            <p class="br-pair-lbl">天　實際跨度<br /><span>115/06/29 → 115/07/31</span></p>
          </div>
        </div>
      </div>
    </section>

    <!-- ═══ 刻章 ═══ -->
    <section id="seals" class="band" aria-labelledby="seals-title">
      <div class="wrap">
        <div class="sec-head">
          <p class="eyebrow">印章</p>
          <h2 id="seals-title">三顆章，但你可能只要刻一顆</h2>
          <p class="sec-sub">最常被漏掉、也最常被過度準備的一步。</p>
        </div>

        <div class="card">
          <div class="seals">
            <div class="seal">
              <div class="seal-sq seal-sq-big">大章<br />公司章</div>
              <b>行號大章</b>
              <span>方型，刊商業名稱</span>
              <em class="seal-tm seal-tm-ok">名稱核准當天刻 · 當晚取</em>
            </div>
            <div class="seal">
              <div class="seal-sq seal-sq-small">小章</div>
              <b>負責人小章</b>
              <span>就是你的私章</span>
              <em class="seal-tm">本案沒刻 · 沿用既有的</em>
            </div>
            <div class="seal">
              <div class="seal-sq seal-sq-rect">統一發票<br />專用章<br />4.0×3.5</div>
              <b>統一發票專用章</b>
              <span>規格法定，要載統編</span>
              <em class="seal-tm seal-tm-warn">看客戶要不要 · 3 天 · 230 元</em>
            </div>
          </div>

          <div class="box-ok">
            <b>大章當天就能拿。</b>本案 06/30 名稱預查一核准就去刻，<b>當天晚上取件</b>——這步幾乎不佔時間。
            負責人小章通常<b>用你原本的私章就好</b>，不用另外刻。
          </div>

          <div class="box-warn">
            <b>統一發票專用章不是每個人都要刻。</b>
            走純電子發票、客戶也接受電子發票 → <b>可以不刻</b>。
            本案會刻，是因為<b>客戶建檔要求提供實體章</b>。
            實測：08/15（六）送刻 → <b>08/18（二）才能取，230 元</b>，跨了一個週末。
            比大章慢得多（規格法定、統編要排版），<b>要刻就別等到最後一刻</b>。
          </div>

          <details class="step-details">
            <summary>規格與時機的細節</summary>
            <div class="body">
              <ul>
                <li><b>不要在名稱預查核准前刻。</b>名字被駁回就整組作廢。</li>
                <li><b>大小章在簽借址租約時要蓋</b>，所以必須在簽約前備妥。本案 06/30 刻大章 → 07/03 租約生效。</li>
                <li><b>發票章依法要刊統一編號</b>，而統編要到商業登記核准才拿得到——提早刻等於刻廢。</li>
                <li><b>發票章法定規格</b>：長 <b>4.0 公分</b> × 寬 <b>3.5 公分</b>，須刊「營業人名稱、統一編號（<b>標準 5 號黑體字之阿拉伯數字</b>）、地址、統一發票專用章」字樣。刻錯要重刻。</li>
                <li>核准函要求「文到 15 日內攜<b>統一發票專用章</b>、身分證、印章辦領用購票證」——若不刻章、走純電子發票，這步要先跟承辦人確認怎麼處理。</li>
              </ul>
            </div>
          </details>
        </div>
      </div>
    </section>

    <!-- ═══ 每步細節 ═══ -->
    <section id="steps" class="sec-sm" aria-labelledby="steps-title">
      <div class="wrap">
        <div class="sec-head">
          <p class="eyebrow">步驟細節</p>
          <h2 id="steps-title">每一步的細節</h2>
          <p class="sec-sub">卡片是重點，展開才是細節。不想看就別展開。</p>
        </div>

        <div class="br-steps">

          <div class="st">
            <h3><span class="step-n">1</span>商業名稱預查</h3>
            <p class="lead-sm">線上送，隔天就過。名字只在同縣市內不得重複。</p>
            <div class="strow"><span class="tag tag-teal">1 工作天</span><span class="tag tag-brick">150 元</span></div>
            <details class="step-details">
              <summary>細節</summary>
              <div class="body">
                <p>備 3 個名字＋負責人身分證字號。不能有「公司」「有限」字樣。核准後<b>保留 2 個月</b>。</p>
                <p><b>實測：</b>115/06/29（一）線上送件 → 06/30（二）11:15 收到核准信。</p>
                <p>核定書與電子收據要自己到一站式系統「案件資料查詢 → 列印電子證明文件」下載，<b>不寄紙本</b>。</p>
              </div>
            </details>
          </div>

          <div class="st">
            <h3><span class="step-n">2</span>刻行號大章</h3>
            <p class="lead-sm">名稱核准當天就能刻，<b>當晚取</b>。小章用原本的私章就好。</p>
            <div class="strow"><span class="tag tag-teal">當天</span><span class="tag tag-brick">100–300 元</span></div>
            <details class="step-details">
              <summary>細節</summary>
              <div class="body">
                <p><b>實測：</b>115/06/30 名稱預查一核准就去刻大章，<b>當天晚上取件</b>。負責人小章本來就有，沒另外刻。</p>
                <p>大章在<b>簽借址租約時要蓋</b>，所以必須在簽約前備妥（本案 07/03 租約生效）。</p>
                <p>發票章<b>先別刻</b>——要等統編，而且不一定需要。見上方「刻章」章節。</p>
              </div>
            </details>
          </div>

          <div class="st">
            <h3><span class="step-n">3</span>簽借址登記租約</h3>
            <p class="lead-sm">要蓋大小章。二房東結構要多拿一份屋主同意書。</p>
            <div class="strow"><span class="tag tag-ochre">你自己</span><span class="tag tag-brick">行情約 1,500–3,000／月</span></div>
            <details class="step-details">
              <summary>簽約前一定要問的四件事</summary>
              <div class="body">
                <ul>
                  <li><b>租約用途有沒有寫「公司登記、商業登記及營業（稅籍）登記之用」</b>？沒寫國稅局那關會卡。</li>
                  <li><b>代收掛號嗎？</b>工商憑證 IC 卡、國稅局公文都是掛號寄到登記地址。不代收＝退件。</li>
                  <li><b>配合國稅局場勘嗎？</b>借址業者通常有經驗，但要先確認。</li>
                  <li><b>約期多長？怎麼續約？</b>本案約期僅 5 個月，且續約條款是「未<b>書面</b>拒絕即自動續約」——反過來說對方寄一封信就能不續。</li>
                </ul>
                <p><b>二房東結構要備齊整條鏈：</b>屋主 → 二房東的上游租約、屋主同意書、房屋稅單、建物權狀，缺一不可。</p>
                <p>⚠ 理想順序是<b>先 BLBQS 預查再簽約</b>（查出不符合而硬登記可罰 6 萬–30 萬）。本案是先簽（7/3）才預查（7/17），賭對了。自己找的地址不要這樣賭。</p>
              </div>
            </details>
          </div>

          <div class="st">
            <h3><span class="step-n">4</span>建物第二類謄本</h3>
            <p class="lead-sm">BLBQS 的必要附件，須 3 個月內核發。</p>
            <div class="strow"><span class="tag tag-teal">當天</span><span class="tag tag-brick">20–100 元</span></div>
            <details class="step-details">
              <summary>細節</summary>
              <div class="body">
                <p>須載明門牌地址與樓層面積。借址通常要請業者提供或授權你申請。本案 115/07/06 取得。</p>
              </div>
            </details>
          </div>

          <div class="st">
            <h3><span class="step-n">5</span>營業場所預查 BLBQS</h3>
            <p class="lead-sm">台北市強制、免費、<b>限用 Chrome</b>。最該第一個送。</p>
            <div class="strow"><span class="tag tag-teal">2 工作天</span><span class="tag">免費</span></div>
            <details class="step-details">
              <summary>細節</summary>
              <div class="body">
                <p>查「這個地址＋這些營業項目」符不符合土地使用分區管制與建築管理規定。結果「符合」後<b>6 個月內</b>要完成登記。</p>
                <p><b>實測：</b>07/17（五）14:14 送 → 07/21（二）13:56 完成。系統回條寫的預定結案日是 11 天後，<b>實際早了 7 天</b>。官方預定日是最壞情況，別照它排行程、也別賭它一定會早。</p>
                <p>查進度要輸入<b>申請人名稱＋電子郵件＋身分證後四碼</b>。</p>
                <p><b>結果可能附帶使用限制（違反會罰），本案的例子：</b>僅限 1 樓、僅限辦公室型態、不得貯藏／展示／製造／批發／零售、不得貯藏機具、不得佔用騎樓。</p>
              </div>
            </details>
          </div>

          <div class="st">
            <h3><span class="step-n">6</span>送商業登記</h3>
            <p class="lead-sm">核准當下就有統編。<b>記得勾「併案申請工商憑證」。</b></p>
            <div class="strow"><span class="tag tag-teal">3 工作天</span><span class="tag tag-brick">800 元</span></div>
            <details class="step-details">
              <summary>25 頁附件清單（二房東借址）</summary>
              <div class="body">
                <p>規費 1,000，<b>網路傳輸減徵二成 → 實繳 800</b>。一站式線上申請，自然人憑證簽章。</p>
                <div class="tblwrap"><table class="tbl"><tbody>
                  <tr><td class="num">1–2</td><td>商業登記申請書（含負責人印章）</td></tr>
                  <tr><td class="num">3</td><td>當年度房屋稅單</td></tr>
                  <tr><td class="num">4–5</td><td>建物所有權狀 ×2</td></tr>
                  <tr><td class="num">6</td><td>屋主同意書</td></tr>
                  <tr><td class="num">7–8</td><td>使用執照存根＋附表</td></tr>
                  <tr><td class="num">9–13</td><td>手抄建物登記謄本</td></tr>
                  <tr><td class="num">14–15</td><td>建物登記第二類謄本</td></tr>
                  <tr><td class="num">16–19</td><td>上游租約（屋主 → 二房東）</td></tr>
                  <tr><td class="num">20–23</td><td>你的登記地址租約</td></tr>
                  <tr><td class="num">24–25</td><td>場所預查查詢表</td></tr>
                </tbody></table></div>
                <p>資本額 ≤ 25 萬 → <b>免會計師簽證、免開籌備戶</b>。本案登記 1 萬。</p>
              </div>
            </details>
          </div>

          <div class="st st-hot">
            <h3><span class="step-n">7</span>工商憑證 IC 卡</h3>
            <p class="lead-sm"><b>要繳 420 元才會製卡</b>，掛號寄到登記地址。之後<b>線上開統一發票</b>要用它。</p>
            <div class="strow"><span class="tag tag-teal">5 工作天</span><span class="tag tag-brick">420 元</span></div>
            <details class="step-details">
              <summary>時間軸與兩個坑</summary>
              <div class="body">
                <p><b>時間軸：</b>07/24 商業登記時併案申請 → <b>07/27（一）18:01 收到繳費通知信</b> → 繳費 → <b>07/31（五）08:55 製卡並掛號寄出</b>。</p>
                <p>金額 <b>NT$420</b>，用通知信裡的虛擬帳號繳（銀行匯款／ATM／WebATM 皆可，帳號因案而異）。</p>
                <p><b>坑一：不繳費就不製卡。</b>通知信寄件人是「工商憑證管理中心<b>客服信箱</b>」，很容易被當廣告忽略。</p>
                <p><b>坑二：卡是掛號紙本，寄到「登記地址」。</b>借址方不代收掛號就會被退回。</p>
                <p><b>用途：</b>代表行號行事——<b>線上開立統一發票</b>、報稅登入、線上申辦，取代自然人憑證。</p>
              </div>
            </details>
          </div>

          <div class="st">
            <h3><span class="step-n">8</span>稅籍設立登記</h3>
            <p class="lead-sm">去登記地址所屬國稅局分局。現場決定要不要用統一發票。</p>
            <div class="strow"><span class="tag tag-teal">2 工作天</span><span class="tag">免費</span></div>
            <details class="step-details">
              <summary>帶什麼、填什麼</summary>
              <div class="body">
                <p><b>帶：</b>營業登記申請書、商業登記核准函影本、身分證正本＋影本、印章、登記地址租約影本、預估月營業額（口頭）。</p>
                <p><b>台北市分轄：</b>中正・萬華 → 中正分局；大同・中山 → 中北；松山・信義 → 松山；大安・文山 → 大安；士林・北投 → 士林；內湖・南港 → 內湖。</p>
                <p>稅籍填的是 <b>6 碼稅務行業標準分類</b>，和商業登記的 I301010 是兩套不同東西。本案主營 620199（其他電腦程式設計），擴大書審純益率 8%。<b>行業代號只影響營所稅的利潤標準，不限制你能開什麼發票。</b></p>
                <p><b>實測：</b>07/27（一）申請 → 07/29（三）收到核准函。</p>
                <p>⚠ 二房東借址：本案承辦人在函文上手寫「請負責人於<b>上午</b>攜租賃契約書及房屋稅單至本分局洽辦」——核准後還要再跑一趟做設籍地址查核。</p>
              </div>
            </details>
          </div>

          <div class="st">
            <h3><span class="step-n">9</span>刻發票章 → 領購票證</h3>
            <p class="lead-sm">兩件都<b>不必要</b>。<b>電子發票平台開通就能開票</b>，購票證是買紙本才用的。</p>
            <div class="strow"><span class="tag tag-teal">已向分局確認</span><span class="tag tag-brick">章 230 元</span></div>
            <details class="step-details">
              <summary>為什麼不用領購票證（含法規依據）</summary>
              <div class="body">
                <p><b>115/08/18 臨櫃遞件時當場詢問分局行政人員，得到的答覆是：只要線上開通電子發票雲端平台帳號，就可以開發票。</b>核准函那句「文到 15 日內辦理領用購票證」對純電子發票戶不適用。</p>
                <p><b>法規邏輯對得上：</b>購票證的功能＝到代售點買空白<b>紙本</b>統一發票的憑證（申購要帶購票證＋請購單＋現金，並蓋與購票證相同的發票章與負責人章）。「購買紙本發票」與「稽徵機關配賦字軌號碼」是<b>兩種並行</b>的取得方式——走平台配賦就不經過購票證這條路。</p>
                <p>《統一發票使用辦法》§6 把購票證當持有型證件管理（名稱／統編／地址／負責人／發票專用章印鑑變更要換發，歇業繳回，遺失補發）——這些規定<b>只在你真的持有購票證時才適用</b>。</p>
                <p><b>教訓：</b>這種「公文寫了但可能不適用你」的條款，<b>臨櫃當面問一句</b>最快。不要靠推論，也不用怕麻煩承辦人。</p>
                <p><b>發票章實測：</b>08/15（六）送刻 → 08/18（二）取，230 元。刻的原因是<b>客戶建檔要實體章</b>，不是法規強制。規格法定 4.0×3.5 cm，統編須用標準 5 號黑體阿拉伯數字。</p>
              </div>
            </details>
          </div>

          <div class="st">
            <h3><span class="step-n">10</span>網路銷售登記</h3>
            <p class="lead-sm">只有「線上能直接跟你成交／收錢」才要辦。法定 15 日內。</p>
            <div class="strow"><span class="tag tag-ochre">法定 15 日</span><span class="tag tag-teal">線上當場</span></div>
            <details class="step-details">
              <summary>判準與罰則</summary>
              <div class="body">
                <p><b>有沒有金流按鈕、線上訂閱、App Store、購物車？</b>有＝要辦。純作品集網站＋email 聯絡＝不用。</p>
                <p>要登記網域名稱、網路位址、各平台會員帳號，並在銷售頁面<b>明顯處揭露統編＋營業人名稱</b>。</p>
                <p>罰則：營業稅法 §46，<b>1,500–15,000 元，得按次處罰</b>。產品上線有金流那天要回頭補辦。</p>
              </div>
            </details>
          </div>

          <div class="st st-hot">
            <h3><span class="step-n">11</span>銀行開行號帳戶</h3>
            <p class="lead-sm"><b>當天給帳號，但要 9 個工作天才開通、才能收款。</b></p>
            <div class="strow"><span class="tag tag-ochre">9 工作天</span><span class="tag">免費</span></div>
            <details class="step-details">
              <summary>時間軸與破除謠言</summary>
              <div class="body">
                <p><b>帶：</b>商業登記核准函正本、負責人身分證、負責人印章、行號大章。戶名格式 <b>「○○工作室 王大明」</b>（商號名＋負責人姓名）。</p>
                <p><b>實測（某民營銀行分行）：</b>08/19（三）臨櫃申請，當天拿到帳號但<b>未審核開通、不能收款</b>，行員說 1–2 週 → 09/01（二）10:28 收到網銀開通通知。<b>共 13 個日曆天／9 個工作天。</b></p>
                <p><b>「行號開戶門檻很高、會被刁難」是網路都市傳說。</b>本案實際去辦完全沒被刁難，純粹因為看了那些文章而拖了 26 天沒去。</p>
                <p>客戶匯款一律進行號帳戶，匯個人帳戶稅務上容易有爭議。</p>
              </div>
            </details>
          </div>

          <div class="st st-hot">
            <h3><span class="step-n">12</span>電子發票平台</h3>
            <p class="lead-sm">開第一張發票前必須完成。<b>認證碼只有 7 天效期。</b></p>
            <div class="strow"><span class="tag tag-teal">6 工作天</span><span class="tag">免費</span></div>
            <details class="step-details">
              <summary>流程與那個 7 天陷阱</summary>
              <div class="body">
                <p>兩份表：<b>電子發票字軌號碼申請書 ＋ 使用電子發票承諾書</b>。本案選項：首次申請｜B2B/B2G｜1 組字軌｜按期配號｜財政部整合服務平台｜非熱感紙｜無委任加值中心。</p>
                <p><b>實測：</b>08/18（二）13:00 自己列印申請書<b>臨櫃遞件（不用預約、當場收件）</b> → 08/26（三）05:30 收到「營業人建立帳號通知」。</p>
                <p><b>⚠ 通知信的 OTP 認證碼 7 天失效。</b>認證碼在<b>附件 PDF</b> 裡，PDF 開啟密碼＝<b>稅籍編號前 4 碼＋統一編號後 4 碼</b>。收到當天就把帳號建起來，過期要重新申請認證碼。</p>
                <p>用電子發票的好處：不用買空白發票本、開立紀錄自動保存、報 401 時系統自動帶入。</p>
              </div>
            </details>
          </div>

          <div class="st">
            <h3><span class="step-n">13</span>設置帳簿</h3>
            <p class="lead-sm">日記簿、總分類帳、營運量紀錄簿，使用前逐頁編號。</p>
            <div class="strow"><span class="tag tag-ochre">自己做</span></div>
            <details class="step-details">
              <summary>細節</summary>
              <div class="body">
                <p>核准函說明：勞務業及其他各業須設置上述帳簿及其他必要補助帳簿。現行制度應為免驗印，但當面向承辦人確認最快。</p>
                <p><b>從第一天就留存進項發票</b>——電腦、軟體訂閱、文具、交通通常可扣抵 5%，保存 5 年。</p>
              </div>
            </details>
          </div>

          <div class="st st-hot">
            <h3><span class="step-n">14</span>健保投保單位</h3>
            <p class="lead-sm"><b>健保沒有 5 人門檻</b>（那是勞保的）。負責人屬第一類第四目，原則上要以行號成立投保單位。</p>
            <div class="strow"><span class="tag tag-ochre">法定 3 日內</span><span class="tag tag-brick">淨增 ≈1,345／月</span></div>
            <details class="step-details">
              <summary>三種門檻的差別＋兩個免成立的例外＋費用試算</summary>
              <div class="body">
                <div class="tblwrap"><table class="tbl">
                  <thead><tr><th>保險</th><th>門檻</th></tr></thead>
                  <tbody>
                    <tr><td><b>勞保</b></td><td>僱用 <b>5 人以上</b>才強制；未滿 5 人可自願投保。<b>負責人非勞工，不強制</b></td></tr>
                    <tr><td><b>健保</b></td><td><b>無人數門檻。</b>雇主／自營業主屬第一類第四目，應以其事業單位為投保單位</td></tr>
                    <tr><td>就保／職災／勞退</td><td>僱用 <b>1 人</b>即強制（職災保險 111/5/1 起 1 人就要）</td></tr>
                  </tbody>
                </table></div>
                <p><b>費用試算（115 年度、投保金額下限 42,000）——若你原本掛區公所：</b></p>
                <div class="tblwrap"><table class="tbl">
                  <thead><tr><th></th><th>月費</th><th>年</th></tr></thead>
                  <tbody>
                    <tr><td>原本：第六類（區公所）</td><td class="num">≈826</td><td class="num">≈9,900</td></tr>
                    <tr><td>應該：第一類（下限 42,000）</td><td class="num">2,171</td><td class="num">26,052</td></tr>
                    <tr><td><b>淨增加</b></td><td class="num"><b>≈1,345</b></td><td class="num"><b>≈16,000</b></td></tr>
                  </tbody>
                </table></div>
                <p>規定是「合於投保條件之日起 <b>3 日內</b>」辦理，健保署有 <b>5 年追補權</b>——每拖一個月就多一個月的補繳曝險。</p>
                <p><b>兩個可以不成立投保單位的例外：</b></p>
                <ul>
                  <li><b>他處有正職受僱</b> → 依施行細則 §17 以「主要工作」身分投保（認定以實際有酬工作時間長短為準，相同再比收入）。</li>
                  <li><b>自營作業者</b> → 獨資行號 ＋ 以勞動或技藝為業 ＋ 無僱用有酬員工 ＋ <b>已參加職業工會</b>，可簽健保署「第一類投保單位負責人為自營作業者聲明書」留在第二類第一目。⚠ 工會通常勞健保綁一起收、另有會費，且「軟體開發／顧問算不算勞動或技藝」是灰色地帶——<b>先問工會收不收，再比價</b>。</li>
                </ul>
                <p><b>辦理步驟：</b>① 網路櫃檯或臨櫃成立第一類投保單位（帶負責人身分證明＋商業登記核准函）→ ② 以自營業主投保第一類第四目 → ③ <b>同時</b>附國稅局營利稅額通知單＋投保金額調整表＋調降聲明書，申請調降至下限 42,000——<b>不主動舉證，健保署有權按分級表最高一級加保</b> → ④ 區公所身分互斥自動轉出。</p>
              </div>
            </details>
          </div>

        </div>
      </div>
    </section>

    <!-- ═══ 義務時鐘 ═══ -->
    <section id="clock" class="band" aria-labelledby="clock-title">
      <div class="wrap">
        <div class="sec-head">
          <p class="eyebrow">定期義務</p>
          <h2 id="clock-title">義務時鐘</h2>
          <p class="sec-sub">不請記帳士＝這些全自己來。全部設成日曆重複提醒。</p>
        </div>

        <div class="card-grid">
          <div class="card">
            <h3 class="br-card-title">雙月 · 401 營業稅</h3>
            <div class="tblwrap"><table class="tbl">
              <thead><tr><th>期間</th><th>截止</th><th>期間</th><th>截止</th></tr></thead>
              <tbody>
                <tr><td>7–8 月</td><td class="num">9/15</td><td>1–2 月</td><td class="num">3/15</td></tr>
                <tr><td>9–10 月</td><td class="num">11/15</td><td>3–4 月</td><td class="num">5/15</td></tr>
                <tr><td>11–12 月</td><td class="num">1/15</td><td>5–6 月</td><td class="num">7/15</td></tr>
              </tbody>
            </table></div>
            <ul class="br-list">
              <li><b>不論有無銷售額都要申報</b>（營業稅法 §35），零銷售額也要辦零申報。</li>
              <li>應繳 ＝ 銷項 5% − 進項可扣抵。交易少的話 10 分鐘搞定。</li>
              <li>tax.nat.gov.tw · 疑問 0809-085-188（免費）</li>
            </ul>
          </div>

          <div class="card">
            <h3 class="br-card-title">年度／平時</h3>
            <div class="tblwrap"><table class="tbl"><tbody>
              <tr><td class="num">5/1–5/31</td><td>營所稅結算申報（免繳稅款仍須申報）＋併綜所稅</td></tr>
              <tr><td class="num">每年 1 月</td><td>若登記地址是向「個人」承租：租金扣繳憑單申報（向公司承租通常是對方開發票、不扣繳，拿不準就問國稅局）</td></tr>
              <tr><td class="num">平時</td><td>記帳；<b>進項發票留存 5 年</b></td></tr>
            </tbody></table></div>
            <div class="box-warn">
              <b>自己報稅的真正成本是「記得」。</b>漏報一次的罰鍰就吃掉好幾個月省下的記帳費。
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ═══ 費用 ═══ -->
    <section id="cost" class="sec-sm" aria-labelledby="cost-title">
      <div class="wrap">
        <div class="sec-head">
          <p class="eyebrow">費用</p>
          <h2 id="cost-title">費用</h2>
        </div>

        <div class="card-grid">
          <div class="card">
            <h3 class="br-card-title">設立一次性</h3>
            <div class="tblwrap"><table class="tbl"><tbody>
              <tr><td>商業名稱預查</td><td class="num">150</td></tr>
              <tr><td>營業場所預查 BLBQS</td><td class="num">0</td></tr>
              <tr><td>建物第二類謄本</td><td class="num">20–100</td></tr>
              <tr><td>商業登記規費（減徵後）</td><td class="num">800</td></tr>
              <tr><td><b>工商憑證 IC 卡</b></td><td class="num"><b>420</b></td></tr>
              <tr><td>行號大章</td><td class="num">100–300</td></tr>
              <tr><td>負責人小章（沿用既有私章）</td><td class="num">0</td></tr>
              <tr><td>統一發票專用章（客戶接受電子發票可省）</td><td class="num">230</td></tr>
              <tr><td>會計師資本簽證（資本額 ≤ 25 萬免）</td><td class="num">0</td></tr>
              <tr><td>稅籍登記／銀行開戶</td><td class="num">0</td></tr>
              <tr><td><b>合計</b></td><td class="num"><b>≈ 1,720–2,000</b></td></tr>
            </tbody></table></div>
            <div class="box-ok">
              規費 800 vs 1,000 不是筆誤：設立登記 1,000 元，<b>網路傳輸減徵二成</b> → 實繳 800。
            </div>
          </div>

          <div class="card">
            <h3 class="br-card-title">週期性</h3>
            <div class="tblwrap"><table class="tbl">
              <thead><tr><th>項目</th><th>金額</th><th>頻率</th></tr></thead>
              <tbody>
                <tr><td>借址登記月租（行情）</td><td class="num">1,500–3,000</td><td>每月</td></tr>
                <tr><td><b>負責人健保</b>（若須成立投保單位）</td><td class="num"><b>≈2,171</b></td><td>每月</td></tr>
                <tr><td>記帳士／會計師</td><td class="num">0</td><td>自己報</td></tr>
                <tr><td>營業稅</td><td class="num">銷項 5%−進項</td><td>雙月</td></tr>
              </tbody>
            </table></div>
            <div class="box-warn">
              <b>健保是最大的隱藏固定成本。</b>下限投保金額 42,000（115 年度、未滿 5 人），
              月費約 2,171 ≈ <b>年 26,000</b>，比借址月租還貴。除非你符合「他處受僱」或「職業工會＋自營作業者聲明書」的例外。
            </div>
            <p class="br-note">
              對照全委外：代辦設立 +3,000～8,000、記帳士 +1,500～2,500／月 → 自辦一年省 <b>NT$25,000–40,000</b>。
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- ═══ 風險 ═══ -->
    <section id="risk" class="band" aria-labelledby="risk-title">
      <div class="wrap">
        <div class="sec-head">
          <p class="eyebrow">風險</p>
          <h2 id="risk-title">風險與常見坑</h2>
        </div>

        <div class="card-grid">
          <div class="card br-span2">
            <h3 class="br-card-title">① 登記地址租約 <span class="tag tag-ochre">最大單點</span></h3>
            <pre class="chain">屋主
  └─同意書─▶ 二房東（借址業者）
        └─轉租─▶ 你的行號</pre>
            <ul class="br-list">
              <li>登記地址被<b>商業登記＋稅籍雙綁定</b>，租約一斷兩邊都要跟著變更。</li>
              <li>「未<b>書面</b>拒絕即自動續約」＝對方寄一封信就能不續（本案約期僅 5 個月）。到期前主動要一份<b>書面續約確認</b>，別賭自動續約條款。</li>
              <li>二房東多一層：<b>上游租約終止，你的地址連帶失效</b>。</li>
              <li>場所預查的結果可能附使用限制（僅限樓層、僅限辦公室型態、不得貯藏／展示／零售），違反會罰。</li>
            </ul>
          </div>

          <div class="card">
            <h3 class="br-card-title">② 營業項目的邊界</h3>
            <ul class="br-list">
              <li>企業內訓／顧問／講座 → <b>I103060 管理顧問業</b>涵蓋，可直接開發票。</li>
              <li>一般演講、工作坊 → <b>ZZ99999</b> 概括涵蓋。</li>
              <li>⚠ <b>短期補習班型態</b>（固定招生、系統性授課）屬<b>特許業務</b>，須向教育局立案，加代碼也不行。</li>
            </ul>
          </div>

          <div class="card">
            <h3 class="br-card-title">③ 退場：暫停 vs 歇業 <span class="tag tag-teal">都免費</span></h3>
            <ul class="br-list">
              <li><b>停業</b>：每次最長 1 年可延展，連續最多 2 年。停申報義務、統編保留。健保要另找投保單位。</li>
              <li><b>歇業</b>：開完所有發票 → 申報完當期營業稅＋營所稅結算 → 繳回購票證與空白發票 → 註銷稅籍。約 3–5 工作天。</li>
              <li>⚠ 核准函明定：<b>原址已無營業事實時，15 日內</b>須申請變更或註銷稅籍。</li>
            </ul>
          </div>
        </div>
      </div>
    </section>

