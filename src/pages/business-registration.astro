---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE_URL, absoluteUrl, breadcrumbJsonLd } from '../lib/seo';

const pageTitle = '行號設立時間順序指引｜8 個工作天 vs 33 天實測';
const pageDescription =
  '獨資行號從送件到能開發票的完整時間線實測：名稱預查 1 天、商業登記 3 天、工商憑證 5 天、銀行開通 9 天。' +
  '政府真正在審的只有 8 個工作天，實際卻花了 33 天——中間 10 天是自己拖掉的。含每一步的規費、刻章時機與常見坑。';
const pageUrl = absoluteUrl('/business-registration');

const guideJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  '@id': `${pageUrl}#article`,
  headline: '行號設立時間順序指引：8 個工作天 vs 33 天實測',
  description: pageDescription,
  url: pageUrl,
  inLanguage: 'zh-Hant-TW',
  datePublished: '2026-09-03',
  author: { '@id': `${SITE_URL}/#person` },
  publisher: { '@id': `${SITE_URL}/#person` },
  isPartOf: { '@id': `${SITE_URL}/#website` },
  mainEntityOfPage: { '@id': pageUrl },
  breadcrumb: { '@id': `${pageUrl}#breadcrumb` },
};

const pageBreadcrumbJsonLd = breadcrumbJsonLd([
  { name: 'Home', url: '/' },
  { name: 'Business Registration', url: '/business-registration' },
], pageUrl);

const SECTIONS = [
  { id: 'flow', label: '流程' },
  { id: 'gantt', label: '實際天數' },
  { id: 'wait', label: '等多久' },
  { id: 'seals', label: '刻章' },
  { id: 'steps', label: '每步細節' },
  { id: 'clock', label: '義務時鐘' },
  { id: 'cost', label: '費用' },
  { id: 'risk', label: '風險' },
  { id: 'resources', label: '官方資源' },
];

type BarKind = 'rev' | 'self' | 'pay' | 'gap';
// Columns are calendar days, day 1 = 115/06/29. start/end are CSS grid lines on
// a 33-column track (end is exclusive), lifted from the dated approval mails.
const GANTT_ROWS: { label: string; start: number; end: number; kind: BarKind; text?: string }[] = [
  { label: '商業名稱預查', start: 1, end: 3, kind: 'rev', text: '2天' },
  { label: '刻大章 · 當晚取', start: 2, end: 3, kind: 'self' },
  { label: '簽借址租約', start: 5, end: 6, kind: 'self' },
  { label: '建物謄本', start: 8, end: 9, kind: 'self' },
  { label: '— 空窗 —', start: 9, end: 19, kind: 'gap', text: '10 天什麼都沒發生' },
  { label: '場所預查 BLBQS', start: 19, end: 24, kind: 'rev', text: '2工作天' },
  { label: '商業登記', start: 23, end: 27, kind: 'rev', text: '3工作天' },
  { label: '工商憑證（繳 420）', start: 26, end: 34, kind: 'pay', text: '5工作天' },
  { label: '稅籍設立登記', start: 29, end: 32, kind: 'rev', text: '2工作天' },
];
const GANTT_AXIS = [
  { col: 1, label: '6/29' },
  { col: 8, label: '7/6' },
  { col: 15, label: '7/13' },
  { col: 22, label: '7/20' },
  { col: 29, label: '7/27' },
  { col: 32, label: '7/31' },
];

const POST_GANTT_ROWS: { label: string; start: number; end: number; kind: BarKind; text: string }[] = [
  { label: '電子發票平台', start: 1, end: 9, kind: 'rev', text: '08/18 → 08/26 · 6 工作天' },
  { label: '銀行帳戶開通', start: 2, end: 16, kind: 'self', text: '08/19 → 09/01 · 9 工作天' },
];
const POST_GANTT_AXIS = [
  { col: 1, label: '8/18' },
  { col: 5, label: '8/22' },
  { col: 9, label: '8/26' },
  { col: 13, label: '8/30' },
  { col: 15, label: '9/1' },
];

type WaitKind = 'rev' | 'slow' | 'na';
interface WaitRow {
  name: string;
  days: string;
  width: number;
  kind: WaitKind;
  src: string;
  barText?: string;
  badge?: string;
}
const WAIT_SETUP: WaitRow[] = [
  { name: '商業名稱預查', days: '1', width: 11, kind: 'rev', src: '06/29 → 06/30 11:15' },
  { name: '場所預查 BLBQS', days: '2', width: 22, kind: 'rev', src: '07/17 14:14 → 07/21 13:56' },
  { name: '商業登記', days: '3', width: 33, kind: 'rev', src: '07/21 → 07/24', badge: '取得統編' },
  { name: '稅籍設立登記', days: '2', width: 22, kind: 'rev', src: '07/27 → 07/29 核准函' },
  { name: '工商憑證 IC 卡', days: '5', width: 56, kind: 'slow', src: '07/24 申請 → 07/27 繳費通知 → 07/31 寄出' },
  { name: '建物第二類謄本', days: '0', width: 8, kind: 'na', src: '07/06', barText: '當天' },
];
const WAIT_MONEY: WaitRow[] = [
  { name: '電子發票平台帳號', days: '6', width: 67, kind: 'rev', src: '08/18 臨櫃 → 08/26 建帳號通知' },
  { name: '銀行帳戶「開通可收款」', days: '9', width: 100, kind: 'slow', src: '08/19 申請 → 09/01 10:28 開通' },
  { name: '國稅局場勘', days: '—', width: 12, kind: 'na', src: '08/18 自己臨櫃遞件，不用預約', barText: '未發生' },
  { name: '統一發票購票證', days: '—', width: 14, kind: 'na', src: '08/18 現場問過分局 · 買紙本發票才需要', barText: '確認免領' },
];

const OFFICIAL_SITES = [
  { href: 'https://onestop.nat.gov.tw', host: 'onestop.nat.gov.tw', use: '一站式申辦（名稱預查、商業登記）' },
  { href: 'https://businesslocationinfo.gov.taipei/BLBQS', host: 'BLBQS', use: '台北市營業場所預查（限 Chrome）' },
  { href: 'https://tax.nat.gov.tw', host: 'tax.nat.gov.tw', use: '401 營業稅申報' },
  { href: 'https://www.einvoice.nat.gov.tw', host: 'einvoice.nat.gov.tw', use: '電子發票整合服務平台' },
  { href: 'https://www.etax.nat.gov.tw', host: 'etax.nat.gov.tw', use: '網路銷售登記' },
  { href: 'https://www.nhi.gov.tw', host: 'nhi.gov.tw', use: '健保投保單位' },
];
---
<BaseLayout
  title={pageTitle}
  description={pageDescription}
  structuredData={[guideJsonLd, pageBreadcrumbJsonLd]}
>
  <article class="max-w-5xl mx-auto px-8 py-16" data-pagefind-body>
    <div class="font-mono text-xs text-teal uppercase tracking-[.08em] mb-4">
      FIELD NOTES · SOLE PROPRIETORSHIP SETUP
    </div>
    <h1
      class="font-display text-ink leading-[1.02] tracking-[-0.03em] text-balance font-semibold"
      style="font-size: clamp(2.5rem, 5vw, 4rem);"
    >
      獨資行號設立，<br />從送件到<span class="text-teal">能開發票</span>。
    </h1>
    <p class="font-display text-muted text-lg leading-relaxed mt-4 max-w-2xl">
      這是一份獨資行號從零到能開發票的時間順序指引——隨宇科技工作室 115/06/29 – 09/01 全程實測，
      所有天數都是核准函與通知信上的日期算出來的。結論先講：機關真正在審的只有 8 個工作天，
      實際卻跨了 33 天，中間有 10 天完全是自己拖掉的。
    </p>

    <dl class="mt-10 grid grid-cols-2 sm:grid-cols-4 gap-px border border-rule rounded-xl overflow-hidden bg-rule">
      <div class="bg-surface-1 px-5 py-4">
        <dt class="font-mono text-[11px] uppercase tracking-[.08em] text-faint">政府在審的工作天</dt>
        <dd class="font-mono text-teal mt-1" style="font-size: 28px;">8</dd>
      </div>
      <div class="bg-surface-1 px-5 py-4">
        <dt class="font-mono text-[11px] uppercase tracking-[.08em] text-faint">實際跨度（天）</dt>
        <dd class="font-mono text-ink mt-1" style="font-size: 28px;">33</dd>
      </div>
      <div class="bg-surface-1 px-5 py-4">
        <dt class="font-mono text-[11px] uppercase tracking-[.08em] text-faint">中間完全空窗（天）</dt>
        <dd class="font-mono text-ochre mt-1" style="font-size: 28px;">10</dd>
      </div>
      <div class="bg-surface-1 px-5 py-4">
        <dt class="font-mono text-[11px] uppercase tracking-[.08em] text-faint">設立總花費（元）</dt>
        <dd class="font-mono text-ink mt-1" style="font-size: 28px;">≈1,850</dd>
      </div>
    </dl>

    <nav class="mt-8 flex flex-wrap gap-2" aria-label="頁內導覽" data-pagefind-ignore>
      {SECTIONS.map(s => (
        <a href={`#${s.id}`} class="chip chip-outline no-underline">{s.label}</a>
      ))}
    </nav>

    <!-- ══════ 流程圖 ══════ -->
    <section id="flow" class="mt-16 scroll-mt-20">
      <div class="font-mono text-xs text-teal uppercase tracking-[.08em] mb-3">ORDER</div>
      <h2 class="font-display text-ink font-semibold tracking-tight text-2xl mb-2">順序長這樣</h2>
      <p class="font-display text-muted text-sm leading-relaxed mb-6 max-w-2xl">
        箭頭＝必須等前一步完成。同一格內的事情可以同時做。
        <span class="inline-flex items-center gap-1.5 ml-1"><span class="dot-rev"></span>機關在審</span>
        <span class="inline-flex items-center gap-1.5 ml-2"><span class="dot-self"></span>你自己動手</span>
      </p>

      <div>
        <div class="fstage">
          <div class="fwhen">D0</div>
          <div class="fbox">
            <h3><span class="dot-self"></span>決定六件事 <span class="chip chip-ochre">你自己</span></h3>
            <p>行號 or 公司 · 要不要開發票（先問客戶）· 名字 ×3 · 資本額（≤25 萬免簽證）· 地址 · 自然人憑證能不能用</p>
          </div>
        </div>
        <div class="fstage" aria-hidden="true"><div></div><div class="flow-arrow"></div></div>

        <div class="fstage">
          <div class="fwhen">D1</div>
          <div class="fbox">
            <h3><span class="dot-rev"></span>商業名稱預查 <span class="chip chip-teal">實測 1 工作天</span> <span class="chip chip-brick">150 元</span></h3>
            <p>名字沒卡下來，後面全部不能動——<b>尤其不能先刻章</b>。</p>
          </div>
        </div>
        <div class="fstage" aria-hidden="true"><div></div><div class="flow-arrow"></div></div>

        <div class="fstage">
          <div class="fwhen">D3–D8</div>
          <div class="fbox fbox-par">
            <h3><span class="dot-self"></span>三件事並行 <span class="chip chip-ochre">你自己，最容易拖</span></h3>
            <div class="fpar">
              <div class="fmini"><b>① 刻行號大章</b><span>名稱核准當天刻<br /><b>當晚就能取</b></span></div>
              <div class="fmini"><b>② 簽借址租約</b><span>要蓋大章<br />二房東要屋主同意書</span></div>
              <div class="fmini"><b>③ 建物第二類謄本</b><span>3 個月內核發<br />BLBQS 必附</span></div>
            </div>
          </div>
        </div>
        <div class="fstage" aria-hidden="true"><div></div><div class="flow-arrow"></div></div>

        <div class="fstage">
          <div class="fwhen">D19</div>
          <div class="fbox">
            <h3><span class="dot-rev"></span>營業場所預查 BLBQS <span class="chip chip-teal">實測 2 工作天</span> <span class="chip chip-outline">免費</span></h3>
            <p>台北市強制、限 Chrome。系統寫「預定結案 11 天後」，實際 2 天就過。</p>
          </div>
        </div>
        <div class="fstage" aria-hidden="true"><div></div><div class="flow-arrow"></div></div>

        <div class="fstage">
          <div class="fwhen">D23</div>
          <div class="fbox">
            <h3><span class="dot-rev"></span>商業登記 <span class="chip chip-teal">實測 3 工作天</span> <span class="chip chip-brick">800 元</span></h3>
            <p>核准當下<b>拿到統一編號</b>。記得勾「併案申請工商憑證」。</p>
          </div>
        </div>
        <div class="fstage" aria-hidden="true"><div></div><div class="flow-arrow"></div></div>

        <div class="fstage">
          <div class="fwhen">D26–33</div>
          <div class="fbox fbox-par">
            <h3><span class="dot-rev"></span>兩件事並行</h3>
            <div class="fpar">
              <div class="fmini"><b>工商憑證 IC 卡</b><span>繳 420 → 5 工作天<br />掛號寄登記地址</span></div>
              <div class="fmini"><b>稅籍設立登記</b><span>實測 2 工作天<br />核定使用統一發票</span></div>
            </div>
          </div>
        </div>
        <div class="fstage" aria-hidden="true"><div></div><div class="flow-arrow"></div></div>

        <div class="fstage">
          <div class="fwhen">核准後</div>
          <div class="fbox">
            <h3><span class="dot-self"></span>刻發票章 → 領購票證 <span class="chip chip-outline">走電子發票就都不用</span></h3>
            <p><b>購票證＝買紙本發票的憑證，純電子發票戶免領（已向分局當面確認）。</b>發票章只在客戶要求實體章時才刻。</p>
          </div>
        </div>
        <div class="fstage" aria-hidden="true"><div></div><div class="flow-arrow"></div></div>

        <div class="fstage">
          <div class="fwhen">+2 週</div>
          <div class="fbox fbox-par">
            <h3><span class="dot-rev"></span>能收錢、能開票的最後兩關</h3>
            <div class="fpar">
              <div class="fmini"><b>銀行行號帳戶</b><span>當天給帳號<br /><b>9 工作天才開通</b></span></div>
              <div class="fmini"><b>電子發票平台</b><span>6 工作天<br />OTP 只有 7 天效期</span></div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ══════ 甘特圖 ══════ -->
    <section id="gantt" class="mt-16 scroll-mt-20">
      <div class="font-mono text-xs text-teal uppercase tracking-[.08em] mb-3">REALITY</div>
      <h2 class="font-display text-ink font-semibold tracking-tight text-2xl mb-2">33 天實際是這樣花掉的</h2>
      <p class="font-display text-muted text-sm leading-relaxed mb-6 max-w-2xl">
        每一格是一個日曆天，115/06/29 起算。實心條＝有事在發生，斜線＝完全沒動。
      </p>

      <div class="bg-surface-1 border border-rule rounded-xl p-6">
        <div class="overflow-x-auto">
          <div class="min-w-[660px]">
            {GANTT_ROWS.map(row => (
              <div class="grow">
                <span class="glab">{row.label}</span>
                <div class="gtrack">
                  <i class={`gbar gbar-${row.kind}`} style={`grid-column:${row.start}/${row.end}`}>{row.text ?? ''}</i>
                </div>
              </div>
            ))}
            <div class="grow">
              <span class="glab"></span>
              <div class="gaxis">
                {GANTT_AXIS.map(tick => (
                  <i style={`grid-column:${tick.col}`}>{tick.label}</i>
                ))}
              </div>
            </div>
          </div>
        </div>

        <div class="flex flex-wrap gap-x-5 gap-y-2 mt-5 font-display text-xs text-muted">
          <span class="inline-flex items-center gap-1.5"><i class="lgd" style="background: var(--color-teal);"></i>機關審核 8 工作天</span>
          <span class="inline-flex items-center gap-1.5"><i class="lgd" style="background: var(--color-ochre);"></i>你自己動手</span>
          <span class="inline-flex items-center gap-1.5"><i class="lgd" style="background: var(--color-brick);"></i>要繳費才動</span>
          <span class="inline-flex items-center gap-1.5"><i class="lgd lgd-gap"></i>空窗</span>
        </div>

        <div class="box-ok mt-4">
          <b>看懂這張圖只要一句話：政府審件很快，慢的是你。</b>
          中間那條斜線是 7/7–7/16 的十天——謄本都拿到了，就是沒送 BLBQS。<b>那十天是自己損失的。</b>
        </div>

        <div class="mt-8 border-t border-rule pt-6">
          <h3 class="font-display text-ink text-[15px] font-semibold mb-2">33 天之後，還有兩個真正瓶頸</h3>
          <p class="font-display text-muted text-[13px] leading-relaxed mb-4 max-w-2xl">
            上圖是「設立登記本體」的 33 天；下面兩條才是「能開票、能收錢」的最後關卡。
            電子發票 6 個工作天，銀行帳戶 9 個工作天，而且銀行這條比任何政府審件都久。
          </p>
          <div class="overflow-x-auto">
            <div class="min-w-[520px]">
              {POST_GANTT_ROWS.map(row => (
                <div class="grow grow-post">
                  <span class="glab">{row.label}</span>
                  <div class="gtrack gtrack-post">
                    <i class={`gbar gbar-${row.kind}`} style={`grid-column:${row.start}/${row.end}`}>{row.text}</i>
                  </div>
                </div>
              ))}
              <div class="grow grow-post">
                <span class="glab"></span>
                <div class="gaxis gaxis-post">
                  {POST_GANTT_AXIS.map(tick => (
                    <i style={`grid-column:${tick.col}`}>{tick.label}</i>
                  ))}
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ══════ 等多久 ══════ -->
    <section id="wait" class="mt-16 scroll-mt-20">
      <div class="font-mono text-xs text-teal uppercase tracking-[.08em] mb-3">LEAD TIMES</div>
      <h2 class="font-display text-ink font-semibold tracking-tight text-2xl mb-2">每一關要等多久</h2>
      <p class="font-display text-muted text-sm leading-relaxed mb-6 max-w-2xl">
        2026 年 7–8 月台北市的單一樣本。長條＝工作天。
      </p>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <div class="bg-surface-1 border border-rule rounded-xl p-6">
          <h3 class="font-display text-ink text-[15px] font-semibold mb-2">設立流程</h3>
          {WAIT_SETUP.map(row => (
            <div class="wrow">
              <div class="min-w-0">
                <div class="wname">
                  {row.name}
                  {row.badge && <span class="chip chip-teal ml-1.5">{row.badge}</span>}
                </div>
                <div class={`wbar wbar-${row.kind}`} style={`width:${row.width}%`}>{row.barText ?? row.days}</div>
                <div class="wsrc">{row.src}</div>
              </div>
              <div class={`wdays wdays-${row.kind}`}>{row.days === '0' ? '0' : row.days}</div>
            </div>
          ))}
        </div>

        <div class="bg-surface-1 border border-rule rounded-xl p-6">
          <h3 class="font-display text-ink text-[15px] font-semibold mb-2">能收錢／能開票之前</h3>
          {WAIT_MONEY.map(row => (
            <div class="wrow">
              <div class="min-w-0">
                <div class="wname">{row.name}</div>
                <div class={`wbar wbar-${row.kind}`} style={`width:${row.width}%`}>{row.barText ?? row.days}</div>
                <div class="wsrc">{row.src}</div>
              </div>
              <div class={`wdays wdays-${row.kind}`}>{row.days}</div>
            </div>
          ))}
          <div class="box-warn mt-4">
            <b>這兩條才是真正的瓶頸。</b>
            銀行 9 天、電子發票 6 天，兩件都不在一般「設立教學」裡，卻決定你哪一天能收到第一筆錢。
            <b>從要收錢的日子往回推兩週。</b>
          </div>
        </div>
      </div>

      <div class="mt-4 grid grid-cols-2 gap-px border border-rule rounded-xl overflow-hidden bg-rule">
        <div class="bg-surface-1 px-5 py-4">
          <div class="font-mono text-teal font-bold leading-none" style="font-size: 34px;">8</div>
          <div class="font-display text-muted text-[13px] mt-2">個工作天　機關真正在審<br /><span class="font-mono text-[11px] text-faint">1＋2＋3＋2</span></div>
        </div>
        <div class="bg-surface-1 px-5 py-4">
          <div class="font-mono text-ochre font-bold leading-none" style="font-size: 34px;">33</div>
          <div class="font-display text-muted text-[13px] mt-2">天　實際跨度<br /><span class="font-mono text-[11px] text-faint">115/06/29 → 115/07/31</span></div>
        </div>
      </div>
    </section>

    <!-- ══════ 刻章 ══════ -->
