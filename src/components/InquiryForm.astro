---
// Progressive enhancement, unchanged contract. Without JS the browser does a
// native POST and the server 303-redirects to /inquiry-received. With JS the
// submit is intercepted: strict client-side email check, then a fetch — so the
// visitor never lands on the bare 303 or a raw server error. Only the visual
// shell is restyled to the warm (Style E) look; field names, element IDs, the
// honeypot and the submit flow are the same ones the server + tests expect.
---
<section class="band inquire" id="inquire" aria-labelledby="inquire-title">
  <div class="wrap inquire-grid">
    <div class="inquire-copy">
      <div class="sec-head">
        <p class="eyebrow">預約諮詢</p>
        <h2 id="inquire-title">告訴我你想用 AI<br>解決什麼。</h2>
        <p class="sec-sub">填表後 1–2 個工作日內回覆。合適會附上預約連結；不合適會直接說。</p>
      </div>
      <div class="me-card">
        <img src="/dawson.webp" width="640" height="800" loading="lazy" decoding="async" alt="Dawson Wang 正式形象照" />
        <div><strong>Dawson Wang</strong><span>AI 導入顧問</span></div>
      </div>
      <p class="recent">最近諮詢的客戶來自：</p>
      <ul class="pills">
        <li>旅遊</li>
        <li>醫療</li>
        <li>KOL 經紀</li>
        <li>自媒體</li>
      </ul>
    </div>

    <form id="inquiry-form" class="form-card" action="/api/inquiry" method="POST">
      <input type="text" name="hp_field" value="" tabindex="-1" autocomplete="off" class="hp-field" aria-hidden="true" />

      <div class="field">
        <label for="inq-name">姓名<span class="req">必填</span></label>
        <input type="text" name="name" id="inq-name" required autocomplete="name" />
      </div>

      <div class="field">
        <label for="inq-email">Email<span class="req">必填</span></label>
        <input type="email" name="email" id="inq-email" required autocomplete="email" inputmode="email" aria-describedby="inq-email-hint" />
        <span id="inq-email-hint" class="email-hint" aria-live="polite" hidden></span>
      </div>

      <div class="field">
        <label for="inq-company">公司 / 組織<span class="req">必填</span></label>
        <input type="text" name="company" id="inq-company" required maxlength="150" autocomplete="organization" />
      </div>

      <div class="field">
        <label for="inq-goal">想用 AI 做什麼？<span class="req">必填</span></label>
        <textarea name="goal" id="inq-goal" required maxlength="300" rows="4" aria-describedby="goal-hint" placeholder="例如：每天要從 LINE 群組整理客戶需求，很花時間⋯"></textarea>
        <p class="hint" id="goal-hint">最多 300 字（目前 <span id="inq-goal-count">0</span> 字）</p>
      </div>

      <fieldset class="chips-field">
        <legend>團隊規模</legend>
        <div class="chips">
          {['1-5', '6-30', '31-100', '100+'].map(v => (
            <label class="chip"><input type="radio" name="team_size" value={v} required /><span>{v}</span></label>
          ))}
        </div>
      </fieldset>

      <fieldset class="chips-field">
        <legend>預算量級（新台幣）</legend>
        <div class="chips">
          {[
            { v: 'lt100k', l: '< 10 萬' },
            { v: '100k-300k', l: '10–30 萬' },
            { v: '300k-800k', l: '30–80 萬' },
            { v: 'gt800k', l: '> 80 萬' },
          ].map(o => (
            <label class="chip"><input type="radio" name="budget" value={o.v} required /><span>{o.l}</span></label>
          ))}
        </div>
      </fieldset>

      <fieldset class="chips-field">
        <legend>時程</legend>
        <div class="chips">
          {[
            { v: 'this_month', l: '本月內' },
            { v: 'this_quarter', l: '本季' },
            { v: 'exploring', l: '只是先了解' },
          ].map(o => (
            <label class="chip"><input type="radio" name="timeline" value={o.v} required /><span>{o.l}</span></label>
          ))}
        </div>
      </fieldset>

      <p class="form-error" id="inq-error" role="alert" hidden></p>
      <button type="submit" id="inq-submit" class="btn btn-primary btn-lg btn-block">送出 →</button>
    </form>

    <div id="inq-success" hidden tabindex="-1" class="form-card success-card">
      <p class="eyebrow">已收到</p>
      <h3><span>謝謝。</span></h3>
      <p>我會在 1–2 個工作日內回信。如果適合進一步聊，會附上 Google Calendar 預約連結。</p>
    </div>
  </div>
</section>

<style>
  /* Honeypot — present for bots, invisible to people. */
  .hp-field { display: none; }

  /* The two script-driven status elements E's stylesheet doesn't define. */
  .email-hint,
  .form-error {
    font-family: var(--f-body);
    font-size: .98rem;
    line-height: 1.5;
    color: var(--persimmon-text);
  }
  .email-hint[hidden],
  .form-error[hidden] { display: none; }

  .btn-primary:disabled,
  .btn-primary:disabled:hover { opacity: .45; cursor: not-allowed; transform: none; }

  .success-card { align-content: start; gap: 14px; }
  .success-card h3 { font-size: clamp(1.6rem, 1.2rem + 1vw, 2.1rem); }
  .success-card h3 span { color: var(--leaf-text); }
  .success-card p { color: var(--muted); line-height: 1.85; }
</style>

<script>
  // Mirror the server's email rule on the client and decide the submit outcome
  // in-page. The shared logic lives in src/lib/inquiry-client.ts (unit-tested);
  // this block is just the DOM glue.
  import {
    isValidInquiryEmail,
    inquiryErrorMessage,
    INQUIRY_EMAIL_HINT,
    INQUIRY_NETWORK_ERROR,
  } from '../lib/inquiry-client';
  import { trackEvent } from '../lib/analytics-client';

  const email = document.getElementById('inq-email') as HTMLInputElement | null;
  const hint = document.getElementById('inq-email-hint') as HTMLElement | null;
  const submit = document.getElementById('inq-submit') as HTMLButtonElement | null;
  const form = document.getElementById('inquiry-form') as HTMLFormElement | null;
  const errorEl = document.getElementById('inq-error') as HTMLElement | null;
  const success = document.getElementById('inq-success') as HTMLElement | null;

  if (email && hint && submit && form && errorEl && success) {
    const sendLabel = submit.textContent;

    const isValid = () => isValidInquiryEmail(email.value);

    // showError=false keeps the field quiet while still gating the button —
    // used on load so an untouched form doesn't shout at the user.
    function refresh(showError: boolean) {
      const valid = isValid();
      submit!.disabled = !valid;
      email!.setAttribute('aria-invalid', valid ? 'false' : 'true');
      const nag = !valid && showError && email!.value.trim().length > 0;
      hint!.textContent = nag ? INQUIRY_EMAIL_HINT : '';
      hint!.hidden = !nag;
    }

    email.addEventListener('input', () => refresh(true));
    email.addEventListener('blur', () => refresh(true));

    form.addEventListener('submit', async (e) => {
      // Always handle in-page: the visitor never sees the 303 redirect target
      // or a raw server error body.
      e.preventDefault();

      // Strict email check first (stricter than the browser's type=email).
      if (!isValid()) {
        refresh(true);
        email.focus();
        return;
      }
      // Let the browser surface its native messages for the other required fields.
      if (!form.reportValidity()) return;

      errorEl.hidden = true;
      submit.disabled = true;
      submit.textContent = '送出中…';

      try {
        const res = await fetch(form.action, {
          method: 'POST',
          body: new FormData(form),
          redirect: 'manual', // the server's 303 arrives as an opaqueredirect = success
        });
        const message = inquiryErrorMessage(res);
        if (message === null) {
          trackEvent('inquiry_submit', { placement: 'homepage_inquiry' });
          form.hidden = true;
          success.hidden = false;
          success.focus(); // move focus off the now-hidden form
          success.scrollIntoView({ block: 'center' });
          return;
        }
        errorEl.textContent = message;
      } catch {
        errorEl.textContent = INQUIRY_NETWORK_ERROR;
      }

      errorEl.hidden = false;
      submit.disabled = false;
      submit.textContent = sendLabel;
    });

    refresh(false);
  }

  // Live character count for the 300-character goal field (enhancement only).
  const goalField = document.getElementById('inq-goal') as HTMLTextAreaElement | null;
  const goalCount = document.getElementById('inq-goal-count');
  if (goalField && goalCount) {
    goalField.addEventListener('input', () => { goalCount.textContent = String(goalField.value.length); });
  }
</script>
