---
import { SERVICES } from '../data/services';
---
<section class="sec" id="services" aria-labelledby="services-title" style="padding-top:0">
  <div class="wrap">
    <div class="sec-head">
      <p class="eyebrow">服務內容</p>
      <h2 id="services-title"><span class="ph">三種合作方式，</span><span class="ph">看你想走多深。</span></h2>
      <p class="sec-sub">每個方案的成果都交到你們手上，沒有黑盒子，看得到、驗收得了。</p>
    </div>
    <div class="svc-grid">
      {SERVICES.map((s, i) => (
        <article class={`svc reveal${s.primary ? ' svc-main' : ''}`} data-reveal style={`--i:${i}`}>
          {s.primary && <span class="svc-badge">主推方案</span>}
          <span class="svc-num" aria-hidden="true"><svg viewBox="0 0 64 64"><use href="#i-ring" class="draw" stroke="currentColor"/></svg>{i + 1}</span>
          <h3>{s.title}</h3>
          <p class="svc-line">{s.blurb}</p>
          <ul class="svc-list">
            {s.examples.map(e => (
              <li><svg class="icon" aria-hidden="true"><use href="#i-check"/></svg>{e}</li>
            ))}
          </ul>
          <p class="svc-price"><svg class="icon" aria-hidden="true"><use href="#i-chat-q"/></svg>預約討論後報價</p>
          <a class={`btn btn-lg ${s.primary ? 'btn-white' : 'btn-outline'}`} href={s.ctaHref}>{s.ctaLabel} <span class="arr" aria-hidden="true">→</span></a>
        </article>
      ))}
    </div>
  </div>
</section>
