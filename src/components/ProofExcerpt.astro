---
import { getCollection } from 'astro:content';
const days = await getCollection('days');
const totalDays = days.length;
---
<section class="sec proof-band" aria-labelledby="proof-title">
  <div class="wrap">
    <div class="proof-card reveal" data-reveal>
      <div class="proof-copy">
        <p class="eyebrow">公開實作紀錄</p>
        <h2 id="proof-title">連續 {totalDays} 天，<br>每天一篇，全部公開。</h2>
        <p class="sec-sub">做法、踩到的雷、結果都攤在網路上——不是簡報裡的截圖，是真的做得出來、交得出去。</p>
        <a class="btn btn-soft btn-lg" href="/proof">看完整作品集 <span class="arr" aria-hidden="true">→</span></a>
      </div>
      <p class="proof-big" aria-hidden="true">{totalDays}<small>天</small></p>
    </div>
  </div>
</section>

<style>
  .proof-card {
    display: grid; grid-template-columns: minmax(0, 1fr) auto; align-items: center;
    gap: clamp(24px, 4vw, 56px);
    padding: clamp(28px, 4vw, 48px) clamp(26px, 4vw, 52px);
    border-radius: 34px; background: var(--white);
    border: 2px dashed var(--peach-deep); box-shadow: var(--shadow-sm);
  }
  .proof-card .sec-sub { margin-top: 14px; }
  .proof-card .btn { margin-top: 24px; }
  .proof-big {
    margin: 0; display: flex; align-items: baseline; gap: 8px;
    font: 700 clamp(4rem, 2rem + 8vw, 8.5rem)/.9 var(--f-hand); color: var(--persimmon-text);
  }
  .proof-big small { font: 700 1.4rem/1 var(--f-body); color: var(--ink); }
  @media (max-width: 760px) {
    .proof-card { grid-template-columns: 1fr; text-align: left; }
    .proof-big { order: -1; }
  }
</style>
