---
import { getCollection } from 'astro:content';
import { CASE_STUDIES } from '../data/homepage-cases';
import CaseStudyCard from './CaseStudyCard.astro';

const days = await getCollection('days');
const availableDays = new Set(days.map(day => day.data.dayNumber));
for (const entry of CASE_STUDIES) {
  for (const day of [entry.dayNumber, ...(entry.relatedDays ?? [])]) {
    if (!availableDays.has(day)) {
      throw new Error(`CaseStudies: ${entry.slug} references missing Day ${day}.`);
    }
  }
}
const featured = CASE_STUDIES.filter(entry => entry.featured);
---
<section class="sec" id="cases" aria-labelledby="cases-title">
  <div class="wrap">
    <div class="sec-head">
      <p class="eyebrow">案例錦集</p>
      <h2 id="cases-title">從生活小事到工作流程，<br>看看 AI 實際幫我做了什麼。</h2>
      <p class="sec-sub">這些都從我遇到的問題出發。怎麼做、做到哪裡、有哪些限制，每個案例都附完整分享。</p>
    </div>
    <div class="case-grid">
      {featured.map((entry, index) => <CaseStudyCard entry={entry} index={index} />)}
    </div>
    <div class="cases-more">
      <a class="btn btn-soft" href="/cases">看全部 {CASE_STUDIES.length} 個案例 <span aria-hidden="true">→</span></a>
    </div>
    <div class="cases-footer">
      <a class="text-link" href="/days">看全部 {days.length} 篇實作 <span aria-hidden="true">→</span></a>
      <a class="text-link" href="/search">找我寫過的主題 <span aria-hidden="true">→</span></a>
    </div>
  </div>
</section>

<style>
  .cases-more { margin-top: 34px; text-align: center; }
  .cases-footer { display: flex; flex-wrap: wrap; justify-content: center; gap: 12px 28px; margin-top: 34px; }
</style>
