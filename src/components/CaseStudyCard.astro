---
import type { CaseStudy } from '../data/homepage-cases';

interface Props {
  entry: CaseStudy;
  index: number;
}
const { entry, index } = Astro.props;
---
<article class="case reveal" id={`case-${entry.slug}`} data-reveal style={`--i:${index % 3}`}>
  <p class="case-tag"><svg class="icon" aria-hidden="true"><use href={`#${entry.icon}`}/></svg>{entry.category}</p>
  <h3>{entry.headline}</h3>
  <p class="case-who"><span>適合</span>{entry.audience}</p>
  <div class="case-before">
    <p class="case-label">原本的麻煩</p>
    <p>{entry.pain}</p>
  </div>
  <svg class="case-arrow" viewBox="0 0 60 52" aria-hidden="true"><path class="draw draw-in" pathLength="1" stroke="currentColor" d="M14 4C6 18 10 32 30 42M21 45.5l10-3-4.5-9.5"/></svg>
  <div class="case-after">
    <p class="case-label">我怎麼做</p>
    <p>{entry.outcome}</p>
  </div>
  {entry.note && <p class="case-note">{entry.note}</p>}
  <div class="case-links">
    {entry.demoHref && <a class="text-link" href={entry.demoHref}>{entry.demoLabel} <span aria-hidden="true">↗</span></a>}
    <a class="text-link" href={`/day/${entry.dayNumber}`}>看完整分享 <span aria-hidden="true">→</span></a>
    {entry.relatedDays && <p class="case-related">延伸閱讀：{entry.relatedDays.map((day, i) => <><span>{i > 0 ? '、' : ''}</span><a href={`/day/${day}`}>Day {day}</a></>)}</p>}
  </div>
</article>

<style>
  .case { min-width: 0; scroll-margin-top: 110px; }
  .case-note { margin-top: 14px; font-size: .92rem; line-height: 1.7; color: var(--muted); }
  .case-links { display: grid; gap: 10px; margin-top: auto; padding-top: 20px; }
  .case-related { color: var(--muted); font-size: .88rem; line-height: 1.7; }
  .case-related a { text-underline-offset: 3px; }
</style>
