---
import { getCollection } from 'astro:content';
import { PERSONAL_TOOLS } from '../data/homepage-cases';

const days = await getCollection('days');

// Fail the build if a referenced tool day disappears.
for (const t of PERSONAL_TOOLS) {
  if (!days.find(d => d.data.dayNumber === t.dayNumber)) {
    throw new Error(
      `ToolsIBuilt: day ${t.dayNumber} referenced in homepage-cases.ts ` +
      `but no matching entry exists in the days collection.`
    );
  }
}
---
<section class="sec tools" aria-labelledby="tools-title">
  <div class="wrap">
    <div class="sec-head">
      <p class="eyebrow">我自己也在用</p>
      <h2 id="tools-title"><span class="ph">不只教別人，</span><span class="ph">我自己每天也在用。</span></h2>
      <p class="sec-sub">連續 {days.length} 天，每天公開一篇 AI 實作：做法、踩到的雷、結果，全部攤開。</p>
    </div>
    <div class="tool-grid">
      {PERSONAL_TOOLS.map((t, i) => (
        <article class="tool reveal" data-reveal style={`--i:${i}`}>
          <span class="doodle" aria-hidden="true"><svg class="icon"><use href={`#${t.icon}`}/></svg></span>
          <h3>{t.headline}</h3>
          <p>{t.outcome}</p>
          <div class="tool-links">
            {t.demoHref && (
              <a class="text-link" href={t.demoHref}>{t.demoLabel ?? '試用 →'}</a>
            )}
            <a class="tool-day" href={`/day/${t.dayNumber}`}>Day {String(t.dayNumber).padStart(3, '0')} · 看完整流程 →</a>
          </div>
        </article>
      ))}
    </div>
    <div class="tools-more"><a class="text-link" href="/days">看全部 {days.length} 篇實作 <span aria-hidden="true">→</span></a></div>
  </div>
</section>

<style>
  /* Small stack for the two per-tool links (demo + permalink). */
  .tool-links { margin-top: 16px; display: grid; gap: 8px; }
  .tool-links .tool-day {
    display: inline-flex; align-items: center; min-height: 44px;
    font-size: .96rem; color: var(--muted); text-decoration: none;
  }
  .tool-links .tool-day:hover { color: var(--persimmon-text); }
</style>
