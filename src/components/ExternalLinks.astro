---
import type { ParsedManifest } from '../lib/parse-manifest';
interface Props { manifest: ParsedManifest; }
const { manifest } = Astro.props;
const links: { label: string; href: string }[] = [];
if (manifest.threads) links.push({ label: 'Threads', href: manifest.threads.postUrl });
if (manifest.facebook) links.push({ label: 'Facebook', href: manifest.facebook.postUrl });
if (manifest.linkedin) links.push({ label: 'LinkedIn', href: manifest.linkedin.postUrl });
---
{links.length > 0 && (
  <div class="ext">
    <p class="ext-title">前往原帖</p>
    <ul class="ext-list">
      {links.map(l => (
        <li>
          <a href={l.href} target="_blank" rel="noopener noreferrer">
            <span>{l.label}</span>
            <span aria-hidden="true">↗</span>
          </a>
        </li>
      ))}
    </ul>
  </div>
)}
<style>
  .ext { padding: 18px 20px; border-radius: 24px; background: var(--white); box-shadow: var(--shadow-sm); }
  .ext-title { font-weight: 700; color: var(--leaf-text); font-size: 1rem; }
  .ext-list { margin-top: 6px; }
  .ext-list li + li { border-top: 1.5px dashed var(--rule); }
  .ext-list a { display: flex; align-items: center; justify-content: space-between; min-height: 46px; text-decoration: none; font-weight: 500; transition: color .2s; }
  .ext-list a:hover { color: var(--persimmon-ink); }
  .ext-list a span:last-child { color: var(--persimmon-text); font-weight: 700; }
</style>
