---
import { FAQ_ITEMS } from '../../data/homepage-sections';
---
<section class="sec faq" aria-labelledby="faq-title">
  <div class="wrap faq-in">
    <div class="faq-side">
      <div class="sec-head">
        <p class="eyebrow">常見問題</p>
        <h2 id="faq-title">你可能想問</h2>
        <p class="sec-sub">沒看到你的問題？在表單裡直接問我。</p>
      </div>
      <a class="text-link" href="#inquire">到表單留言 <span aria-hidden="true">→</span></a>
    </div>
    <div class="faq-list">
      {FAQ_ITEMS.map((f, i) => (
        <details class="qa reveal" data-reveal style={`--i:${i}`} open={i === 0}>
          <summary><span>{f.q}</span><span class="plus" aria-hidden="true"></span></summary>
          <div class="qa-body"><p>{f.a}</p></div>
        </details>
      ))}
    </div>
  </div>
</section>
