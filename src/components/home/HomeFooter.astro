---
// Warm homepage footer (Style E). Replaces the shared Footer on `/` only, so it
// must carry the full site: homepage anchors plus /proof, /topics, /search and
// the privacy page. Links expanded beyond the preview so nothing becomes
// unreachable from the home page.
const links = [
  { href: '#services', label: '服務內容' },
  { href: '#cases', label: '客戶案例' },
  { href: '#training', label: '企業內訓' },
  { href: '/projects', label: '專案' },
  { href: '/proof', label: '作品集' },
  { href: '/days', label: '實作文章' },
  { href: '/topics', label: '主題' },
  { href: '/search', label: '搜尋' },
  { href: '/privacy.html', label: '隱私權政策' },
];
const year = new Date().getFullYear();
---
<footer class="band footer">
  <div class="wrap footer-in">
    <a class="brand" href="#top" aria-label="Dawson Wang，回到頁首">
      <span class="brand-mark" aria-hidden="true">D</span>
      <span class="brand-text"><strong>Dawson Wang</strong><small>AI 導入顧問</small></span>
    </a>
    <nav class="footer-links" aria-label="頁尾連結">
      {links.map(l => <a href={l.href}>{l.label}</a>)}
    </nav>
    <p class="copy">© {year} Dawson Wang</p>
  </div>
</footer>
