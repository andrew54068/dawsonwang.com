---
// `button: true` renders as an outlined pill instead of a plain text link — it
// reads as a button without competing with the saturated 預約諮詢 CTA.
const links = [
  { href: '/projects', label: '專案', button: true },
  { href: '/speaking', label: '講師', button: true },
  { href: '/proof', label: '作品集' },
  { href: '/business-registration', label: '行號設立' },
  { href: '/days', label: '所有文章' },
  { href: '/topics', label: '主題' },
  { href: '/search', label: '搜尋' },
];
// Highlight the section the visitor is currently in. `/day/12` counts as being
// under `/days` so the deep article pages don't drop the nav's sense of place.
const path = Astro.url.pathname.replace(/\/+$/, '') || '/';
function isCurrent(href: string) {
  if (href === '/days') return path === '/days' || path.startsWith('/day/');
  return path === href || path.startsWith(`${href}/`);
}
---
<nav class="sticky top-0 z-40 border-b border-rule bg-paper/85 backdrop-blur-md">
  <div class="max-w-5xl mx-auto px-8 h-14 flex items-center justify-between gap-4">
    <a href="/" class="flex items-center gap-2.5 no-underline">
      <span class="w-6 h-6 grid place-items-center rounded-md text-paper font-mono font-bold text-xs"
            style="background: linear-gradient(135deg, var(--color-brick), var(--color-teal));">D</span>
      <span class="font-display font-semibold text-ink text-sm tracking-tight">Dawson Wang</span>
    </a>
    <ul class="hidden md:flex gap-1 list-none p-0 m-0 items-center">
      {links.map(l => (
        <li>
          <a href={l.href}
             aria-current={isCurrent(l.href) ? 'page' : undefined}
             class={`${l.button ? 'nav-pill' : 'px-3 py-1.5 hover:bg-surface-1'} nav-link text-muted text-[13px] font-display hover:text-ink rounded-md transition-colors duration-150 no-underline`}>{l.label}</a>
        </li>
      ))}
    </ul>
    <div class="flex items-center gap-2">
      <button id="theme-toggle" type="button" aria-label="切換主題"
              class="w-8 h-8 grid place-items-center rounded-md bg-surface-1 hover:bg-surface-2 border border-rule text-muted hover:text-ink transition-colors duration-150">
        <svg class="theme-sun" viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="12" cy="12" r="4"></circle>
          <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"></path>
        </svg>
        <svg class="theme-moon" viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
        </svg>
      </button>
      <a href="/#inquire"
         class="nav-cta hidden md:inline-block text-white text-[13px] font-display font-semibold px-3.5 py-1.5 rounded-md transition-transform duration-150 no-underline">
        預約諮詢 →
      </a>
      <button id="menu-toggle" type="button" aria-label="開啟選單" aria-controls="mobile-menu" aria-expanded="false"
              class="md:hidden w-8 h-8 grid place-items-center rounded-md bg-surface-1 hover:bg-surface-2 border border-rule text-muted hover:text-ink transition-colors duration-150">
        <svg class="menu-open" viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <line x1="3" y1="6" x2="21" y2="6"></line>
          <line x1="3" y1="12" x2="21" y2="12"></line>
          <line x1="3" y1="18" x2="21" y2="18"></line>
        </svg>
        <svg class="menu-close" viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <line x1="6" y1="6" x2="18" y2="18"></line>
          <line x1="18" y1="6" x2="6" y2="18"></line>
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile-only dropdown: the desktop link row is display:none below `md`,
       so this is the only way to reach the section pages on phones. -->
  <div id="mobile-menu" class="md:hidden absolute top-full left-0 right-0 border-b border-rule bg-paper/95 backdrop-blur-md shadow-lg">
    <ul class="max-w-5xl mx-auto px-8 py-3 flex flex-col gap-1 list-none m-0">
      {links.map(l => (
        <li>
          <a href={l.href}
             aria-current={isCurrent(l.href) ? 'page' : undefined}
             class={`mobile-link nav-link block px-3 py-2.5 text-muted text-sm font-display hover:text-ink hover:bg-surface-1 rounded-md transition-colors duration-150 no-underline${l.button ? ' border border-rule' : ''}`}>{l.label}</a>
        </li>
      ))}
      <li>
        <a href="/#inquire"
           class="mobile-link nav-cta mt-1 block text-center text-white text-sm font-display font-semibold px-3.5 py-2.5 rounded-md no-underline">
          預約諮詢 →
        </a>
      </li>
    </ul>
  </div>
</nav>

<style>
  /* Outlined pills for the two "promote me" entries (專案 / 講師) — they read as
     buttons and group as a pair, but stay quieter than .nav-cta so the 預約諮詢
     CTA keeps being the loudest thing in the bar. */
  .nav-pill {
    display: inline-block;
    padding: 5px 12px;
    border: 1px solid color-mix(in oklab, var(--color-teal) 35%, var(--color-rule));
    color: var(--color-teal);
  }
  .nav-pill:hover {
    color: var(--color-teal);
    background: color-mix(in oklab, var(--color-teal) 10%, transparent);
    border-color: color-mix(in oklab, var(--color-teal) 55%, var(--color-rule));
  }

  /* Current section: the nav should say where you are. */
  .nav-link[aria-current="page"] { color: var(--color-ink); }
  .nav-pill[aria-current="page"] {
    color: var(--color-teal);
    background: color-mix(in oklab, var(--color-teal) 14%, transparent);
    border-color: color-mix(in oklab, var(--color-teal) 55%, var(--color-rule));
  }
  .nav-link:focus-visible {
    outline: 2px solid color-mix(in oklab, var(--color-teal) 60%, transparent);
    outline-offset: 2px;
  }

  /* Icon swap: show what will happen on click.
     Default (Linear/dark) → show SUN (click → switch to light).
     Stripe (light)        → show MOON (click → switch to dark). */
  #theme-toggle .theme-sun  { display: block; }
  #theme-toggle .theme-moon { display: none; }
  :root[data-theme="stripe"] #theme-toggle .theme-sun  { display: none; }
  :root[data-theme="stripe"] #theme-toggle .theme-moon { display: block; }

  /* Hamburger ⇄ close icon, driven by the button's expanded state. */
  #menu-toggle .menu-close { display: none; }
  #menu-toggle[aria-expanded="true"] .menu-open  { display: none; }
  #menu-toggle[aria-expanded="true"] .menu-close { display: block; }

  /* Mobile dropdown: hidden + non-interactive until opened, with a subtle
     fade/slide. `md:hidden` (display:none ≥768px) keeps it phones-only; we
     drive visibility here rather than toggling `display` so it can animate. */
  #mobile-menu {
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transform: translateY(-6px);
    transition: opacity 160ms ease, transform 160ms ease, visibility 160ms;
  }
  #mobile-menu.is-open {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    transform: translateY(0);
  }
  @media (prefers-reduced-motion: reduce) {
    #mobile-menu { transition: none; }
  }

  /* Saturated CTA — high contrast against both Linear and Stripe surfaces.
     Uses brick (Linear: purple, Stripe: indigo) so it's the most visible
     interactive element on the page in either theme. */
  .nav-cta {
    background: var(--color-brick);
    box-shadow:
      0 1px 2px color-mix(in oklab, var(--color-brick) 30%, transparent),
      0 4px 12px -4px color-mix(in oklab, var(--color-brick) 35%, transparent);
  }
  .nav-cta:hover {
    transform: translateY(-1px);
    box-shadow:
      0 2px 4px color-mix(in oklab, var(--color-brick) 35%, transparent),
      0 8px 18px -4px color-mix(in oklab, var(--color-brick) 45%, transparent);
  }
  .nav-cta:active { transform: translateY(0); }
  .nav-cta:focus-visible {
    outline: 2px solid color-mix(in oklab, var(--color-brick) 60%, transparent);
    outline-offset: 2px;
  }
</style>

<script>
  (function () {
    const STORAGE_KEY = 'dw_theme';
    const btn = document.getElementById('theme-toggle');
    if (!btn) return;

    function apply(theme: 'linear' | 'stripe', el: HTMLElement) {
      if (theme === 'stripe') {
        document.documentElement.dataset.theme = 'stripe';
      } else {
        delete document.documentElement.dataset.theme;
      }
      // Keep the mobile browser chrome tinted like the page it frames.
      const meta = document.querySelector('meta[name="theme-color"]');
      if (meta) meta.setAttribute('content', theme === 'stripe' ? '#FFFFFF' : '#0A0A0B');
      try { localStorage.setItem(STORAGE_KEY, theme); } catch (_) {}
      el.setAttribute('aria-label', theme === 'stripe' ? '切換為暗色主題' : '切換為明亮主題');
    }

    btn.setAttribute(
      'aria-label',
      document.documentElement.dataset.theme === 'stripe' ? '切換為暗色主題' : '切換為明亮主題',
    );

    btn.addEventListener('click', () => {
      const cur = document.documentElement.dataset.theme === 'stripe' ? 'stripe' : 'linear';
      apply(cur === 'stripe' ? 'linear' : 'stripe', btn);
    });
  })();
</script>

<script>
  (function () {
    const toggle = document.getElementById('menu-toggle');
    const menu = document.getElementById('mobile-menu');
    if (!toggle || !menu) return;

    function setOpen(open: boolean) {
      menu!.classList.toggle('is-open', open);
      toggle!.setAttribute('aria-expanded', String(open));
      toggle!.setAttribute('aria-label', open ? '關閉選單' : '開啟選單');
    }

    function isOpen() {
      return menu!.classList.contains('is-open');
    }

    toggle.addEventListener('click', (e) => {
      e.stopPropagation();
      setOpen(!isOpen());
    });

    // Close after tapping a link (covers same-page anchors like /#inquire
    // that don't trigger a fresh page load).
    menu.querySelectorAll('.mobile-link').forEach((link) => {
      link.addEventListener('click', () => setOpen(false));
    });

    // Tap outside the menu closes it.
    document.addEventListener('click', (e) => {
      if (!isOpen()) return;
      const target = e.target as Node;
      if (!menu!.contains(target) && !toggle!.contains(target)) setOpen(false);
    });

    // Escape closes and returns focus to the toggle.
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && isOpen()) {
        setOpen(false);
        (toggle as HTMLElement).focus();
      }
    });

    // Crossing into desktop layout hides the panel via CSS; reset state so it
    // isn't stuck "open" if the viewport shrinks again.
    const mq = window.matchMedia("(min-width: 768px)");
    mq.addEventListener('change', (e) => {
      if (e.matches) setOpen(false);
    });
  })();
</script>
