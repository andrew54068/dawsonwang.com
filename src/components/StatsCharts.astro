---
import type { StatsSummary } from '../lib/metrics';
import { formatCount } from '../lib/metrics';

interface Props {
  stats: StatsSummary;
  variant?: 'inline' | 'expanded';
}
const { stats, variant = 'inline' } = Astro.props;
const { threadsSeries, facebookSeries, totalDays, totalThreadsViews, totalFacebookReach, totalLinkedInImpressions } = stats;

const SP_W = 600;
const SP_H = variant === 'expanded' ? 110 : 80;
const SP_PAD = 2;
const threadsMax = Math.max(...threadsSeries.map(p => p.value), 1);
const sparkPath = threadsSeries.map((p, i) => {
  const x = SP_PAD + (i / Math.max(threadsSeries.length - 1, 1)) * (SP_W - SP_PAD * 2);
  const y = SP_H - SP_PAD - (p.value / threadsMax) * (SP_H - SP_PAD * 2);
  return `${i === 0 ? 'M' : 'L'}${x.toFixed(1)},${y.toFixed(1)}`;
}).join(' ');
const sparkArea = sparkPath
  ? `${sparkPath} L${(SP_W - SP_PAD).toFixed(1)},${(SP_H - SP_PAD).toFixed(1)} L${SP_PAD.toFixed(1)},${(SP_H - SP_PAD).toFixed(1)} Z`
  : '';
const peakIdx = threadsSeries.reduce(
  (bestIdx, p, i, arr) => (p.value > arr[bestIdx].value ? i : bestIdx),
  0,
);
const threadsPeak = threadsSeries[peakIdx] ?? null;
const threadsPeakX = threadsPeak
  ? SP_PAD + (peakIdx / Math.max(threadsSeries.length - 1, 1)) * (SP_W - SP_PAD * 2)
  : 0;
const threadsPeakY = threadsPeak
  ? SP_H - SP_PAD - (threadsPeak.value / threadsMax) * (SP_H - SP_PAD * 2)
  : 0;

const BAR_W = 600;
const BAR_H = variant === 'expanded' ? 110 : 80;
const BAR_GAP = 2;
const facebookMax = Math.max(...facebookSeries.map(p => p.value), 1);
const barWidth = facebookSeries.length > 0
  ? (BAR_W - BAR_GAP * (facebookSeries.length - 1)) / facebookSeries.length
  : 0;
const bars = facebookSeries.map((p, i) => {
  const h = (p.value / facebookMax) * BAR_H;
  const x = i * (barWidth + BAR_GAP);
  const y = BAR_H - h;
  return { x, y, w: barWidth, h, day: p.day, value: p.value };
});
const fbPeakIdx = facebookSeries.reduce(
  (bestIdx, p, i, arr) => (p.value > arr[bestIdx].value ? i : bestIdx),
  0,
);
const fbPeak = facebookSeries[fbPeakIdx] ?? null;
---
<div class="stats-charts" data-variant={variant}>
  <figure>
    <figcaption class="sc-head">
      <span class="sc-title">Threads · 每天的觀看數</span>
      <span class="sc-meta">{threadsSeries.length} / {totalDays} 篇有數據</span>
    </figcaption>
    <svg viewBox={`0 0 ${SP_W} ${SP_H}`} class="sc-svg" preserveAspectRatio="none" aria-hidden="true">
      <path d={sparkArea} fill="var(--leaf)" fill-opacity="0.16" />
      <path d={sparkPath} fill="none" stroke="var(--leaf)" stroke-width="2" stroke-linejoin="round" stroke-linecap="round" vector-effect="non-scaling-stroke" />
      {threadsPeak && (
        <circle cx={threadsPeakX} cy={threadsPeakY} r="4" fill="var(--persimmon)" />
      )}
    </svg>
    <div class="sc-foot">
      <span>累計 <strong>{formatCount(totalThreadsViews)}</strong> 次觀看</span>
      {threadsPeak && (
        <span class="sc-peak">最高 Day {threadsPeak.day} · {formatCount(threadsPeak.value)}</span>
      )}
    </div>
  </figure>

  <figure>
    <figcaption class="sc-head">
      <span class="sc-title">Facebook · 每天的觸及數</span>
      <span class="sc-meta">{facebookSeries.length} 篇有數據</span>
    </figcaption>
    <svg viewBox={`0 0 ${BAR_W} ${BAR_H}`} class="sc-svg" preserveAspectRatio="none" aria-hidden="true">
      {bars.map(b => (
        <rect x={b.x} y={b.y} width={b.w} height={b.h} fill="var(--persimmon)" />
      ))}
    </svg>
    <div class="sc-foot">
      <span>累計 <strong>{formatCount(totalFacebookReach)}</strong> 次觸及</span>
      {fbPeak && (
        <span class="sc-peak">最高 Day {fbPeak.day} · {formatCount(fbPeak.value)}</span>
      )}
    </div>
  </figure>

  {totalLinkedInImpressions > 0 && (
    <p class="sc-note">LinkedIn 另外曝光 <strong>{formatCount(totalLinkedInImpressions)}</strong> 次</p>
  )}
</div>

<style>
  .stats-charts { display: grid; gap: 32px; }
  .stats-charts figure { margin: 0; }
  .sc-head { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: 4px 16px; margin-bottom: 10px; }
  .sc-title { font: 700 1.2rem/1.4 var(--f-hand); color: var(--ink); }
  .sc-meta { font-size: .95rem; color: var(--muted); }
  .sc-svg { display: block; width: 100%; height: 80px; }
  [data-variant="expanded"] .sc-svg { height: 120px; }
  .sc-foot { margin-top: 10px; display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: 4px 16px; font-size: 1rem; color: var(--muted); }
  .sc-foot strong, .sc-note strong { font: 700 1.3rem/1 var(--f-hand); color: var(--ink); }
  .sc-peak { color: var(--persimmon-text); font-weight: 700; }
  .sc-note { margin-top: -12px; font-size: 1rem; color: var(--muted); }
</style>
