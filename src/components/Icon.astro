const body = ICONS[name] ?? '';
const solid = SOLID.has(name);
---
{body && (
  <svg
    class={className}
    width={size}
    height={size}
    viewBox="0 0 24 24"
    fill={solid ? 'currentColor' : 'none'}
    stroke={solid ? undefined : 'currentColor'}
    stroke-width={solid ? undefined : 1.75}
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
    focusable="false"
    set:html={body}
  />
)}
