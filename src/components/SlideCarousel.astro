---
interface Props { slides: { src: string; alt: string }[]; }
const { slides } = Astro.props;
---
{slides.length > 0 && (
  <figure class="slides" data-slide-carousel>
    <div class="slides-frame">
      <div class="slides-inner">
        {slides.map((slide, i) => (
          <img
            src={slide.src}
            alt={slide.alt}
            style={`opacity: ${i === 0 ? 1 : 0}`}
            data-slide-index={i}
          />
        ))}
      </div>
    </div>
    <figcaption class="slides-nav" data-pagefind-ignore>
      <button type="button" data-slide-prev class="btn btn-soft btn-sm"><span aria-hidden="true">←</span> 上一張</button>
      <span data-slide-counter class="slides-count">1 / {slides.length}</span>
      <button type="button" data-slide-next class="btn btn-soft btn-sm">下一張 <span aria-hidden="true">→</span></button>
    </figcaption>
  </figure>
)}
<style>
  .slides { margin: 0 0 36px; }
  .slides-frame { padding: 12px; border-radius: 30px; background: var(--white); box-shadow: var(--shadow); }
  .slides-inner { position: relative; aspect-ratio: 1 / 1; overflow: hidden; border-radius: 20px; background: var(--cream); }
  .slides-inner img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: contain; transition: opacity .2s; }
  .slides-nav { display: flex; align-items: center; justify-content: space-between; gap: 12px; margin-top: 16px; }
  .slides-count { font: 700 1.2rem/1 var(--f-hand); color: var(--persimmon-text); }
  @media (prefers-reduced-motion: reduce) { .slides-inner img { transition: none; } }
</style>
<script>
  document.querySelectorAll('[data-slide-carousel]').forEach((carousel) => {
    const slides = carousel.querySelectorAll<HTMLImageElement>('[data-slide-index]');
    const prev = carousel.querySelector<HTMLButtonElement>('[data-slide-prev]');
    const next = carousel.querySelector<HTMLButtonElement>('[data-slide-next]');
    const counter = carousel.querySelector<HTMLSpanElement>('[data-slide-counter]');
    let i = 0;
    const show = (n: number) => {
      i = (n + slides.length) % slides.length;
      slides.forEach((s, idx) => (s.style.opacity = idx === i ? '1' : '0'));
      if (counter) counter.textContent = `${i + 1} / ${slides.length}`;
    };
    prev?.addEventListener('click', () => show(i - 1));
    next?.addEventListener('click', () => show(i + 1));
    document.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowLeft') show(i - 1);
      if (e.key === 'ArrowRight') show(i + 1);
    });
  });
</script>
