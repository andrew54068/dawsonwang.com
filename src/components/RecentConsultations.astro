---
import { getCollection } from 'astro:content';
import { RECENT_CONSULTATIONS } from '../data/homepage-cases';

const days = await getCollection('days');

// Fail the build loudly if a referenced case day disappears from the content
// collection (same guard as before — keeps the /day/ links honest).
for (const c of RECENT_CONSULTATIONS) {
  if (!days.find(d => d.data.dayNumber === c.dayNumber)) {
    throw new Error(
      `RecentConsultations: day ${c.dayNumber} referenced in homepage-cases.ts ` +
      `but no matching entry exists in the days collection.`
    );
  }
}
---
<section class="sec" id="cases" aria-labelledby="cases-title">
  <div class="wrap">
    <div class="sec-head">
      <p class="eyebrow">客戶案例</p>
      <h2 id="cases-title">他們本來卡在哪裡，<br>後來怎麼動起來。</h2>
    </div>
    <div class="case-grid">
      {RECENT_CONSULTATIONS.map((c, i) => (
        <article class="case reveal" data-reveal style={`--i:${i}`}>
          <p class="case-tag"><svg class="icon" aria-hidden="true"><use href={`#${c.icon}`}/></svg>{c.vertical}</p>
          <h3>{c.headline}</h3>
          <p class="case-who"><span>誰</span>{c.who}</p>
          <div class="case-before">
            <p class="case-label">本來⋯</p>
            <p>{c.pain}</p>
          </div>
          <svg class="case-arrow" viewBox="0 0 60 52" aria-hidden="true"><path class="draw draw-in" pathLength="1" stroke="currentColor" d="M14 4C6 18 10 32 30 42M21 45.5l10-3-4.5-9.5"/></svg>
          <div class="case-after">
            <p class="case-label">後來⋯</p>
            <p>{c.outcome}</p>
          </div>
          <a class="text-link case-link" href={`/day/${c.dayNumber}`}>看完整案例 <span aria-hidden="true">→</span></a>
        </article>
      ))}
    </div>
  </div>
</section>
