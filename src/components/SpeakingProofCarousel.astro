---
interface ProofTestimonial {
  id: string;
  quote: string;
  attribution: string;
}

interface ProofSlide {
  id: string;
  image: {
    src: string;
    alt: string;
    width: number;
    height: number;
  };
  caption: string;
  testimonial?: ProofTestimonial;
}

interface Props {
  slides: ProofSlide[];
}

const { slides } = Astro.props;

const NO_QUOTE = '這張照片保留課程現場的工作狀態，沒有搭配公開回饋。';
---
{slides.length > 0 && (
  <section
    id="speaking-proof"
    class="mt-10 speaking-proof"
    role="region"
    aria-roledescription="carousel"
    aria-label="講師課程照片與學員回饋"
    data-speaking-proof-carousel
  >
    <div class="flex flex-wrap items-end justify-between gap-4 mb-6">
      <div>
        <div class="font-mono text-xs text-teal uppercase tracking-[.08em] mb-3">PROOF · {slides.length}</div>
        <h2 class="font-display text-ink font-semibold tracking-tight text-2xl">現場照片與學員回饋</h2>
      </div>
      <p class="font-display text-muted text-sm leading-relaxed max-w-md m-0">
        從同一場中正高工研習挑出幾個不同片段：講解、實作、台下協助，以及課後合照。
      </p>
    </div>

    {/* Photos only. The centred card is the subject; its neighbours peek in on
        both sides as the sole hint that the track continues. Captions and
        quotes live in the panel below so a peeking neighbour never leaks the
        text belonging to a photo you cannot see yet.

        Only the real five ship in the HTML — the loop clones are added by the
        script, so no-JS readers get five photos and search engines get one copy
        of each caption. */}
    <div class="proof-viewport" data-proof-viewport tabindex="0" aria-label="課程照片，可左右捲動">
      {slides.map((slide, index) => (
        <article
          class="proof-slide border border-rule bg-surface-1"
          data-proof-slide
          data-proof-slide-index={index}
          data-current={index === 0 ? 'true' : 'false'}
          aria-roledescription="slide"
          aria-label={`第 ${index + 1} 張，共 ${slides.length} 張`}
        >
          {/* aspect-ratio, never the surrounding copy, decides this box — that
              is what keeps all five photos exactly the same size. */}
          <img
            src={slide.image.src}
            alt={slide.image.alt}
            width={slide.image.width}
            height={slide.image.height}
            loading={index < 2 ? 'eager' : 'lazy'}
            decoding="async"
            sizes="(min-width: 1024px) 56rem, 90vw"
          />
          {/* The visible panel below is one shared slot, so pair each photo
              with its own words here for screen readers. */}
          <div class="sr-only">
            <p>{slide.caption}</p>
            <blockquote>
              {slide.testimonial ? `「${slide.testimonial.quote}」` : NO_QUOTE}
            </blockquote>
            {slide.testimonial && <p>— {slide.testimonial.attribution}</p>}
          </div>
        </article>
      ))}
    </div>

    <div
      class="proof-panel border border-rule bg-surface-1"
      data-proof-panel
      aria-hidden="true"
    >
      <p class="font-mono text-[11px] text-faint m-0" data-proof-caption>{slides[0].caption}</p>
      <div class="font-mono text-[11px] text-teal uppercase tracking-[.08em]">學員回饋</div>
      <blockquote class="font-display text-ink leading-relaxed m-0" data-proof-quote>
        {slides[0].testimonial ? `「${slides[0].testimonial.quote}」` : NO_QUOTE}
      </blockquote>
      <p class="font-mono text-[11px] text-faint m-0" data-proof-attribution>
        {slides[0].testimonial ? `— ${slides[0].testimonial.attribution}` : ''}
      </p>
    </div>

    {/* The panel above only repeats copy each slide already carries in its own
        sr-only block, so it stays aria-hidden. This counter is the one live
        region: the track drifts on its own every few seconds, and a position
        update is what a reader needs to hear — re-reading the whole quote on a
        timer would talk over them. */}
    <p class="sr-only" role="status" aria-live="polite" data-proof-status>第 1 張，共 {slides.length} 張</p>
  </section>
)}

<script>
  const AUTOPLAY_MS = 2000;
  // How far a mouse drag has to travel before it counts as "next photo" rather
  // than a slip of the hand while clicking.
  const DRAG_THRESHOLD_PX = 40;
  // After a manual move, sit still long enough to actually look at the photo —
  // at a 2s cadence the drift would otherwise yank it away mid-drag-release.
  const GRACE_MS = 4000;

  interface PanelCopy {
    caption: string;
    quote: string;
    attribution: string;
  }

  document.querySelectorAll<HTMLElement>('[data-speaking-proof-carousel]').forEach((carousel) => {
    const viewport = carousel.querySelector<HTMLElement>('[data-proof-viewport]');
    const panel = carousel.querySelector<HTMLElement>('[data-proof-panel]');
    const captionEl = carousel.querySelector<HTMLElement>('[data-proof-caption]');
    const quoteEl = carousel.querySelector<HTMLElement>('[data-proof-quote]');
    const attributionEl = carousel.querySelector<HTMLElement>('[data-proof-attribution]');
    const statusEl = carousel.querySelector<HTMLElement>('[data-proof-status]');
    if (!viewport) return;

    const real = Array.from(viewport.querySelectorAll<HTMLElement>('[data-proof-slide]'));
    const realCount = real.length;
    if (realCount === 0) return;

    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

    // The sr-only block inside each card is the source of truth for the panel:
    // no second copy of the strings to drift out of sync with the markup.
    const copy: PanelCopy[] = real.map((slide) => {
      const [caption, quote, attribution] = Array.from(
        slide.querySelectorAll<HTMLElement>('.sr-only > *')
      ).map(node => node.textContent?.trim() ?? '');
      return { caption: caption ?? '', quote: quote ?? '', attribution: attribution ?? '' };
    });

    // A set of clones on each side is what makes the loop seamless: the card
    // peeking to the left of the first photo is really the last photo, so there
    // is never a dead edge to bump into. When the centre drifts out of the
    // middle set we snap the scroll back by exactly one set width — the pixels
    // under the cursor are identical, so the jump is invisible.
    const canLoop = realCount >= 2;
    if (canLoop) {
      const cloneOf = (slide: HTMLElement) => {
        const clone = slide.cloneNode(true) as HTMLElement;
        clone.setAttribute('data-clone', 'true');
        clone.setAttribute('aria-hidden', 'true');
        clone.querySelectorAll('img').forEach(img => img.setAttribute('loading', 'lazy'));
        return clone;
      };
      const head = real.map(cloneOf);
      const tail = real.map(cloneOf);
      head.forEach(clone => viewport.insertBefore(clone, real[0]));
      tail.forEach(clone => viewport.appendChild(clone));
    }

    const slides = Array.from(viewport.querySelectorAll<HTMLElement>('[data-proof-slide]'));
    // Offset of the first real slide inside the (possibly cloned) track.
    const origin = canLoop ? realCount : 0;

    // Centre the card: offsetLeft is measured from the viewport's padding box
    // because .proof-viewport is position:relative.
    const centerOffset = (slide: HTMLElement) =>
      slide.offsetLeft - (viewport.clientWidth - slide.offsetWidth) / 2;

    const setWidth = () =>
      canLoop ? slides[origin].offsetLeft - slides[0].offsetLeft : 0;

    let current = origin;
    let timer: number | null = null;
    // Which photo's words the panel is showing. The markup ships slide 0's
    // caption and quote, so the panel starts already painted — tracking that
    // is what stops the first paint() fading identical text out and back in.
    let painted = 0;
    let swapTimer: number | null = null;
    // Distinct reasons to hold the timer: a drag and an off-screen scroll can
    // overlap, so a single boolean would let whichever ends first restart it.
    const holds = new Set<string>();
    // Id of the pointer currently dragging the track, if any. Declared up here
    // because the scroll handler below has to know to keep its hands off while
    // a drag is driving scrollLeft directly.
    let dragPointer: number | null = null;

    // Which of the five real photos a track index shows — clones included.
    const copyIndexOf = (index: number) => ((index - origin) % realCount + realCount) % realCount;

    // Moving the highlight is cheap and always safe; swapping the copy is not,
    // so the two are separable (see the rebase in the scroll handler).
    const highlight = (index: number) => {
      current = index;
      slides.forEach((slide, i) => slide.setAttribute('data-current', i === index ? 'true' : 'false'));
    };

    // Re-writing identical text still re-fires a live region, so only speak
    // when the position actually changed.
    const announce = (index: number) => {
      if (!statusEl) return;
      const text = `第 ${copyIndexOf(index) + 1} 張，共 ${realCount} 張`;
      if (statusEl.textContent !== text) statusEl.textContent = text;
    };

    const paint = (index: number) => {
      highlight(index);

      const target = copyIndexOf(index);
      // The fade only earns its cost when the words actually change. Landing on
      // the copy already on screen — on load, or on any move between a real card
      // and its clone — must not blink the panel for a zero-content swap.
      if (target === painted) {
        announce(index);
        return;
      }

      const next = copy[target];
      if (!next) return;
      painted = target;

      const write = () => {
        if (captionEl) captionEl.textContent = next.caption;
        if (quoteEl) quoteEl.textContent = next.quote;
        if (attributionEl) attributionEl.textContent = next.attribution;
        announce(index);
      };

      // A fast swipe can start a second swap inside the first one's fade. Drop
      // the pending timeout or it would fade *in* on the slide we already left,
      // then flip to this one unfaded — the half-changed state the fade exists
      // to prevent.
      if (swapTimer !== null) window.clearTimeout(swapTimer);
      swapTimer = null;

      if (!panel || reduceMotion.matches) {
        write();
        return;
      }
      // Swap the text at the bottom of a short fade so the quote never appears
      // half-changed against the photo that no longer matches it.
      panel.classList.add('is-swapping');
      swapTimer = window.setTimeout(() => {
        swapTimer = null;
        write();
        panel.classList.remove('is-swapping');
      }, 160);
    };

    const scrollToSlide = (index: number) => {
      const target = Math.min(Math.max(index, 0), slides.length - 1);
      viewport.scrollTo({
        left: centerOffset(slides[target]),
        behavior: reduceMotion.matches ? 'auto' : 'smooth',
      });
      paint(target);
    };

    const stop = () => {
      if (timer !== null) {
        window.clearInterval(timer);
        timer = null;
      }
    };

    const start = () => {
      stop();
      if (holds.size > 0 || reduceMotion.matches || realCount < 2) return;
      timer = window.setInterval(() => scrollToSlide(current + 1), AUTOPLAY_MS);
    };

    const hold = (reason: string) => {
      holds.add(reason);
      stop();
    };

    const release = (reason: string) => {
      holds.delete(reason);
      start();
    };

    // A deliberate move — drag or arrow key — buys a few seconds of stillness.
    // Without it the 2s drift would slide the photo away the instant you let go,
    // which reads as the carousel fighting you.
    let graceTimer: number | null = null;
    const grace = () => {
      hold('manual');
      if (graceTimer !== null) window.clearTimeout(graceTimer);
      graceTimer = window.setTimeout(() => {
        graceTimer = null;
        release('manual');
      }, GRACE_MS);
    };

    // Manual scrolling (swipe, trackpad, keyboard) is the source of truth for
    // which card is centred — recompute from the scroll offset, don't assume.
    let scrollSettle: number | null = null;
    viewport.addEventListener('scroll', () => {
      // Mid-drag the scroll offset is the finger, not a resting position. A
      // rebase here would move the track out from under the pointer and leave
      // the drag's own reference offset stale; endDrag settles it instead.
      if (dragPointer !== null) return;
      if (scrollSettle !== null) window.clearTimeout(scrollSettle);
      scrollSettle = window.setTimeout(() => {
        const middle = viewport.scrollLeft + viewport.clientWidth / 2;
        let nearest = 0;
        let best = Infinity;
        slides.forEach((slide, index) => {
          const distance = Math.abs(slide.offsetLeft + slide.offsetWidth / 2 - middle);
          if (distance < best) {
            best = distance;
            nearest = index;
          }
        });

        // Rebase into the middle set. Assigning scrollLeft is instant, and the
        // clone under the centre is pixel-identical to the real card it maps
        // to, so nothing visibly moves.
        if (canLoop) {
          const width = setWidth();
          if (nearest >= origin + realCount) {
            nearest -= realCount;
            viewport.scrollLeft -= width;
          } else if (nearest < origin) {
            nearest += realCount;
            viewport.scrollLeft += width;
          }
        }

        // A rebase swaps a real card for its pixel-identical clone, so the copy
        // on screen is unchanged — repainting there would fade the same quote
        // out and back in once per loop. Move the highlight only.
        if (copyIndexOf(nearest) !== copyIndexOf(current)) paint(nearest);
        else if (nearest !== current) highlight(nearest);
      }, 120);
    }, { passive: true });

    carousel.addEventListener('keydown', (event) => {
      if (!carousel.contains(document.activeElement)) return;
      if (event.key === 'ArrowLeft') {
        event.preventDefault();
        scrollToSlide(current - 1);
        grace();
      }
      if (event.key === 'ArrowRight') {
        event.preventDefault();
        scrollToSlide(current + 1);
        grace();
      }
    });

    // Grab-and-drag for mouse and pen. Touch is left alone on purpose: the
    // viewport already scrolls natively there, and driving scrollLeft by hand
    // would replace real momentum with a worse imitation of it.
    //
    // Distance between two neighbouring cards, so a long drag lands where it
    // looks like it should instead of always advancing exactly one.
    const stride = () =>
      slides.length > 1 ? slides[1].offsetLeft - slides[0].offsetLeft : viewport.clientWidth;

    let dragStartX = 0;
    let dragStartScroll = 0;
    let dragMoved = false;

    // Photos are draggable by default in every browser; the ghost image would
    // hijack the gesture the moment the pointer left the card.
    viewport.addEventListener('dragstart', event => event.preventDefault());

    viewport.addEventListener('pointerdown', (event) => {
      if (event.pointerType === 'touch' || event.button !== 0) return;
      dragPointer = event.pointerId;
      dragStartX = event.clientX;
      dragStartScroll = viewport.scrollLeft;
      dragMoved = false;
      hold('drag');
      viewport.classList.add('is-dragging');
      // Capture so a drag that runs off the edge of the card keeps tracking.
      viewport.setPointerCapture(event.pointerId);
    });

    viewport.addEventListener('pointermove', (event) => {
      if (dragPointer !== event.pointerId) return;
      const dx = event.clientX - dragStartX;
      // A few pixels of travel is a click with a shaky hand, not a drag.
      if (!dragMoved && Math.abs(dx) < 3) return;
      dragMoved = true;
      viewport.scrollLeft = dragStartScroll - dx;
    });

    const endDrag = (event: PointerEvent) => {
      if (dragPointer !== event.pointerId) return;
      // Positive: dragged leftwards, i.e. pulling the next photo into view.
      const dx = dragStartX - event.clientX;
      const moved = dragMoved;
      dragPointer = null;
      dragMoved = false;
      viewport.classList.remove('is-dragging');
      if (viewport.hasPointerCapture(event.pointerId)) viewport.releasePointerCapture(event.pointerId);

      if (moved) {
        const steps = Math.abs(dx) < DRAG_THRESHOLD_PX
          ? 0
          : Math.sign(dx) * Math.max(1, Math.round(Math.abs(dx) / stride()));
        // Even a below-threshold drag ends in a scrollToSlide: snapping is off
        // during the drag, so something has to put the card back on centre.
        scrollToSlide(current + steps);
        grace();
      }
      release('drag');
    };

    viewport.addEventListener('pointerup', endDrag);
    viewport.addEventListener('pointercancel', endDrag);

    // Tabbing into the track is the keyboard reader's pause. Hovering used to
    // hold it too, but the section is most of the screen on /speaking — the
    // pointer sits over it while you read, so the drift never got to start.
    carousel.addEventListener('focusin', () => hold('focus'));
    carousel.addEventListener('focusout', () => {
      if (!carousel.contains(document.activeElement)) release('focus');
    });

    document.addEventListener('visibilitychange', () => {
      if (document.hidden) hold('tab');
      else release('tab');
    });

    if ('IntersectionObserver' in window) {
      new IntersectionObserver(
        entries => entries.forEach(entry => (entry.isIntersecting ? release('offscreen') : hold('offscreen'))),
        { threshold: 0.25 }
      ).observe(carousel);
    }

    reduceMotion.addEventListener('change', () => (reduceMotion.matches ? stop() : start()));

    // Land on the first real card before anything paints, so inserting the head
    // clones never shows as a jump. The panel already carries this card's words
    // from the server render, so this only moves the highlight onto it.
    viewport.scrollLeft = centerOffset(slides[origin]);
    paint(origin);

    // Percentage widths mean every resize moves the centre — put it back.
    let resizeSettle: number | null = null;
    window.addEventListener('resize', () => {
      if (resizeSettle !== null) window.clearTimeout(resizeSettle);
      resizeSettle = window.setTimeout(() => {
        viewport.scrollLeft = centerOffset(slides[current]);
      }, 150);
    });

    start();
  });
</script>

<style>
  .proof-viewport {
    position: relative;
    display: flex;
    gap: 16px;
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scroll-snap-type: x mandatory;
    /* Half the leftover width on each side, so every card — first and last
       included — sits dead centre. */
    padding-inline: 4%;
    padding-block: 2px;
    /* The peeking neighbours carry the affordance; a native bar under the photo
       would only add a stray line. */
    scrollbar-width: none;
    cursor: grab;
  }

  /* Snapping has to be off for the duration: with `mandatory` on, every
     scrollLeft we write mid-drag gets pulled back to the nearest card and the
     track judders instead of following the pointer. endDrag turns it back on
     and then scrolls to a definite slide, so the card still lands centred. */
  .proof-viewport.is-dragging {
    cursor: grabbing;
    scroll-snap-type: none;
    scroll-behavior: auto;
    user-select: none;
  }

  .proof-viewport::-webkit-scrollbar {
    display: none;
  }

  .proof-viewport:focus-visible {
    outline: 2px solid var(--color-teal);
    outline-offset: 2px;
  }

  .proof-slide {
    /* 92% + 4% padding either side leaves roughly a 20px sliver of each
       neighbour — just enough to read as "there is more". */
    flex: 0 0 92%;
    scroll-snap-align: center;
    scroll-snap-stop: always;
    min-width: 0;
    padding: 12px;
    border-radius: 12px;
    overflow: hidden;
    /* Neighbours read as context, not as competing subjects. */
    opacity: 0.42;
    transition: opacity 320ms ease;
  }

  .proof-slide[data-current="true"] {
    opacity: 1;
  }

  .proof-slide img {
    display: block;
    -webkit-user-drag: none;
    width: 100%;
    aspect-ratio: 4 / 3;
    max-height: 440px;
    object-fit: cover;
    border-radius: 8px;
  }

  .proof-panel {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 12px;
    margin-top: 16px;
    padding: clamp(20px, 3vw, 32px);
    border-radius: 12px;
    /* Reserve room for the longest testimonial so swapping quotes never nudges
       the page under the reader. */
    min-height: 200px;
    transition: opacity 160ms ease;
  }

  .proof-panel.is-swapping {
    opacity: 0;
  }

  .proof-panel blockquote {
    font-size: clamp(1.1rem, 1.7vw, 1.5rem);
  }

  @media (max-width: 820px) {
    .proof-viewport {
      gap: 12px;
      padding-inline: 5%;
    }

    .proof-slide {
      flex: 0 0 90%;
    }

    .proof-slide img {
      max-height: none;
    }

    .proof-panel {
      min-height: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .proof-viewport {
      scroll-behavior: auto;
    }

    .proof-slide,
    .proof-panel {
      transition: none;
    }
  }
</style>
