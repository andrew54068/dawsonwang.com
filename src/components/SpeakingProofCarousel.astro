---
interface ProofTestimonial {
  id: string;
  quote: string;
  attribution: string;
}

interface ProofSlide {
  id: string;
  image: {
    src: string;
    alt: string;
    width: number;
    height: number;
  };
  caption: string;
  testimonial?: ProofTestimonial;
}

interface Props {
  slides: ProofSlide[];
}

const { slides } = Astro.props;
---
{slides.length > 0 && (
  <section
    id="speaking-proof"
    class="mt-16 speaking-proof"
    role="region"
    aria-roledescription="carousel"
    aria-label="講師課程照片與學員回饋"
    data-speaking-proof-carousel
  >
    <div class="flex flex-wrap items-end justify-between gap-4 mb-6">
      <div>
        <div class="font-mono text-xs text-teal uppercase tracking-[.08em] mb-3">PROOF · {slides.length}</div>
        <h2 class="font-display text-ink font-semibold tracking-tight text-2xl">現場照片與學員回饋</h2>
      </div>
      <p class="font-display text-muted text-sm leading-relaxed max-w-md m-0">
        從同一場中正高工研習挑出幾個不同片段：講解、實作、台下協助，以及課後合照。
      </p>
    </div>

    <div class="proof-shell border border-rule bg-surface-1 overflow-hidden">
      <div class="proof-track">
        {slides.map((slide, index) => (
          <article
            class="proof-slide"
            data-proof-slide
            data-proof-slide-index={index}
            aria-hidden={index === 0 ? 'false' : 'true'}
            hidden={index !== 0}
          >
            <figure class="proof-photo m-0">
              <img
                src={slide.image.src}
                alt={slide.image.alt}
                width={slide.image.width}
                height={slide.image.height}
                loading={index === 0 ? 'eager' : 'lazy'}
                decoding="async"
                sizes="(min-width: 1024px) 58rem, calc(100vw - 4rem)"
              />
              <figcaption class="font-mono text-[11px] text-faint">{slide.caption}</figcaption>
            </figure>

            <div class="proof-copy">
              <div class="font-mono text-[11px] text-teal uppercase tracking-[.08em]">學員回饋</div>
              {slide.testimonial ? (
                <>
                  <blockquote class="font-display text-ink leading-relaxed m-0">
                    「{slide.testimonial.quote}」
                  </blockquote>
                  <p class="font-mono text-[11px] text-faint m-0">— {slide.testimonial.attribution}</p>
                </>
              ) : (
                <p class="font-display text-muted text-base leading-relaxed m-0">
                  這張照片保留課程現場的工作狀態，沒有搭配公開回饋。
                </p>
              )}
            </div>
          </article>
        ))}
      </div>

      <div class="proof-controls border-t border-rule">
        <button class="proof-button" type="button" data-proof-prev aria-label="上一張講師課程照片">←</button>
        <div class="proof-dots" role="group" aria-label="切換課程照片">
          {slides.map((slide, index) => (
            <button
              class="proof-dot"
              type="button"
              data-proof-dot
              data-proof-dot-index={index}
              aria-label={`顯示第 ${index + 1} 張：${slide.caption}`}
              aria-current={index === 0 ? 'true' : 'false'}
            >
              <span>{String(index + 1).padStart(2, '0')}</span>
            </button>
          ))}
        </div>
        <span class="proof-counter font-mono text-[11px] text-teal" data-proof-counter aria-live="polite">
          1 / {slides.length}
        </span>
        <button class="proof-button" type="button" data-proof-next aria-label="下一張講師課程照片">→</button>
      </div>
    </div>
  </section>
)}

<script>
  document.querySelectorAll<HTMLElement>('[data-speaking-proof-carousel]').forEach((carousel) => {
    const slides = Array.from(carousel.querySelectorAll<HTMLElement>('[data-proof-slide]'));
    const dots = Array.from(carousel.querySelectorAll<HTMLButtonElement>('[data-proof-dot]'));
    const prev = carousel.querySelector<HTMLButtonElement>('[data-proof-prev]');
    const next = carousel.querySelector<HTMLButtonElement>('[data-proof-next]');
    const counter = carousel.querySelector<HTMLElement>('[data-proof-counter]');
    if (slides.length === 0) return;

    let current = 0;

    const show = (nextIndex: number) => {
      current = (nextIndex + slides.length) % slides.length;
      slides.forEach((slide, index) => {
        const active = index === current;
        slide.hidden = !active;
        slide.setAttribute('aria-hidden', active ? 'false' : 'true');
      });
      dots.forEach((dot, index) => {
        dot.setAttribute('aria-current', index === current ? 'true' : 'false');
      });
      if (counter) counter.textContent = `${current + 1} / ${slides.length}`;
    };

    prev?.addEventListener('click', () => show(current - 1));
    next?.addEventListener('click', () => show(current + 1));
    dots.forEach((dot, index) => dot.addEventListener('click', () => show(index)));
    carousel.addEventListener('keydown', (event) => {
      if (!carousel.contains(document.activeElement)) return;
      if (event.key === 'ArrowLeft') {
        event.preventDefault();
        show(current - 1);
      }
      if (event.key === 'ArrowRight') {
        event.preventDefault();
        show(current + 1);
      }
    });
  });
</script>

<style>
  .proof-shell {
    border-radius: 8px;
  }

  .proof-slide {
    display: grid;
    grid-template-columns: minmax(0, 1.35fr) minmax(280px, 0.65fr);
    min-height: 460px;
  }

  .proof-photo {
    display: grid;
    grid-template-rows: minmax(0, 1fr) auto;
    gap: 10px;
    padding: 12px;
    border-right: 1px solid var(--color-rule);
    background: var(--color-paper);
  }

  .proof-photo img {
    display: block;
    width: 100%;
    height: 100%;
    min-height: 360px;
    object-fit: cover;
    border-radius: 8px;
  }

  .proof-copy {
    display: flex;
    min-width: 0;
    flex-direction: column;
    justify-content: center;
    gap: 18px;
    padding: clamp(24px, 4vw, 42px);
  }

  .proof-copy blockquote {
    font-size: clamp(1.25rem, 2.3vw, 2rem);
  }

  .proof-controls {
    display: grid;
    grid-template-columns: 48px minmax(0, 1fr) auto 48px;
    align-items: center;
    gap: 12px;
    padding: 12px;
  }

  .proof-button,
  .proof-dot {
    min-width: 44px;
    min-height: 44px;
    border: 1px solid var(--color-rule);
    border-radius: 8px;
    background: var(--color-paper);
    color: var(--color-muted);
    transition: background 150ms ease, border-color 150ms ease, color 150ms ease;
  }

  .proof-button:hover,
  .proof-dot:hover,
  .proof-dot[aria-current="true"] {
    border-color: color-mix(in oklab, var(--color-teal) 45%, var(--color-rule));
    background: color-mix(in oklab, var(--color-teal) 8%, transparent);
    color: var(--color-ink);
  }

  .proof-dots {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    min-width: 0;
  }

  .proof-dot {
    font-family: var(--font-mono);
    font-size: 11px;
  }

  @media (max-width: 820px) {
    .proof-slide {
      grid-template-columns: 1fr;
      min-height: 0;
    }

    .proof-photo {
      border-right: 0;
      border-bottom: 1px solid var(--color-rule);
    }

    .proof-photo img {
      min-height: 0;
      aspect-ratio: 4 / 3;
    }

    .proof-controls {
      grid-template-columns: 48px 1fr 48px;
    }

    .proof-counter {
      grid-column: 1 / -1;
      grid-row: 1;
      justify-self: center;
    }

    .proof-dots {
      justify-content: center;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .proof-button,
    .proof-dot {
      transition: none;
    }
  }
</style>
